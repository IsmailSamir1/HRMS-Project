@{
    ViewData["Title"] = "Team Calendar";
    var departments = ViewBag.Departments as List<WebApplication1.Models.Department>;
    var employees = ViewBag.Employees as List<WebApplication1.Models.Employee>;
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-calendar3 text-primary me-2"></i>Team Calendar
            </h2>
            <p class="text-muted mb-0">View leaves, shifts, and team availability</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="MyCalendar" class="btn btn-outline-primary">
                <i class="bi bi-person me-1"></i> My Calendar
            </a>
            @if (isLineManager || isHRAdmin || isSystemAdmin)
            {
                <a asp-controller="Leave" asp-action="TeamCalendar" class="btn btn-outline-secondary">
                    <i class="bi bi-list me-1"></i> List View
                </a>
            }
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">
            <div class="row g-3 align-items-end">
                @if (isSystemAdmin || isHRAdmin)
                {
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Department</label>
                        <select id="departmentFilter" class="form-select">
                            <option value="">All Departments</option>
                            @foreach (var dept in departments)
                            {
                                <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Employee</label>
                    <select id="employeeFilter" class="form-select">
                        <option value="">All Employees</option>
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.EmployeeId">@emp.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Event Type</label>
                    <select id="eventTypeFilter" class="form-select">
                        <option value="">All Events</option>
                        <option value="leave">Leaves Only</option>
                        <option value="shift">Shifts Only</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button id="applyFilters" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i> Apply Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="d-flex flex-wrap gap-3 mb-4">
        <div class="d-flex align-items-center">
            <span class="badge me-2" style="background: #e74c3c; width: 20px; height: 20px;"></span>
            <small>Approved Leave</small>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge me-2" style="background: #f39c12; width: 20px; height: 20px;"></span>
            <small>Pending Leave</small>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge me-2" style="background: #3498db; width: 20px; height: 20px;"></span>
            <small>Morning Shift</small>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge me-2" style="background: #9b59b6; width: 20px; height: 20px;"></span>
            <small>Evening Shift</small>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge me-2" style="background: #2c3e50; width: 20px; height: 20px;"></span>
            <small>Night Shift</small>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge me-2" style="background: #1abc9c; width: 20px; height: 20px;"></span>
            <small>Split Shift</small>
        </div>
    </div>

    <!-- Calendar Container -->
    <div class="card shadow">
        <div class="card-body p-0">
            <div id="calendar" style="min-height: 700px;"></div>
        </div>
    </div>
</div>

<!-- Event Details Modal -->
<div class="modal fade" id="eventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="eventModalHeader">
                <h5 class="modal-title" id="eventModalTitle">Event Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="eventModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
            <div class="modal-footer" id="eventModalFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar CSS -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />

    <!-- FullCalendar JS -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

    <style>
        .fc {
            font-family: 'Inter', sans-serif;
        }

        .fc-toolbar-title {
            font-size: 1.5rem !important;
            font-weight: 600 !important;
        }

        .fc-button {
            background: var(--primary-gradient) !important;
            border: none !important;
            box-shadow: none !important;
            text-transform: capitalize !important;
        }

            .fc-button:hover {
                opacity: 0.9;
            }

        .fc-button-active {
            background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%) !important;
        }

        .fc-event {
            border: none !important;
            border-radius: 4px !important;
            padding: 2px 6px !important;
            font-size: 0.8rem !important;
            cursor: pointer;
        }

            .fc-event:hover {
                opacity: 0.9;
                transform: scale(1.02);
            }

        .fc-daygrid-day:hover {
            background: rgba(102, 126, 234, 0.05);
        }

        .fc-day-today {
            background: rgba(102, 126, 234, 0.1) !important;
        }

        .fc-col-header-cell {
            background: #f8f9fa;
            font-weight: 600;
        }

        /* Dark Mode Support */
        body.dark-mode .fc {
            color: #e4e4e4;
        }

        body.dark-mode .fc-col-header-cell {
            background: #1f2937;
        }

        body.dark-mode .fc-daygrid-day {
            background: transparent;
        }

        body.dark-mode .fc-day-today {
            background: rgba(102, 126, 234, 0.2) !important;
        }

        body.dark-mode .fc-daygrid-day:hover {
            background: rgba(102, 126, 234, 0.15);
        }

        body.dark-mode .fc-theme-standard td,
        body.dark-mode .fc-theme-standard th {
            border-color: #374151;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var eventModal = new bootstrap.Modal(document.getElementById('eventModal'));

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },
                height: 'auto',
                navLinks: true,
                editable: false,
                dayMaxEvents: 3,
                moreLinkClick: 'popover',
                eventDisplay: 'block',

                // Load events
                events: function(info, successCallback, failureCallback) {
                    var departmentId = document.getElementById('departmentFilter')?.value || '';
                    var employeeId = document.getElementById('employeeFilter')?.value || '';
                    var eventType = document.getElementById('eventTypeFilter')?.value || '';

                    var url = '/Calendar/GetEvents?start=' + info.startStr + '&end=' + info.endStr;
                    if (departmentId) url += '&departmentId=' + departmentId;
                    if (employeeId) url += '&employeeId=' + employeeId;

                    fetch(url)
                        .then(response => response.json())
                        .then(events => {
                            // Filter by event type if selected
                            if (eventType) {
                                events = events.filter(e => e.extendedProps.type === eventType);
                            }
                            successCallback(events);
                        })
                        .catch(error => {
                            console.error('Error loading events:', error);
                            failureCallback(error);
                        });
                },

                // Event click handler
                eventClick: function(info) {
                    showEventDetails(info.event.id);
                },

                // Date click handler
                dateClick: function(info) {
                    console.log('Date clicked:', info.dateStr);
                },

                // Loading indicator
                loading: function(isLoading) {
                    if (isLoading) {
                        calendarEl.style.opacity = '0.6';
                    } else {
                        calendarEl.style.opacity = '1';
                    }
                }
            });

            calendar.render();

            // Apply filters button
            document.getElementById('applyFilters').addEventListener('click', function() {
                calendar.refetchEvents();
            });

            // Show event details
            function showEventDetails(eventId) {
                var modalBody = document.getElementById('eventModalBody');
                var modalHeader = document.getElementById('eventModalHeader');
                var modalFooter = document.getElementById('eventModalFooter');

                modalBody.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
                eventModal.show();

                fetch('/Calendar/GetEventDetails?eventId=' + eventId)
                    .then(response => response.json())
                    .then(data => {
                        if (data.type === 'leave') {
                            modalHeader.style.background = data.status === 'Approved' ? '#e74c3c' : '#f39c12';
                            modalHeader.style.color = '#fff';
                            document.getElementById('eventModalTitle').textContent = 'Leave Request Details';

                            modalBody.innerHTML = `
                                <div class="mb-3">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-danger bg-opacity-10 rounded-circle p-3 me-3">
                                            <i class="bi bi-calendar-heart text-danger fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0">${data.employeeName}</h5>
                                            <small class="text-muted">${data.department || 'N/A'}</small>
                                        </div>
                                    </div>
                                </div>
                                <table class="table table-borderless">
                                    <tr>
                                        <td class="text-muted" style="width: 40%;">Leave Type</td>
                                        <td class="fw-semibold">${data.leaveType}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Status</td>
                                        <td><span class="badge ${data.status === 'Approved' ? 'bg-success' : 'bg-warning'}">${data.status}</span></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Duration</td>
                                        <td class="fw-semibold">${data.duration} day(s)</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Start Date</td>
                                        <td>${data.startDate}</td>
                                    </tr>
                                    ${data.justification ? `<tr><td class="text-muted">Reason</td><td>${data.justification}</td></tr>` : ''}
                                </table>
                            `;

                            modalFooter.innerHTML = `
                                <a href="/Leave/Details/${data.id}" class="btn btn-primary">View Full Details</a>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            `;
                        } else if (data.type === 'shift') {
                            modalHeader.style.background = '#667eea';
                            modalHeader.style.color = '#fff';
                            document.getElementById('eventModalTitle').textContent = 'Shift Assignment Details';

                            modalBody.innerHTML = `
                                <div class="mb-3">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                                            <i class="bi bi-clock text-primary fs-4"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0">${data.employeeName}</h5>
                                            <small class="text-muted">${data.department || 'N/A'}</small>
                                        </div>
                                    </div>
                                </div>
                                <table class="table table-borderless">
                                    <tr>
                                        <td class="text-muted" style="width: 40%;">Shift Name</td>
                                        <td class="fw-semibold">${data.shiftName}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Shift Type</td>
                                        <td><span class="badge bg-info">${data.shiftType || 'Standard'}</span></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Time</td>
                                        <td class="fw-semibold">${data.startTime || 'N/A'} - ${data.endTime || 'N/A'}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Start Date</td>
                                        <td>${data.startDate}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">End Date</td>
                                        <td>${data.endDate}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Status</td>
                                        <td><span class="badge bg-success">${data.status}</span></td>
                                    </tr>
                                </table>
                            `;

                            modalFooter.innerHTML = `
                                <a href="/Shift/Details/${data.shiftId}" class="btn btn-primary">View Shift Details</a>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            `;
                        }
                    })
                    .catch(error => {
                        modalBody.innerHTML = '<div class="alert alert-danger">Error loading event details.</div>';
                    });
            }
        });
    </script>
}