@model List<WebApplication1.Models.Employee>
@{
    ViewData["Title"] = "All Employees";
    var departments = Model.Where(e => e.Department != null).Select(e => e.Department.DepartmentName).Distinct().ToList();
    var roles = Model.SelectMany(e => e.EmployeeRoles).Select(er => er.Role?.RoleName).Where(r => r != null).Distinct().ToList();
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 animate-slide-up animate-delay-1">
        <h2 class="section-title"><i class="bi bi-people"></i> All Employees</h2>
        <span class="badge bg-primary fs-6">Total: @Model.Count</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3 animate-slide-up animate-delay-1">
            <div class="card stat-card stat-card-gradient-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Total Employees</div>
                            <div class="stat-value">@Model.Count</div>
                        </div>
                        <i class="bi bi-people-fill stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3 animate-slide-up animate-delay-2">
            <div class="card stat-card stat-card-gradient-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Active Employees</div>
                            <div class="stat-value">@Model.Count(e => e.IsActive == true || e.IsActive == null)</div>
                        </div>
                        <i class="bi bi-person-check-fill stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3 animate-slide-up animate-delay-3">
            <div class="card stat-card stat-card-gradient-info text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Departments</div>
                            <div class="stat-value">@departments.Count</div>
                        </div>
                        <i class="bi bi-building stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4 animate-slide-up animate-delay-2">
            <div class="card shadow">
                <div class="card-header-gradient">
                    <h5 class="mb-0"><i class="bi bi-pie-chart-fill me-2"></i>Department Distribution</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="departmentChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4 animate-slide-up animate-delay-3">
            <div class="card shadow">
                <div class="card-header-gradient">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill me-2"></i>Role Distribution</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="roleChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow mb-4 animate-slide-up animate-delay-1">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="search-container">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name, email, or phone...">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="departmentFilter" class="form-select">
                        <option value="">All Departments</option>
                        @foreach (var dept in departments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Employees Table -->
    <div class="card shadow animate-slide-up animate-delay-2">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="employeesTable">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Department</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No employees found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var emp in Model)
                            {
                                <tr data-name="@emp.FullName?.ToLower()"
                                    data-email="@emp.Email?.ToLower()"
                                    data-phone="@emp.Phone?.ToLower()"
                                    data-department="@(emp.Department?.DepartmentName ?? "")"
                                    data-status="@(emp.IsActive == true || emp.IsActive == null ? "active" : "inactive")">
                                    <td>@emp.EmployeeId</td>
                                    <td><strong>@emp.FullName</strong></td>
                                    <td>@emp.Email</td>
                                    <td>@emp.Phone</td>
                                    <td>
                                        @if (emp.Department != null)
                                        {
                                            <span class="badge bg-primary">@emp.Department.DepartmentName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var employeeRole = emp.EmployeeRoles.FirstOrDefault()?.Role;
                                            if (employeeRole != null)
                                            {
                                                string roleName = employeeRole.RoleName;
                                                string badgeClass = roleName switch
                                                {
                                                    "SYS_ADMIN" => "bg-danger",
                                                    "HR_ADMIN" => "bg-warning text-dark",
                                                    "LINE_MANAGER" => "bg-info",
                                                    "EMPLOYEE" => "bg-secondary",
                                                    _ => "bg-secondary"
                                                };
                                                string displayName = roleName switch
                                                {
                                                    "SYS_ADMIN" => "System Admin",
                                                    "HR_ADMIN" => "HR Admin",
                                                    "LINE_MANAGER" => "Manager",
                                                    "EMPLOYEE" => "Employee",
                                                    _ => roleName.Replace("_", " ")
                                                };
                                                <span class="badge @badgeClass">@displayName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">No Role</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (emp.IsActive == true || emp.IsActive == null)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-secondary me-1">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-controller="Account" asp-action="Edit" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-primary me-1">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        @if (Context.Session.GetString("IsSystemAdmin") == "True")
                                        {
                                            <a asp-controller="Account" asp-action="AssignRole" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-danger">
                                                <i class="bi bi-shield-check"></i> Role
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Department Distribution Chart
            const departmentData = @Html.Raw(Json.Serialize(
                            Model.Where(e => e.Department != null)
                                    .GroupBy(e => e.Department.DepartmentName)
                                    .Select(g => new { Department = g.Key, Count = g.Count() })
                                    .ToList()
                    ));

        const deptCtx = document.getElementById('departmentChart');
        if (deptCtx && departmentData.length > 0) {
            new Chart(deptCtx, {
                type: 'pie',
                data: {
                    labels: departmentData.map(d => d.department),
                    datasets: [{
                        data: departmentData.map(d => d.count),
                        backgroundColor: [
                            'rgba(102, 126, 234, 0.8)',
                            'rgba(118, 75, 162, 0.8)',
                            'rgba(250, 112, 154, 0.8)',
                            'rgba(254, 225, 64, 0.8)',
                            'rgba(79, 172, 254, 0.8)',
                            'rgba(0, 242, 254, 0.8)'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed + ' employees';
                                }
                            }
                        }
                    }
                }
            });
        }

            // Role Distribution Chart
            const roleData = @Html.Raw(Json.Serialize(
                        Model.SelectMany(e => e.EmployeeRoles)
                                .Where(er => er.Role != null)
                                .GroupBy(er => er.Role.RoleName)
                                .Select(g => new { Role = g.Key.Replace("_", " "), Count = g.Count() })
                                .ToList()
                ));

        const roleCtx = document.getElementById('roleChart');
        if (roleCtx && roleData.length > 0) {
            new Chart(roleCtx, {
                type: 'bar',
                data: {
                    labels: roleData.map(r => r.role),
                    datasets: [{
                        label: 'Employees',
                        data: roleData.map(r => r.count),
                        backgroundColor: 'rgba(102, 126, 234, 0.8)',
                        borderColor: 'rgba(102, 126, 234, 1)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

            // Filter functionality
            function filterTable() {
                const searchTerm = $('#searchInput').val().toLowerCase();
                const departmentFilter = $('#departmentFilter').val();
                const statusFilter = $('#statusFilter').val();

                $('#employeesTable tbody tr').each(function() {
                    const name = $(this).data('name') || '';
                    const email = $(this).data('email') || '';
                    const phone = $(this).data('phone') || '';
                    const department = $(this).data('department') || '';
                    const status = $(this).data('status') || '';

                    const matchesSearch = !searchTerm ||
                        name.includes(searchTerm) ||
                        email.includes(searchTerm) ||
                        phone.includes(searchTerm);
                    const matchesDepartment = !departmentFilter || department === departmentFilter;
                    const matchesStatus = !statusFilter || status === statusFilter;

                    if (matchesSearch && matchesDepartment && matchesStatus) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            $('#searchInput, #departmentFilter, #statusFilter').on('input change', filterTable);
        });
    </script>
}