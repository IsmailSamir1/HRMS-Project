@{
    ViewData["Title"] = "Dashboard";
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
}

<div class="container">
    <!-- Welcome Header -->
    <div class="row mb-4 animate-slide-up animate-delay-1">
        <div class="col-12">
            <h2 class="section-title"><i class="bi bi-speedometer2"></i> Welcome, @ViewBag.EmployeeName!</h2>
            <p class="text-muted">
                @if (isSystemAdmin)
                {
                    <span class="badge bg-danger">System Administrator</span>
                }
                @if (isHRAdmin)
                {
                    <span class="badge bg-warning text-dark">HR Administrator</span>
                }
                @if (isLineManager)
                {
                    <span class="badge bg-info">Line Manager</span>
                }
                @if (!isSystemAdmin && !isHRAdmin && !isLineManager)
                {
                    <span class="badge bg-secondary">Employee</span>
                }
            </p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3 animate-slide-up animate-delay-1">
            <div class="card stat-card stat-card-gradient-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Total Employees</div>
                            <div class="stat-value">@ViewBag.TotalEmployees</div>
                        </div>
                        <i class="bi bi-people-fill stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3 animate-slide-up animate-delay-2">
            <div class="card stat-card stat-card-gradient-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Active Employees</div>
                            <div class="stat-value">@ViewBag.ActiveEmployees</div>
                        </div>
                        <i class="bi bi-person-check-fill stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3 animate-slide-up animate-delay-3">
            <div class="card stat-card stat-card-gradient-info text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Departments</div>
                            <div class="stat-value">@ViewBag.TotalDepartments</div>
                        </div>
                        <i class="bi bi-building stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3 animate-slide-up animate-delay-4">
            <div class="card stat-card stat-card-gradient-warning text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Avg. Profile</div>
                            <div class="stat-value">@ViewBag.AvgProfileCompletion%</div>
                        </div>
                        <i class="bi bi-clipboard-check stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4 animate-slide-up animate-delay-2">
            <div class="card shadow h-100">
                <div class="card-header-gradient">
                    <h5 class="mb-0"><i class="bi bi-pie-chart-fill me-2"></i>Employees by Department</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="departmentChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4 animate-slide-up animate-delay-3">
            <div class="card shadow h-100">
                <div class="card-header-gradient">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill me-2"></i>Employees by Role</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="roleChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- QUICK ACTIONS - EVERYONE -->
    <!-- ============================================== -->
    <div class="row">
        <div class="col-12 mb-3">
            <h3 class="section-title"><i class="bi bi-lightning-charge"></i> Quick Actions</h3>
        </div>

        <!-- ROW 1: Main Actions (2 prominent cards) -->
        <!-- Attendance - Clock In/Out -->
        <div class="col-md-6 mb-4 animate-slide-up animate-delay-1">
            <div class="card h-100 shadow border-success border-2 card-hover">
                <div class="card-body text-center py-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-calendar-check display-4 text-success"></i>
                    </div>
                    <h4 class="card-title mt-2">Attendance</h4>
                    <p class="card-text text-muted">Clock in/out and manage your attendance</p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Attendance" asp-action="ClockIn" class="btn btn-success">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Clock In
                        </a>
                        <a asp-controller="Attendance" asp-action="ClockOut" class="btn btn-danger">
                            <i class="bi bi-box-arrow-right me-1"></i> Clock Out
                        </a>
                        <a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-list me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Leave Management -->
        <div class="col-md-6 mb-4 animate-slide-up animate-delay-1">
            <div class="card h-100 shadow border-danger border-2 card-hover">
                <div class="card-body text-center py-4">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-calendar-heart display-4 text-danger"></i>
                    </div>
                    <h4 class="card-title mt-2">Leave Management</h4>
                    <p class="card-text text-muted">Request leave and check your balance</p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Leave" asp-action="Create" class="btn btn-danger">
                            <i class="bi bi-plus-circle me-1"></i> Request Leave
                        </a>
                        <a asp-controller="Leave" asp-action="MyBalance" class="btn btn-warning">
                            <i class="bi bi-pie-chart me-1"></i> My Balance
                        </a>
                        <a asp-controller="Leave" asp-action="MyLeaveRequests" class="btn btn-outline-secondary">
                            <i class="bi bi-list me-1"></i> My Requests
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 2: Featured Cards (3 cards) -->
        <!-- Performance -->
        <div class="col-md-4 mb-4 animate-slide-up animate-delay-2">
            <div class="card h-100 shadow-sm card-hover" style="border: 2px solid #667eea;">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="bi bi-graph-up-arrow text-white fs-2"></i>
                    </div>
                    <h5 class="card-title mt-2">My Performance</h5>
                    <p class="card-text text-muted small">View your performance metrics and scores</p>
                    <a asp-controller="Performance" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-graph-up-arrow me-1"></i> View Performance
                    </a>
                </div>
            </div>
        </div>

        <!-- Team Calendar -->
        <div class="col-md-4 mb-4 animate-slide-up animate-delay-2">
            <div class="card h-100 shadow-sm card-hover" style="border: 2px solid #0d6efd;">
                <div class="card-body text-center py-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-calendar3 text-primary fs-2"></i>
                    </div>
                    <h5 class="card-title mt-2">Team Calendar</h5>
                    <p class="card-text text-muted small">Interactive calendar with leaves and shifts</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Calendar" asp-action="Index" class="btn btn-primary btn-sm">
                            <i class="bi bi-calendar3 me-1"></i> Team
                        </a>
                        <a asp-controller="Calendar" asp-action="MyCalendar" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-person me-1"></i> My Calendar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Organization Chart -->
        <div class="col-md-4 mb-4 animate-slide-up animate-delay-2">
            <div class="card h-100 shadow-sm card-hover" style="border: 2px solid #9b59b6;">
                <div class="card-body text-center py-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; background: rgba(155, 89, 182, 0.1);">
                        <i class="bi bi-diagram-3 fs-2" style="color: #9b59b6;"></i>
                    </div>
                    <h5 class="card-title mt-2">Organization Chart</h5>
                    <p class="card-text text-muted small">Visual hierarchy of the organization</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="OrgChart" asp-action="Index" class="btn text-white btn-sm" style="background: #9b59b6;">
                            <i class="bi bi-diagram-3 me-1"></i> Org Chart
                        </a>
                        <a asp-controller="Hierarchy" asp-action="Departments" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-building me-1"></i> Depts
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ROW 3: Profile & Personal Cards (4 cards) -->
        <!-- My Profile -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-3">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-person-circle display-5 text-primary"></i>
                    <h6 class="card-title mt-2">My Profile</h6>
                    <p class="card-text text-muted small">View your profile</p>
                    <a asp-controller="Employees" asp-action="Details" asp-route-id="@Context.Session.GetInt32("EmployeeId")" class="btn btn-primary btn-sm">
                        <i class="bi bi-person me-1"></i> View
                    </a>
                </div>
            </div>
        </div>

        <!-- Edit Profile -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-3">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-pencil-square display-5 text-success"></i>
                    <h6 class="card-title mt-2">Edit Profile</h6>
                    <p class="card-text text-muted small">Edit your details</p>
                    <a asp-controller="Account" asp-action="Edit" asp-route-id="@Context.Session.GetInt32("EmployeeId")" class="btn btn-success btn-sm">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                </div>
            </div>
        </div>

        <!-- Change Password -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-3">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-key display-5 text-warning"></i>
                    <h6 class="card-title mt-2">Change Password</h6>
                    <p class="card-text text-muted small">Update your password</p>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-warning btn-sm">
                        <i class="bi bi-key me-1"></i> Change
                    </a>
                </div>
            </div>
        </div>

        <!-- Missions -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-3">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-geo-alt display-5 text-info"></i>
                    <h6 class="card-title mt-2">Missions</h6>
                    <p class="card-text text-muted small">Your missions</p>
                    <a asp-controller="Mission" asp-action="Index" class="btn btn-info btn-sm">
                        <i class="bi bi-geo-alt me-1"></i> View
                    </a>
                </div>
            </div>
        </div>

        <!-- ROW 4: Shifts & Notifications (4 cards) -->
        <!-- Shift Management -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-4">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-clock display-5 text-secondary"></i>
                    <h6 class="card-title mt-2">Shifts</h6>
                    <p class="card-text text-muted small">View schedules</p>
                    <a asp-controller="Shift" asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="bi bi-clock me-1"></i> View
                    </a>
                </div>
            </div>
        </div>

        <!-- My Shifts -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-4">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-calendar-week display-5 text-dark"></i>
                    <h6 class="card-title mt-2">My Shifts</h6>
                    <p class="card-text text-muted small">Your schedule</p>
                    <a asp-controller="Shift" asp-action="MyShifts" class="btn btn-dark btn-sm">
                        <i class="bi bi-calendar-week me-1"></i> View
                    </a>
                </div>
            </div>
        </div>

        <!-- Notifications -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-4">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-bell display-5 text-primary"></i>
                    <h6 class="card-title mt-2">Notifications</h6>
                    <p class="card-text text-muted small">Your alerts</p>
                    <a asp-controller="Notifications" asp-action="Index" class="btn btn-primary btn-sm">
                        <i class="bi bi-bell me-1"></i> View
                    </a>
                </div>
            </div>
        </div>

        <!-- Attendance Correction -->
        <div class="col-md-3 col-6 mb-4 animate-slide-up animate-delay-4">
            <div class="card h-100 shadow-sm card-hover">
                <div class="card-body text-center py-3">
                    <i class="bi bi-pencil-square display-5 text-warning"></i>
                    <h6 class="card-title mt-2">Correction</h6>
                    <p class="card-text text-muted small">Request correction</p>
                    <a asp-controller="Attendance" asp-action="RequestCorrection" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil me-1"></i> Request
                    </a>
                </div>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- MANAGER TOOLS -->
        <!-- ============================================== -->
        @if (isLineManager || isHRAdmin || isSystemAdmin)
        {
            <div class="col-12 mt-4 mb-3">
                <h4 class="text-muted"><i class="bi bi-shield-check me-2"></i>Manager Tools</h4>
                <hr />
            </div>

            <!-- Pending Leave Requests -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-5">
                <div class="card h-100 shadow-sm border-warning card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-hourglass-split display-5 text-warning"></i>
                        <h6 class="card-title mt-2">Pending Requests</h6>
                        <p class="card-text text-muted small">Review leave requests</p>
                        <a asp-controller="Leave" asp-action="TeamPendingRequests" class="btn btn-warning btn-sm">
                            <i class="bi bi-hourglass-split me-1"></i> Review
                        </a>
                    </div>
                </div>
            </div>

            <!-- Team Leave Calendar -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-5">
                <div class="card h-100 shadow-sm border-info card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-calendar3 display-5 text-info"></i>
                        <h6 class="card-title mt-2">Team Calendar</h6>
                        <p class="card-text text-muted small">Team's approved leaves</p>
                        <a asp-controller="Leave" asp-action="TeamCalendar" class="btn btn-info btn-sm">
                            <i class="bi bi-calendar3 me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>

            <!-- Leave Patterns -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-5">
                <div class="card h-100 shadow-sm border-danger card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-exclamation-triangle display-5 text-danger"></i>
                        <h6 class="card-title mt-2">Leave Patterns</h6>
                        <p class="card-text text-muted small">Analyze patterns</p>
                        <a asp-controller="Leave" asp-action="LeavePatterns" class="btn btn-danger btn-sm">
                            <i class="bi bi-graph-up me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>

            <!-- Team Performance -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-6">
                <div class="card h-100 shadow-sm border-primary card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-people display-5 text-primary"></i>
                        <h6 class="card-title mt-2">Team Performance</h6>
                        <p class="card-text text-muted small">Monitor team scores</p>
                        <a asp-controller="Performance" asp-action="TeamPerformance" class="btn btn-primary btn-sm">
                            <i class="bi bi-people me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>

            <!-- Correction Requests -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-6">
                <div class="card h-100 shadow-sm border-warning card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-pencil-square display-5 text-warning"></i>
                        <h6 class="card-title mt-2">Corrections</h6>
                        <p class="card-text text-muted small">Review corrections</p>
                        <a asp-controller="Attendance" asp-action="CorrectionRequests" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square me-1"></i> Review
                        </a>
                    </div>
                </div>
            </div>

            @if (isLineManager)
            {
                <!-- My Team -->
                <div class="col-md-4 mb-4 animate-slide-up animate-delay-6">
                    <div class="card h-100 shadow-sm border-success card-hover">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-people-fill display-5 text-success"></i>
                            <h6 class="card-title mt-2">My Team</h6>
                            <p class="card-text text-muted small">View team members</p>
                            <a asp-controller="Home" asp-action="MyTeam" class="btn btn-success btn-sm">
                                <i class="bi bi-eye me-1"></i> View
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Send to Team -->
                <div class="col-md-4 mb-4 animate-slide-up animate-delay-7">
                    <div class="card h-100 shadow-sm border-primary card-hover">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-send display-5 text-primary"></i>
                            <h6 class="card-title mt-2">Send to Team</h6>
                            <p class="card-text text-muted small">Send notifications</p>
                            <a asp-controller="Notifications" asp-action="Send" class="btn btn-primary btn-sm">
                                <i class="bi bi-send me-1"></i> Send
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Team Attendance -->
                <div class="col-md-4 mb-4 animate-slide-up animate-delay-7">
                    <div class="card h-100 shadow-sm border-success card-hover">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-calendar-check display-5 text-success"></i>
                            <h6 class="card-title mt-2">Team Attendance</h6>
                            <p class="card-text text-muted small">Attendance summary</p>
                            <a asp-controller="Attendance" asp-action="TeamSummary" class="btn btn-success btn-sm">
                                <i class="bi bi-people me-1"></i> View
                            </a>
                        </div>
                    </div>
                </div>

                @if (!isSystemAdmin)
                {
                    <!-- Assign Shift (Manager) -->
                    <div class="col-md-4 mb-4 animate-slide-up animate-delay-7">
                        <div class="card h-100 shadow-sm border-info card-hover">
                            <div class="card-body text-center py-3">
                                <i class="bi bi-person-plus display-5 text-info"></i>
                                <h6 class="card-title mt-2">Assign Shift</h6>
                                <p class="card-text text-muted small">Assign to team</p>
                                <a asp-controller="Shift" asp-action="Assign" class="btn btn-info btn-sm">
                                    <i class="bi bi-person-plus me-1"></i> Assign
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        }

        <!-- ============================================== -->
        <!-- HR ADMINISTRATION -->
        <!-- ============================================== -->
        @if (isHRAdmin || isSystemAdmin)
        {
            <div class="col-12 mt-4 mb-3">
                <h4 class="text-muted"><i class="bi bi-gear me-2"></i>HR Administration</h4>
                <hr />
            </div>

            <!-- Leave Types -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-8">
                <div class="card h-100 shadow-sm border-primary card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-tags display-5 text-primary"></i>
                        <h6 class="card-title mt-2">Leave Types</h6>
                        <p class="card-text text-muted small">Configure types</p>
                        <a asp-controller="Leave" asp-action="LeaveTypes" class="btn btn-primary btn-sm">
                            <i class="bi bi-gear me-1"></i> Manage
                        </a>
                    </div>
                </div>
            </div>

            <!-- Leave Entitlements -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-8">
                <div class="card h-100 shadow-sm border-success card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-sliders display-5 text-success"></i>
                        <h6 class="card-title mt-2">Entitlements</h6>
                        <p class="card-text text-muted small">Manage entitlements</p>
                        <a asp-controller="Leave" asp-action="ManageEntitlements" class="btn btn-success btn-sm">
                            <i class="bi bi-sliders me-1"></i> Manage
                        </a>
                    </div>
                </div>
            </div>

            <!-- Special Leave Report -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-8">
                <div class="card h-100 shadow-sm border-warning card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-star display-5 text-warning"></i>
                        <h6 class="card-title mt-2">Special Leave</h6>
                        <p class="card-text text-muted small">Special leave report</p>
                        <a asp-controller="Leave" asp-action="SpecialLeaveReport" class="btn btn-warning btn-sm">
                            <i class="bi bi-star me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>

            <!-- All Employees -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-9">
                <div class="card h-100 shadow-sm border-secondary card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-people display-5 text-secondary"></i>
                        <h6 class="card-title mt-2">All Employees</h6>
                        <p class="card-text text-muted small">View all profiles</p>
                        <a asp-controller="Home" asp-action="AllEmployees" class="btn btn-secondary btn-sm">
                            <i class="bi bi-list me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>

            <!-- Skills Directory -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-9">
                <div class="card h-100 shadow-sm border-info card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-tools display-5 text-info"></i>
                        <h6 class="card-title mt-2">Skills Directory</h6>
                        <p class="card-text text-muted small">Manage skills</p>
                        <a asp-controller="Performance" asp-action="SkillsDirectory" class="btn btn-info btn-sm">
                            <i class="bi bi-tools me-1"></i> Manage
                        </a>
                    </div>
                </div>
            </div>

            @if (isHRAdmin)
            {
                <!-- Assign Mission -->
                <div class="col-md-4 mb-4 animate-slide-up animate-delay-9">
                    <div class="card h-100 shadow-sm border-success card-hover">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-geo-alt-fill display-5 text-success"></i>
                            <h6 class="card-title mt-2">Assign Mission</h6>
                            <p class="card-text text-muted small">Assign missions</p>
                            <a asp-controller="Mission" asp-action="Create" class="btn btn-success btn-sm">
                                <i class="bi bi-plus-circle me-1"></i> Assign
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Contracts -->
                <div class="col-md-4 mb-4 animate-slide-up animate-delay-10">
                    <div class="card h-100 shadow-sm border-primary card-hover">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-file-earmark-text display-5 text-primary"></i>
                            <h6 class="card-title mt-2">Contracts</h6>
                            <p class="card-text text-muted small">Manage contracts</p>
                            <a asp-controller="Contracts" asp-action="Index" class="btn btn-primary btn-sm">
                                <i class="bi bi-file-earmark-text me-1"></i> Manage
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Profile Completeness -->
                <div class="col-md-4 mb-4 animate-slide-up animate-delay-10">
                    <div class="card h-100 shadow-sm border-success card-hover">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-clipboard-check display-5 text-success"></i>
                            <h6 class="card-title mt-2">Profile Status</h6>
                            <p class="card-text text-muted small">Track completion</p>
                            <a asp-controller="Home" asp-action="ManageProfileCompleteness" class="btn btn-success btn-sm">
                                <i class="bi bi-clipboard-check me-1"></i> Manage
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Analytics -->
                <div class="col-md-4 mb-4 animate-slide-up animate-delay-10">
                    <div class="card h-100 shadow-sm border-info card-hover">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-bar-chart-line display-5 text-info"></i>
                            <h6 class="card-title mt-2">Analytics</h6>
                            <p class="card-text text-muted small">Reports & stats</p>
                            <a asp-controller="Analytics" asp-action="Index" class="btn btn-info btn-sm">
                                <i class="bi bi-graph-up me-1"></i> View
                            </a>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- ============================================== -->
        <!-- SYSTEM ADMINISTRATION -->
        <!-- ============================================== -->
        @if (isSystemAdmin)
        {
            <div class="col-12 mt-4 mb-3">
                <h4 class="text-danger"><i class="bi bi-shield-lock me-2"></i>System Administration</h4>
                <hr class="border-danger" />
            </div>

            <!-- Create Employee -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-11">
                <div class="card h-100 shadow-sm border-danger card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-person-plus display-5 text-danger"></i>
                        <h6 class="card-title mt-2">Create Employee</h6>
                        <p class="card-text text-muted small">Add new employee</p>
                        <a asp-controller="Account" asp-action="CreateEmployee" class="btn btn-danger btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Create
                        </a>
                    </div>
                </div>
            </div>

            <!-- Login Activity -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-11">
                <div class="card h-100 shadow-sm border-danger card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-clock-history display-5 text-danger"></i>
                        <h6 class="card-title mt-2">Login Activity</h6>
                        <p class="card-text text-muted small">Monitor logins</p>
                        <a asp-controller="Account" asp-action="LoginActivity" class="btn btn-danger btn-sm">
                            <i class="bi bi-clock-history me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>

            <!-- Organizational Hierarchy -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-11">
                <div class="card h-100 shadow-sm border-danger card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-diagram-3 display-5 text-danger"></i>
                        <h6 class="card-title mt-2">Hierarchy</h6>
                        <p class="card-text text-muted small">Company structure</p>
                        <a asp-controller="Hierarchy" asp-action="Index" class="btn btn-danger btn-sm">
                            <i class="bi bi-diagram-3 me-1"></i> View
                        </a>
                    </div>
                </div>
            </div>

            <!-- Create Shift -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-12">
                <div class="card h-100 shadow-sm border-danger card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-plus-circle display-5 text-danger"></i>
                        <h6 class="card-title mt-2">Create Shift</h6>
                        <p class="card-text text-muted small">New shift type</p>
                        <a asp-controller="Shift" asp-action="Create" class="btn btn-danger btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Create
                        </a>
                    </div>
                </div>
            </div>

            <!-- Sync Leave -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-12">
                <div class="card h-100 shadow-sm border-danger card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-arrow-repeat display-5 text-danger"></i>
                        <h6 class="card-title mt-2">Sync Leave</h6>
                        <p class="card-text text-muted small">Sync with attendance</p>
                        <a asp-controller="Attendance" asp-action="SyncLeave" class="btn btn-danger btn-sm">
                            <i class="bi bi-arrow-repeat me-1"></i> Sync
                        </a>
                    </div>
                </div>
            </div>

            <!-- Assign Shift -->
            <div class="col-md-4 mb-4 animate-slide-up animate-delay-12">
                <div class="card h-100 shadow-sm border-danger card-hover">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-person-plus display-5 text-danger"></i>
                        <h6 class="card-title mt-2">Assign Shift</h6>
                        <p class="card-text text-muted small">Assign to employees</p>
                        <a asp-controller="Shift" asp-action="Assign" class="btn btn-danger btn-sm">
                            <i class="bi bi-person-plus me-1"></i> Assign
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Department Distribution Pie Chart
            const departmentCtx = document.getElementById('departmentChart');
            if (departmentCtx) {
                const departmentLabels = @Html.Raw(Json.Serialize(ViewBag.DepartmentLabels ?? new List<string>()));
                const departmentCounts = @Html.Raw(Json.Serialize(ViewBag.DepartmentCounts ?? new List<int>()));

                new Chart(departmentCtx, {
                    type: 'pie',
                    data: {
                        labels: departmentLabels,
                        datasets: [{
                            data: departmentCounts,
                            backgroundColor: [
                                'rgba(102, 126, 234, 0.8)',
                                'rgba(118, 75, 162, 0.8)',
                                'rgba(250, 112, 154, 0.8)',
                                'rgba(254, 225, 64, 0.8)',
                                'rgba(79, 172, 254, 0.8)',
                                'rgba(0, 242, 254, 0.8)',
                                'rgba(255, 107, 107, 0.8)',
                                'rgba(238, 90, 111, 0.8)'
                            ],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 15,
                                    font: { size: 12, weight: '500' }
                                }
                            }
                        }
                    }
                });
            }

            // Role Distribution Bar Chart
            const roleCtx = document.getElementById('roleChart');
            if (roleCtx) {
                const roleLabels = @Html.Raw(Json.Serialize(ViewBag.RoleLabels ?? new List<string>()));
                const roleCounts = @Html.Raw(Json.Serialize(ViewBag.RoleCounts ?? new List<int>()));

                new Chart(roleCtx, {
                    type: 'bar',
                    data: {
                        labels: roleLabels,
                        datasets: [{
                            label: 'Employees',
                            data: roleCounts,
                            backgroundColor: 'rgba(102, 126, 234, 0.8)',
                            borderColor: 'rgba(102, 126, 234, 1)',
                            borderWidth: 2,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1 } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        });
    </script>
}