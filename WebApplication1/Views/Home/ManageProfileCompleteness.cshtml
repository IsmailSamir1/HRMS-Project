@model List<WebApplication1.Models.Employee>
@{
    ViewData["Title"] = "Manage Profile Completeness";
}

@{
    var avgCompletion = Model.Where(e => e.ProfileCompletion.HasValue).Select(e => e.ProfileCompletion.Value).DefaultIfEmpty(0).Average();
    var highCompletion = Model.Count(e => (e.ProfileCompletion ?? 0) >= 90);
    var mediumCompletion = Model.Count(e => (e.ProfileCompletion ?? 0) >= 50 && (e.ProfileCompletion ?? 0) < 90);
    var lowCompletion = Model.Count(e => (e.ProfileCompletion ?? 0) < 50);
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 animate-slide-up animate-delay-1">
        <h2 class="section-title"><i class="bi bi-clipboard-check"></i> Manage Profile Completeness</h2>
        <span class="badge bg-warning fs-6">Total Employees: @Model.Count</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3 animate-slide-up animate-delay-1">
            <div class="card stat-card stat-card-gradient-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Avg. Completion</div>
                            <div class="stat-value">@Math.Round(avgCompletion, 1)%</div>
                        </div>
                        <i class="bi bi-clipboard-check stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3 animate-slide-up animate-delay-2">
            <div class="card stat-card stat-card-gradient-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">High (90%+)</div>
                            <div class="stat-value">@highCompletion</div>
                        </div>
                        <i class="bi bi-check-circle-fill stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3 animate-slide-up animate-delay-3">
            <div class="card stat-card stat-card-gradient-warning text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Medium (50-89%)</div>
                            <div class="stat-value">@mediumCompletion</div>
                        </div>
                        <i class="bi bi-exclamation-triangle-fill stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3 animate-slide-up animate-delay-4">
            <div class="card stat-card stat-card-gradient-danger text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Low (&lt;50%)</div>
                            <div class="stat-value">@lowCompletion</div>
                        </div>
                        <i class="bi bi-x-circle-fill stat-icon"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <div class="col-md-6 mb-4 animate-slide-up animate-delay-2">
            <div class="card shadow">
                <div class="card-header-gradient">
                    <h5 class="mb-0"><i class="bi bi-pie-chart-fill me-2"></i>Completion Distribution</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="completionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4 animate-slide-up animate-delay-3">
            <div class="card shadow">
                <div class="card-header-gradient">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill me-2"></i>Department Average Completion</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="departmentChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow animate-slide-up animate-delay-1">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Completion</th>
                            <th>Missing Fields</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No employees found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var emp in Model)
                            {
                                var completion = emp.ProfileCompletion ?? 0;
                                string badgeClass = completion switch
                                {
                                    >= 90 => "bg-success",
                                    >= 70 => "bg-info",
                                    >= 50 => "bg-warning text-dark",
                                    _ => "bg-danger"
                                };

                                // Check missing fields
                                var missingFields = new List<string>();
                                if (string.IsNullOrWhiteSpace(emp.FirstName)) missingFields.Add("First Name");
                                if (string.IsNullOrWhiteSpace(emp.LastName)) missingFields.Add("Last Name");
                                if (string.IsNullOrWhiteSpace(emp.Email)) missingFields.Add("Email");
                                if (string.IsNullOrWhiteSpace(emp.Phone)) missingFields.Add("Phone");
                                if (string.IsNullOrWhiteSpace(emp.Address)) missingFields.Add("Address");
                                if (string.IsNullOrWhiteSpace(emp.NationalId)) missingFields.Add("National ID");
                                if (!emp.DateOfBirth.HasValue) missingFields.Add("Date of Birth");
                                if (string.IsNullOrWhiteSpace(emp.CountryOfBirth)) missingFields.Add("Country of Birth");
                                if (string.IsNullOrWhiteSpace(emp.EmergencyContactName)) missingFields.Add("Emergency Contact");
                                if (string.IsNullOrWhiteSpace(emp.EmergencyContactPhone)) missingFields.Add("Emergency Phone");
                                if (string.IsNullOrWhiteSpace(emp.Relationship)) missingFields.Add("Relationship");
                                if (!emp.DepartmentId.HasValue) missingFields.Add("Department");
                                if (!emp.PositionId.HasValue) missingFields.Add("Position");
                                if (!emp.ContractId.HasValue) missingFields.Add("Contract");
                                if (string.IsNullOrWhiteSpace(emp.Biography)) missingFields.Add("Biography");

                                <tr>
                                    <td>@emp.EmployeeId</td>
                                    <td><strong>@emp.FullName</strong></td>
                                    <td>@emp.Email</td>
                                    <td>
                                        @if (emp.Department != null)
                                        {
                                            @emp.Department.DepartmentName
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 20px;">
                                                <div class="progress-bar @badgeClass" role="progressbar" 
                                                     style="width: @completion%" 
                                                     aria-valuenow="@completion" 
                                                     aria-valuemin="0" 
                                                     aria-valuemax="100">
                                                    @completion%
                                                </div>
                                            </div>
                                            <span class="badge @badgeClass">@completion%</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (missingFields.Count > 0)
                                        {
                                            <small class="text-danger">
                                                <i class="bi bi-exclamation-triangle"></i> @missingFields.Count missing
                                                <button type="button"
                                                        class="btn btn-sm btn-link text-danger p-0 missing-info"
                                                        data-employee-name="@emp.FullName"
                                                        data-missing-fields="@string.Join(", ", missingFields)">
                                                    <i class="bi bi-info-circle"></i>
                                                </button>
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Complete</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- Missing Fields Modal -->
<div class="modal fade" id="missingFieldsModal" tabindex="-1" aria-labelledby="missingFieldsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="missingFieldsModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Missing Profile Fields
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    <strong>Employee:</strong> <span id="modalEmployeeName" class="text-primary"></span>
                </p>
                <div class="alert alert-warning mb-0">
                    <h6 class="alert-heading">
                        <i class="bi bi-list-ul"></i> The following fields are missing:
                    </h6>
                    <hr>
                    <ul class="mb-0" id="modalMissingFieldsList">
                        <!-- Fields will be populated by JavaScript -->
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Smooth modal animation */
    .modal.fade .modal-dialog {
        transition: transform 0.3s ease-out;
        transform: translate(0, -50px);
    }

    .modal.show .modal-dialog {
        transform: translate(0, 0);
    }

    .modal-body ul {
        list-style-type: none;
        padding-left: 0;
    }

    .modal-body ul li {
        padding: 0.5rem 0;
        border-bottom: 1px dashed #dee2e6;
    }

    .modal-body ul li:last-child {
        border-bottom: none;
    }

    .modal-body ul li:before {
        content: "• ";
        color: #dc3545;
        font-weight: bold;
        font-size: 1.2rem;
        margin-right: 0.5rem;
    }
</style>

@section Scripts {
<script>
    $(document).ready(function () {
        console.log('jQuery ready, initializing modal handlers...');
        
        // Handle missing info click -> populate and show modal
        $('.missing-info').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            
            console.log('Info button clicked!');
            
            var $btn = $(this);
            var employeeName = $btn.data('employee-name') || 'Unknown';
            var missingFields = $btn.data('missing-fields') || 'No details';
            
            console.log('Employee:', employeeName);
            console.log('Missing fields:', missingFields);
            
            // Split comma-separated fields into array
            var fieldsArray = missingFields.split(',').map(function(field) {
                return field.trim();
            }).filter(function(field) {
                return field.length > 0;
            });
            
            console.log('Fields array:', fieldsArray);
            
            // Update modal content
            $('#modalEmployeeName').text(employeeName);
            
            // Clear and populate the list
            var $list = $('#modalMissingFieldsList');
            $list.empty();
            
            if (fieldsArray.length > 0) {
                fieldsArray.forEach(function(field) {
                    $list.append($('<li>').text(field));
                });
                console.log('Populated', fieldsArray.length, 'missing fields');
            } else {
                $list.append($('<li>').text('No missing fields information available').css('color', '#6c757d'));
            }
            
            // Show modal with animation
            var modal = new bootstrap.Modal(document.getElementById('missingFieldsModal'));
            modal.show();
            console.log('Modal shown');
        });

        // Completion Distribution Pie Chart
        const completionCtx = document.getElementById('completionChart');
        if (completionCtx) {
            const highCount = @highCompletion;
            const mediumCount = @mediumCompletion;
            const lowCount = @lowCompletion;

            new Chart(completionCtx, {
                type: 'pie',
                data: {
                    labels: ['High (90%+)', 'Medium (50-89%)', 'Low (<50%)'],
                    datasets: [{
                        data: [highCount, mediumCount, lowCount],
                        backgroundColor: [
                            'rgba(40, 167, 69, 0.8)',
                            'rgba(255, 193, 7, 0.8)',
                            'rgba(220, 53, 69, 0.8)'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed + ' employees';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Department Average Completion Chart
        const deptCompletionData = @Html.Raw(Json.Serialize(
            Model.Where(e => e.Department != null && e.ProfileCompletion.HasValue)
                .GroupBy(e => e.Department.DepartmentName)
                .Select(g => new { 
                    Department = g.Key, 
                    AvgCompletion = Math.Round(g.Average(e => e.ProfileCompletion.Value), 1)
                })
                .OrderByDescending(x => x.AvgCompletion)
                .ToList()
        ));

        const deptCtx = document.getElementById('departmentChart');
        if (deptCtx && deptCompletionData.length > 0) {
            new Chart(deptCtx, {
                type: 'bar',
                data: {
                    labels: deptCompletionData.map(d => d.department),
                    datasets: [{
                        label: 'Average Completion %',
                        data: deptCompletionData.map(d => d.avgCompletion),
                        backgroundColor: 'rgba(102, 126, 234, 0.8)',
                        borderColor: 'rgba(102, 126, 234, 1)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y + '%';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                callback: function(value) {
                                    return value + '%';
                                }
                            }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // Initialize Bootstrap tooltips
        $('[data-bs-toggle="tooltip"]').tooltip();

        // Auto-refresh page every 30 seconds to recalculate completion
        setTimeout(function () {
            location.reload();
        }, 30000);
    });
</script>
}