@model List<WebApplication1.Models.Employee>
@{
    ViewData["Title"] = "My Team";
    var managerId = Context.Session.GetInt32("EmployeeId");
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 animate-slide-up animate-delay-1">
        <h2 class="section-title"><i class="bi bi-people-fill"></i> My Team</h2>
        <span class="badge bg-info fs-6">Members: @Model.Count</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info animate-slide-up animate-delay-1">
            <i class="bi bi-info-circle"></i> You currently have no team members assigned.
        </div>
    }
    else
    {
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3 animate-slide-up animate-delay-1">
                <div class="card stat-card stat-card-gradient-info text-white shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="stat-label">Team Size</div>
                                <div class="stat-value">@Model.Count</div>
                            </div>
                            <i class="bi bi-people-fill stat-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3 animate-slide-up animate-delay-2">
                <div class="card stat-card stat-card-gradient-success text-white shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="stat-label">Avg. Profile Completion</div>
                                <div class="stat-value">
                                    @{
                                        var avgCompletion = Model.Where(e => e.ProfileCompletion.HasValue)
                                        .Select(e => e.ProfileCompletion.Value)
                                        .DefaultIfEmpty(0)
                                        .Average();
                                        <text>@Math.Round(avgCompletion, 1)%</text>
                                    }
                                </div>
                            </div>
                            <i class="bi bi-clipboard-check stat-icon"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3 animate-slide-up animate-delay-3">
                <div class="card stat-card stat-card-gradient-primary text-white shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="stat-label">Departments</div>
                                <div class="stat-value">@Model.Where(e => e.Department != null).Select(e => e.Department.DepartmentName).Distinct().Count()</div>
                            </div>
                            <i class="bi bi-building stat-icon"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Department Distribution Chart -->
        <div class="row mb-4">
            <div class="col-md-6 mb-4 animate-slide-up animate-delay-2">
                <div class="card shadow">
                    <div class="card-header-gradient">
                        <h5 class="mb-0"><i class="bi bi-pie-chart-fill me-2"></i>Team by Department</h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="departmentChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4 animate-slide-up animate-delay-3">
                <div class="card shadow">
                    <div class="card-header-gradient">
                        <h5 class="mb-0"><i class="bi bi-bar-chart-fill me-2"></i>Team by Role</h5>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="roleChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Members Table -->
        <div class="card shadow animate-slide-up animate-delay-2">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Position</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model)
                            {
                                <tr>
                                    <td>@emp.EmployeeId</td>
                                    <td><strong>@emp.FullName</strong></td>
                                    <td>@emp.Email</td>
                                    <td>@emp.Phone</td>
                                    <td>
                                        @if (emp.Department != null)
                                        {
                                            <span class="badge bg-primary">@emp.Department.DepartmentName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (emp.Position != null)
                                        {
                                            @emp.Position.PositionTitle
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var employeeRole = emp.EmployeeRoles.FirstOrDefault()?.Role;
                                            if (employeeRole != null)
                                            {
                                                string roleName = employeeRole.RoleName;
                                                string badgeClass = roleName switch
                                                {
                                                    "SYS_ADMIN" => "bg-danger",
                                                    "HR_ADMIN" => "bg-warning text-dark",
                                                    "LINE_MANAGER" => "bg-info",
                                                    "EMPLOYEE" => "bg-secondary",
                                                    _ => "bg-secondary"
                                                };
                                                string displayName = roleName switch
                                                {
                                                    "SYS_ADMIN" => "System Admin",
                                                    "HR_ADMIN" => "HR Admin",
                                                    "LINE_MANAGER" => "Manager",
                                                    "EMPLOYEE" => "Employee",
                                                    _ => roleName.Replace("_", " ")
                                                };
                                                <span class="badge @badgeClass">@displayName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">No Role</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (emp.IsActive == true || emp.IsActive == null)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Employees"
                                           asp-action="Details"
                                           asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i> View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Department Distribution Chart
            const departmentData = @Html.Raw(Json.Serialize(
                            Model.Where(e => e.Department != null)
                                    .GroupBy(e => e.Department.DepartmentName)
                                    .Select(g => new { Department = g.Key, Count = g.Count() })
                                    .ToList()
                    ));

        const deptCtx = document.getElementById('departmentChart');
        if (deptCtx && departmentData.length > 0) {
            new Chart(deptCtx, {
                type: 'pie',
                data: {
                    labels: departmentData.map(d => d.department),
                    datasets: [{
                        data: departmentData.map(d => d.count),
                        backgroundColor: [
                            'rgba(102, 126, 234, 0.8)',
                            'rgba(118, 75, 162, 0.8)',
                            'rgba(250, 112, 154, 0.8)',
                            'rgba(254, 225, 64, 0.8)',
                            'rgba(79, 172, 254, 0.8)'
                        ],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed + ' members';
                                }
                            }
                        }
                    }
                }
            });
        }

            // Role Distribution Chart
            const roleData = @Html.Raw(Json.Serialize(
                        Model.SelectMany(e => e.EmployeeRoles)
                                .Where(er => er.Role != null)
                                .GroupBy(er => er.Role.RoleName)
                                .Select(g => new { Role = g.Key.Replace("_", " "), Count = g.Count() })
                                .ToList()
                ));

        const roleCtx = document.getElementById('roleChart');
        if (roleCtx && roleData.length > 0) {
            new Chart(roleCtx, {
                type: 'bar',
                data: {
                    labels: roleData.map(r => r.role),
                    datasets: [{
                        label: 'Team Members',
                        data: roleData.map(r => r.count),
                        backgroundColor: 'rgba(79, 172, 254, 0.8)',
                        borderColor: 'rgba(79, 172, 254, 1)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
    });
</script>
}