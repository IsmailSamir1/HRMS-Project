@model WebApplication1.Models.Contract

@{
    ViewData["Title"] = "Create Contract";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-file-earmark-text"></i> Create Employment Contract</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Select Employee</label>
                            <select name="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeId">
                                <option value="">-- Select an Employee --</option>
                            </select>
                            <small class="text-muted">The new contract will be assigned to this employee.</small>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-bold">Contract Type</label>
                                <select asp-for="Type" class="form-select">
                                    <option value="Full-Time">Full-Time</option>
                                    <option value="Part-Time">Part-Time</option>
                                    <option value="Internship">Internship</option>
                                    <option value="Consultant">Consultant</option>
                                    <option value="Temporary">Temporary</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CurrentState" class="form-label fw-bold">Initial Status</label>
                                <input type="text" class="form-control" value="Active" disabled readonly />
                                <small class="text-muted">New contracts default to Active.</small>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-bold">Start Date</label>
                                <input asp-for="StartDate" type="date" class="form-control" required />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-bold">End Date</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                                <small class="text-muted">Leave blank for indefinite/permanent.</small>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Create Contract</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}