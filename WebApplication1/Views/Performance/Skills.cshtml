@{
    ViewData["Title"] = "My Skills";
    var allSkills = ViewBag.AllSkills as List<WebApplication1.Models.Skill>;
    var employeeSkills = ViewBag.EmployeeSkills as List<WebApplication1.Models.EmployeeSkill>;
    var employeeSkillIds = employeeSkills?.Select(es => es.SkillId).ToList() ?? new List<int>();
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-tools text-primary me-2"></i>My Skills</h2>
            <p class="text-muted mb-0">Manage your skills and proficiency levels</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Performance
        </a>
    </div>

    <div class="row">
        <!-- Current Skills -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary bg-opacity-10 border-0">
                    <h5 class="mb-0"><i class="bi bi-star me-2"></i>My Current Skills (@(employeeSkills?.Count ?? 0))</h5>
                </div>
                <div class="card-body">
                    @if (employeeSkills != null && employeeSkills.Any())
                    {
                        @foreach (var skill in employeeSkills)
                        {
                            var badgeColor = skill.ProficiencyLevel switch
                            {
                                "Expert" => "success",
                                "Advanced" => "primary",
                                "Intermediate" => "info",
                                _ => "secondary"
                            };
                            <div class="d-flex justify-content-between align-items-center p-3 mb-2 bg-light rounded">
                                <div>
                                    <strong>@skill.Skill?.SkillName</strong>
                                    <br />
                                    <small class="text-muted">@skill.Skill?.Description</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-@badgeColor">@skill.ProficiencyLevel</span>
                                    <form asp-action="RemoveSkill" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="skillId" value="@skill.SkillId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this skill?');">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-tools fs-1"></i>
                            <p class="mt-2">No skills added yet</p>
                            <p class="small">Add skills from the list on the right</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Add Skills -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-success bg-opacity-10 border-0">
                    <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add or Update Skills</h5>
                </div>
                <div class="card-body">
                    @if (allSkills != null && allSkills.Any())
                    {
                        @foreach (var skill in allSkills)
                        {
                            var existingSkill = employeeSkills?.FirstOrDefault(es => es.SkillId == skill.SkillId);
                            var currentLevel = existingSkill?.ProficiencyLevel ?? "";

                            <div class="card mb-2">
                                <div class="card-body py-2">
                                    <form asp-action="UpdateSkill" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="skillId" value="@skill.SkillId" />
                                        <div class="row align-items-center">
                                            <div class="col-md-5">
                                                <strong>@skill.SkillName</strong>
                                                @if (existingSkill != null)
                                                {
                                                    <span class="badge bg-success ms-1">Added</span>
                                                }
                                            </div>
                                            <div class="col-md-4">
                                                <select name="proficiencyLevel" class="form-select form-select-sm">
                                                    <option value="Beginner" selected="@(currentLevel == "Beginner")">Beginner</option>
                                                    <option value="Intermediate" selected="@(currentLevel == "Intermediate")">Intermediate</option>
                                                    <option value="Advanced" selected="@(currentLevel == "Advanced")">Advanced</option>
                                                    <option value="Expert" selected="@(currentLevel == "Expert")">Expert</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 text-end">
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    @(existingSkill != null ? "Update" : "Add")
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-database fs-1"></i>
                            <p class="mt-2">No skills available in the system</p>
                            <p class="small">Contact HR to add skills to the directory</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Proficiency Level Guide -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Proficiency Level Guide</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="p-3 bg-secondary bg-opacity-10 rounded text-center">
                        <span class="badge bg-secondary mb-2">Beginner</span>
                        <p class="small mb-0">Basic understanding, learning the fundamentals</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-info bg-opacity-10 rounded text-center">
                        <span class="badge bg-info mb-2">Intermediate</span>
                        <p class="small mb-0">Can work independently on standard tasks</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-primary bg-opacity-10 rounded text-center">
                        <span class="badge bg-primary mb-2">Advanced</span>
                        <p class="small mb-0">Deep expertise, can handle complex problems</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-success bg-opacity-10 rounded text-center">
                        <span class="badge bg-success mb-2">Expert</span>
                        <p class="small mb-0">Mastery level, can teach and lead others</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>