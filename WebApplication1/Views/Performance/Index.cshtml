@{
    ViewData["Title"] = "My Performance";
    var employee = ViewBag.Employee as WebApplication1.Models.Employee;
    var perfData = ViewBag.PerformanceData as WebApplication1.Controllers.PerformanceData;
    var skills = ViewBag.Skills as List<WebApplication1.Models.EmployeeSkill>;
    var missions = ViewBag.Missions as List<WebApplication1.Models.Mission>;
    var notes = ViewBag.RecentNotes as List<WebApplication1.Models.ManagerNote>;
    bool isLineManager = ViewBag.IsLineManager == true;
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-graph-up-arrow text-primary me-2"></i>My Performance Dashboard</h2>
            <p class="text-muted mb-0">Track your performance metrics and progress</p>
        </div>
        <div class="d-flex gap-2">
            @if (isLineManager || isHRAdmin || isSystemAdmin)
            {
                <a asp-action="TeamPerformance" class="btn btn-outline-primary">
                    <i class="bi bi-people me-1"></i> Team Performance
                </a>
            }
            <a asp-action="Skills" class="btn btn-outline-secondary">
                <i class="bi bi-tools me-1"></i> Manage Skills
            </a>
        </div>
    </div>

    <!-- Overall Score Card -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <div class="position-relative d-inline-block mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto"
                             style="width: 150px; height: 150px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <div class="text-white">
                                <h1 class="mb-0 fw-bold">@perfData?.OverallScore</h1>
                                <small>/ 100</small>
                            </div>
                        </div>
                    </div>
                    <h4 class="mb-2">Overall Performance</h4>
                    <span class="badge bg-@perfData?.BadgeColor fs-6 px-3 py-2">@perfData?.PerformanceLevel</span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Performance Breakdown</h5>
                </div>
                <div class="card-body">
                    <!-- Attendance Score -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-calendar-check text-success me-2"></i>Attendance (30%)</span>
                            <span class="fw-bold">@perfData?.AttendanceScore.ToString("F1")%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-success" style="width: @perfData?.AttendanceScore%"></div>
                        </div>
                        <small class="text-muted">@perfData?.PresentDays days present, @perfData?.LateArrivals late arrivals</small>
                    </div>

                    <!-- Leave Score -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-calendar-heart text-info me-2"></i>Leave Management (20%)</span>
                            <span class="fw-bold">@perfData?.LeaveScore.ToString("F1")%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-info" style="width: @perfData?.LeaveScore%"></div>
                        </div>
                        <small class="text-muted">@perfData?.TotalLeaveDays total leave days taken</small>
                    </div>

                    <!-- Mission Score -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-flag text-warning me-2"></i>Mission Completion (25%)</span>
                            <span class="fw-bold">@perfData?.MissionScore.ToString("F1")%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-warning" style="width: @perfData?.MissionScore%"></div>
                        </div>
                        <small class="text-muted">@perfData?.CompletedMissions / @perfData?.TotalMissions missions completed</small>
                    </div>

                    <!-- Skills Score -->
                    <div class="mb-0">
                        <div class="d-flex justify-content-between mb-1">
                            <span><i class="bi bi-tools text-primary me-2"></i>Skills & Expertise (25%)</span>
                            <span class="fw-bold">@perfData?.SkillsScore.ToString("F1")%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-primary" style="width: @perfData?.SkillsScore%"></div>
                        </div>
                        <small class="text-muted">@perfData?.TotalSkills skills (@perfData?.ExpertSkills expert, @perfData?.AdvancedSkills advanced)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 bg-success bg-opacity-10">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-check text-success fs-1 mb-2"></i>
                    <h3 class="mb-0">@perfData?.AttendanceRate%</h3>
                    <small class="text-muted">Attendance Rate</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 bg-info bg-opacity-10">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-heart text-info fs-1 mb-2"></i>
                    <h3 class="mb-0">@perfData?.TotalLeaveDays</h3>
                    <small class="text-muted">Leave Days Used</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 bg-warning bg-opacity-10">
                <div class="card-body text-center">
                    <i class="bi bi-flag text-warning fs-1 mb-2"></i>
                    <h3 class="mb-0">@perfData?.CompletedMissions</h3>
                    <small class="text-muted">Missions Completed</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 bg-primary bg-opacity-10">
                <div class="card-body text-center">
                    <i class="bi bi-award text-primary fs-1 mb-2"></i>
                    <h3 class="mb-0">@perfData?.TotalSkills</h3>
                    <small class="text-muted">Skills Acquired</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Skills Section -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-tools me-2"></i>My Skills</h5>
                    <a asp-action="Skills" class="btn btn-sm btn-outline-primary">Manage</a>
                </div>
                <div class="card-body">
                    @if (skills != null && skills.Any())
                    {
                        <div class="row">
                            @foreach (var skill in skills)
                            {
                                var badgeColor = skill.ProficiencyLevel switch
                                {
                                    "Expert" => "success",
                                    "Advanced" => "primary",
                                    "Intermediate" => "info",
                                    _ => "secondary"
                                };
                                <div class="col-6 mb-2">
                                    <div class="d-flex justify-content-between align-items-center p-2 bg-light rounded">
                                        <span>@skill.Skill?.SkillName</span>
                                        <span class="badge bg-@badgeColor">@skill.ProficiencyLevel</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-tools fs-1"></i>
                            <p class="mt-2">No skills added yet</p>
                            <a asp-action="Skills" class="btn btn-primary btn-sm">Add Skills</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Manager Notes -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0"><i class="bi bi-chat-square-text me-2"></i>Recent Feedback</h5>
                </div>
                <div class="card-body">
                    @if (notes != null && notes.Any())
                    {
                        @foreach (var note in notes)
                        {
                            <div class="border-start border-3 border-primary ps-3 mb-3">
                                <p class="mb-1">@note.NoteContent</p>
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>@note.Manager?.FullName
                                    <span class="mx-2">·</span>
                                    <i class="bi bi-calendar me-1"></i>@note.CreatedAt?.ToString("MMM dd, yyyy")
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-chat-square-text fs-1"></i>
                            <p class="mt-2">No feedback received yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Missions -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-flag me-2"></i>Recent Missions</h5>
            <a asp-controller="Mission" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
        </div>
        <div class="card-body p-0">
            @if (missions != null && missions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Destination</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mission in missions.Take(5))
                            {
                                var statusColor = mission.Status switch
                                {
                                    "Completed" => "success",
                                    "In Progress" => "info",
                                    "Planned" => "warning",
                                    "Cancelled" => "danger",
                                    _ => "secondary"
                                };
                                <tr>
                                    <td><i class="bi bi-geo-alt me-2 text-primary"></i>@mission.Destination</td>
                                    <td>@mission.StartDate?.ToString("MMM dd, yyyy")</td>
                                    <td>@mission.EndDate?.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-@statusColor">@mission.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-flag fs-1"></i>
                    <p class="mt-2">No missions assigned yet</p>
                </div>
            }
        </div>
    </div>
</div>