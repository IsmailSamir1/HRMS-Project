@model WebApplication1.Models.Mission
@{
    ViewData["Title"] = "Delete Mission";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-trash"></i> Delete Mission
                    </h4>
                    <small>HR Admin - Permanently delete this mission</small>
                </div>
                <div class="card-body">
                    <!-- Warning Message -->
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Warning!</strong> You are about to permanently delete this mission. This action cannot be undone.
                    </div>

                    <!-- Mission Details -->
                    <div class="card mb-4 border-secondary">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Mission Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <strong><i class="bi bi-hash"></i> Mission ID:</strong>
                                    <p class="mb-0 fs-5">@Model.MissionId</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong><i class="bi bi-geo-alt"></i> Destination:</strong>
                                    <p class="mb-0 fs-5">@Model.Destination</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <strong><i class="bi bi-calendar-event"></i> Start Date:</strong>
                                    <p class="mb-0">@Model.StartDate?.ToString("MMMM dd, yyyy")</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong><i class="bi bi-calendar-check"></i> End Date:</strong>
                                    <p class="mb-0">
                                        @if (Model.EndDate.HasValue)
                                        {
                                            @Model.EndDate?.ToString("MMMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <strong><i class="bi bi-flag"></i> Status:</strong>
                                    <p class="mb-0">
                                        @if (Model.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark fs-6">Pending</span>
                                        }
                                        else if (Model.Status == "Approved")
                                        {
                                            <span class="badge bg-success fs-6">Approved</span>
                                        }
                                        else if (Model.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger fs-6">Rejected</span>
                                        }
                                        else if (Model.Status == "Completed")
                                        {
                                            <span class="badge bg-primary fs-6">Completed</span>
                                        }
                                        else if (Model.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary fs-6">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">@Model.Status</span>
                                        }
                                    </p>
                                </div>
                                @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                                {
                                    var duration = Model.EndDate.Value.DayNumber - Model.StartDate.Value.DayNumber;
                                    <div class="col-md-6 mb-3">
                                        <strong><i class="bi bi-clock"></i> Duration:</strong>
                                        <p class="mb-0">@duration day(s)</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Employee Info -->
                    <div class="card mb-4 border-info">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-person"></i> Assigned Employee</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.Employee != null)
                            {
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong><i class="bi bi-person"></i> Name:</strong>
                                        <p class="mb-0 fs-5">@Model.Employee.FullName</p>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong><i class="bi bi-envelope"></i> Email:</strong>
                                        <p class="mb-0">
                                            <a href="mailto:@Model.Employee.Email">@Model.Employee.Email</a>
                                        </p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No employee assigned</p>
                            }
                        </div>
                    </div>

                    <!-- Manager Info -->
                    <div class="card mb-4 border-success">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-person-badge"></i> Approving Manager</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.Manager != null)
                            {
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong><i class="bi bi-person"></i> Name:</strong>
                                        <p class="mb-0 fs-5">@Model.Manager.FullName</p>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong><i class="bi bi-envelope"></i> Email:</strong>
                                        <p class="mb-0">
                                            <a href="mailto:@Model.Manager.Email">@Model.Manager.Email</a>
                                        </p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No manager assigned</p>
                            }
                        </div>
                    </div>

                    <!-- Confirmation -->
                    <div class="alert alert-warning">
                        <i class="bi bi-question-circle"></i>
                        <strong>Are you sure you want to delete this mission?</strong>
                        <p class="mb-0 mt-2">
                            This will permanently remove the mission to <strong>@Model.Destination</strong> assigned to <strong>@Model.Employee?.FullName</strong>.
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <form method="post" asp-action="DeleteConfirm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MissionId" value="@Model.MissionId" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <div>
                                <a asp-action="Edit" asp-route-id="@Model.MissionId" class="btn btn-warning me-2">
                                    <i class="bi bi-pencil"></i> Edit Instead
                                </a>
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <i class="bi bi-trash"></i> Delete Mission
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
```
