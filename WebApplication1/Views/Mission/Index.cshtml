@model List<WebApplication1.Models.Mission>
@{
    ViewData["Title"] = "Missions";
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
    int currentEmployeeId = ViewBag.CurrentEmployeeId ?? 0;
    string viewType = ViewBag.ViewType ?? "Missions";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-geo-alt"></i> @viewType</h2>
            <p class="text-muted mb-0">View and manage mission assignments</p>
        </div>
        <div>
            @if (isHRAdmin)
            {
                <a asp-action="Create" class="btn btn-success me-2">
                    <i class="bi bi-plus-circle"></i> Assign New Mission
                </a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-geo-alt display-4"></i>
                    <h2 class="mt-2 mb-0">@Model.Count</h2>
                    <p class="mb-0">Total Missions</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <i class="bi bi-hourglass-split display-4"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(m => m.Status == "Pending")</h2>
                    <p class="mb-0">Pending</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-4"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(m => m.Status == "Approved")</h2>
                    <p class="mb-0">Approved</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle display-4"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(m => m.Status == "Rejected")</h2>
                    <p class="mb-0">Rejected</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Missions for Line Manager -->
    @if (isLineManager)
    {
        var pendingForApproval = Model.Where(m => m.ManagerId == currentEmployeeId && m.Status == "Pending").ToList();
        if (pendingForApproval.Count > 0)
        {
            <div class="card shadow mb-4 border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Pending Your Approval (@pendingForApproval.Count)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Employee</th>
                                    <th>Destination</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mission in pendingForApproval)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-person me-1"></i>
                                            @mission.Employee?.FullName
                                        </td>
                                        <td>
                                            <i class="bi bi-geo-alt me-1"></i>
                                            @mission.Destination
                                        </td>
                                        <td>@mission.StartDate?.ToString("MMM dd, yyyy")</td>
                                        <td>@mission.EndDate?.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <a asp-action="Approve" asp-route-id="@mission.MissionId" class="btn btn-sm btn-success" title="Approve">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </a>
                                            <a asp-action="Reject" asp-route-id="@mission.MissionId" class="btn btn-sm btn-danger" title="Reject">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    <!-- All Missions Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul"></i> All Missions</h5>
            <span class="badge bg-light text-dark fs-6">@Model.Count missions</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Missions Found</h5>
                    <p class="text-muted">
                        @if (isHRAdmin)
                        {
                            <text>Click "Assign New Mission" to create the first mission.</text>
                        }
                        else
                        {
                            <text>You have no assigned missions.</text>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Employee</th>
                                <th>Destination</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Manager</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mission in Model)
                            {
                                <tr>
                                    <td>@mission.MissionId</td>
                                    <td>
                                        <i class="bi bi-person me-1"></i>
                                        @mission.Employee?.FullName
                                        @if (mission.EmployeeId == currentEmployeeId)
                                        {
                                            <span class="badge bg-info ms-1">You</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-geo-alt me-1"></i>
                                        @mission.Destination
                                    </td>
                                    <td>@mission.StartDate?.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (mission.EndDate.HasValue)
                                        {
                                            @mission.EndDate?.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </td>
                                    <td>
                                        @if (mission.Manager != null)
                                        {
                                            <i class="bi bi-person-badge me-1"></i>
                                            @mission.Manager.FullName
                                            @if (mission.ManagerId == currentEmployeeId)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">You</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Assigned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (mission.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split me-1"></i>Pending
                                            </span>
                                        }
                                        else if (mission.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Approved
                                            </span>
                                        }
                                        else if (mission.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>Rejected
                                            </span>
                                        }
                                        else if (mission.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-flag me-1"></i>Completed
                                            </span>
                                        }
                                        else if (mission.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-slash-circle me-1"></i>Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@mission.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@mission.MissionId" class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @* Line Manager: Approve/Reject buttons for pending missions *@
                                        @if (isLineManager && mission.ManagerId == currentEmployeeId && mission.Status == "Pending")
                                        {
                                            <a asp-action="Approve" asp-route-id="@mission.MissionId" class="btn btn-sm btn-success" title="Approve">
                                                <i class="bi bi-check-lg"></i>
                                            </a>
                                            <a asp-action="Reject" asp-route-id="@mission.MissionId" class="btn btn-sm btn-danger" title="Reject">
                                                <i class="bi bi-x-lg"></i>
                                            </a>
                                        }

                                        @* HR Admin: Edit/Delete buttons *@
                                        @if (isHRAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@mission.MissionId" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@mission.MissionId" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
```

