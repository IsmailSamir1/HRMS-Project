@model WebApplication1.Models.Mission
@{
    ViewData["Title"] = "Mission Details";
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
    int currentEmployeeId = ViewBag.CurrentEmployeeId ?? 0;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-geo-alt"></i> Mission Details</h2>
                    <p class="text-muted mb-0">View complete mission information</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Missions
                    </a>
                </div>
            </div>

            <!-- Mission Status Card -->
            <div class="card shadow mb-4">
                <div class="card-header @(Model.Status == "Approved" ? "bg-success" : Model.Status == "Rejected" ? "bg-danger" : Model.Status == "Pending" ? "bg-warning" : Model.Status == "Completed" ? "bg-primary" : "bg-secondary") text-white">
                    <h5 class="mb-0">
                        @if (Model.Status == "Pending")
                        {
                            <i class="bi bi-hourglass-split"></i>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <i class="bi bi-check-circle"></i>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <i class="bi bi-x-circle"></i>
                        }
                        else if (Model.Status == "Completed")
                        {
                            <i class="bi bi-flag"></i>
                        }
                        else
                        {
                            <i class="bi bi-circle"></i>
                        }
                        Mission #@Model.MissionId - @Model.Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Destination -->
                        <div class="col-md-12 mb-4">
                            <div class="text-center">
                                <i class="bi bi-geo-alt display-1 text-primary"></i>
                                <h3 class="mt-2">@Model.Destination</h3>
                                <p class="text-muted">Mission Destination</p>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <!-- Employee Info -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 border-primary">
                                <div class="card-header bg-primary text-white">
                                    <i class="bi bi-person"></i> Assigned Employee
                                </div>
                                <div class="card-body">
                                    @if (Model.Employee != null)
                                    {
                                        <h5>@Model.Employee.FullName</h5>
                                        <p class="mb-1">
                                            <i class="bi bi-envelope me-1"></i>
                                            <a href="mailto:@Model.Employee.Email">@Model.Employee.Email</a>
                                        </p>
                                        @if (!string.IsNullOrEmpty(Model.Employee.Phone))
                                        {
                                            <p class="mb-0">
                                                <i class="bi bi-telephone me-1"></i>@Model.Employee.Phone
                                            </p>
                                        }
                                        @if (Model.EmployeeId == currentEmployeeId)
                                        {
                                            <span class="badge bg-info mt-2">This is you</span>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">No employee assigned</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Manager Info -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 border-success">
                                <div class="card-header bg-success text-white">
                                    <i class="bi bi-person-badge"></i> Approving Manager
                                </div>
                                <div class="card-body">
                                    @if (Model.Manager != null)
                                    {
                                        <h5>@Model.Manager.FullName</h5>
                                        <p class="mb-1">
                                            <i class="bi bi-envelope me-1"></i>
                                            <a href="mailto:@Model.Manager.Email">@Model.Manager.Email</a>
                                        </p>
                                        @if (!string.IsNullOrEmpty(Model.Manager.Phone))
                                        {
                                            <p class="mb-0">
                                                <i class="bi bi-telephone me-1"></i>@Model.Manager.Phone
                                            </p>
                                        }
                                        @if (Model.ManagerId == currentEmployeeId)
                                        {
                                            <span class="badge bg-warning text-dark mt-2">This is you</span>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">No manager assigned</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Dates -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-event display-4 text-info"></i>
                                    <h5 class="mt-2">Start Date</h5>
                                    <p class="fs-5 mb-0">
                                        @if (Model.StartDate.HasValue)
                                        {
                                            @Model.StartDate?.ToString("MMMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-check display-4 text-info"></i>
                                    <h5 class="mt-2">End Date</h5>
                                    <p class="fs-5 mb-0">
                                        @if (Model.EndDate.HasValue)
                                        {
                                            @Model.EndDate?.ToString("MMMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Set</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Duration -->
                    @if (Model.StartDate.HasValue && Model.EndDate.HasValue)
                    {
                        var duration = Model.EndDate.Value.DayNumber - Model.StartDate.Value.DayNumber;
                        <div class="text-center mt-3">
                            <span class="badge bg-primary fs-5">
                                <i class="bi bi-clock me-1"></i>Duration: @duration day(s)
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Missions
                        </a>

                        <div>
                            @* Line Manager: Approve/Reject buttons for pending missions *@
                            @if (isLineManager && Model.ManagerId == currentEmployeeId && Model.Status == "Pending")
                            {
                                <a asp-action="Approve" asp-route-id="@Model.MissionId" class="btn btn-success me-2">
                                    <i class="bi bi-check-lg"></i> Approve Mission
                                </a>
                                <a asp-action="Reject" asp-route-id="@Model.MissionId" class="btn btn-danger me-2">
                                    <i class="bi bi-x-lg"></i> Reject Mission
                                </a>
                            }

                            @* HR Admin: Edit/Delete buttons *@
                            @if (isHRAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@Model.MissionId" class="btn btn-warning me-2">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@Model.MissionId" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
```

