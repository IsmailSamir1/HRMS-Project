@model List<WebApplication1.Models.Attendance>
@{
    ViewData["Title"] = "Attendance";
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
    int currentEmployeeId = ViewBag.CurrentEmployeeId ?? 0;
    var todayAttendance = ViewBag.TodayAttendance as WebApplication1.Models.Attendance;
    DateTime startDate = ViewBag.StartDate ?? DateTime.Today.AddDays(-30);
    DateTime endDate = ViewBag.EndDate ?? DateTime.Today;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-calendar-check"></i> Attendance Management</h2>
            <p class="text-muted mb-0">Track and manage attendance records</p>
        </div>
        <div>
            @if (isLineManager || isSystemAdmin || isHRAdmin)
            {
                <a asp-action="TeamSummary" class="btn btn-info me-2">
                    <i class="bi bi-people"></i> Team Summary
                </a>
                <a asp-action="CorrectionRequests" class="btn btn-warning me-2">
                    <i class="bi bi-pencil-square"></i> Correction Requests
                </a>
            }
            @if (isSystemAdmin)
            {
                <a asp-action="SyncLeave" class="btn btn-secondary me-2">
                    <i class="bi bi-arrow-repeat"></i> Sync Leave
                </a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Today's Status Card -->
    <div class="card shadow mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-clock"></i> Today's Attendance - @DateTime.Now.ToString("dddd, MMMM dd, yyyy")</h5>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    @if (todayAttendance == null)
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-x-circle display-4 text-danger me-3"></i>
                            <div>
                                <h5 class="mb-1 text-danger">Not Clocked In</h5>
                                <p class="mb-0 text-muted">You haven't clocked in today.</p>
                            </div>
                        </div>
                    }
                    else if (!todayAttendance.ExitTime.HasValue)
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle display-4 text-success me-3"></i>
                            <div>
                                <h5 class="mb-1 text-success">Currently Working</h5>
                                <p class="mb-0">
                                    <strong>Clocked In:</strong> @todayAttendance.EntryTime?.ToString("hh:mm tt")
                                    <br />
                                    <small class="text-muted">Method: @todayAttendance.LoginMethod</small>
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        var hoursWorked = todayAttendance.Duration.HasValue ? todayAttendance.Duration.Value / 60.0 : 0;
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill display-4 text-primary me-3"></i>
                            <div>
                                <h5 class="mb-1 text-primary">Day Complete</h5>
                                <p class="mb-0">
                                    <strong>In:</strong> @todayAttendance.EntryTime?.ToString("hh:mm tt") |
                                    <strong>Out:</strong> @todayAttendance.ExitTime?.ToString("hh:mm tt")
                                    <br />
                                    <span class="badge bg-success">@hoursWorked.ToString("F1") hours worked</span>
                                </p>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-6 text-end">
                    @if (todayAttendance == null)
                    {
                        <a asp-action="ClockIn" class="btn btn-success btn-lg">
                            <i class="bi bi-box-arrow-in-right"></i> Clock In
                        </a>
                    }
                    else if (!todayAttendance.ExitTime.HasValue)
                    {
                        <a asp-action="ClockOut" class="btn btn-danger btn-lg">
                            <i class="bi bi-box-arrow-right"></i> Clock Out
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-primary fs-5 p-3">
                            <i class="bi bi-check-lg"></i> Attendance Complete
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-primary shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-check display-4 text-primary"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.TotalRecords</h2>
                    <p class="text-muted mb-0">Total Records</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-success shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-4 text-success"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.PresentDays</h2>
                    <p class="text-muted mb-0">Present Days</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-warning shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-clock-history display-4 text-warning"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.LateDays</h2>
                    <p class="text-muted mb-0">Late Arrivals</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-danger shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-box-arrow-left display-4 text-danger"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.EarlyDepartures</h2>
                    <p class="text-muted mb-0">Early Departures</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Date Filter -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row align-items-end">
                <div class="col-md-4 mb-2">
                    <label class="form-label"><i class="bi bi-calendar-event"></i> Start Date</label>
                    <input type="date" name="startDate" class="form-control" value="@startDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label"><i class="bi bi-calendar-check"></i> End Date</label>
                    <input type="date" name="endDate" class="form-control" value="@endDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 mb-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <a asp-action="RequestCorrection" class="btn btn-outline-warning w-100 py-3">
                <i class="bi bi-pencil-square display-6"></i>
                <br />
                <strong>Request Correction</strong>
                <br />
                <small>Submit attendance correction</small>
            </a>
        </div>
        <div class="col-md-4 mb-3">
            <a asp-action="MyCorrectionRequests" class="btn btn-outline-info w-100 py-3">
                <i class="bi bi-list-check display-6"></i>
                <br />
                <strong>My Requests</strong>
                <br />
                <small>View correction requests</small>
            </a>
        </div>
        <div class="col-md-4 mb-3">
            <a asp-controller="Shift" asp-action="MyShifts" class="btn btn-outline-secondary w-100 py-3">
                <i class="bi bi-clock display-6"></i>
                <br />
                <strong>My Shifts</strong>
                <br />
                <small>View shift schedule</small>
            </a>
        </div>
    </div>

    <!-- Attendance Records Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-table"></i> Attendance Records</h5>
            <span class="badge bg-light text-dark fs-6">@Model.Count records</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Attendance Records Found</h5>
                    <p class="text-muted">No attendance records found for the selected date range.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Date</th>
                                @if (isSystemAdmin || isHRAdmin || isLineManager)
                                {
                                    <th>Employee</th>
                                }
                                <th>Shift</th>
                                <th>Clock In</th>
                                <th>Clock Out</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model)
                            {
                                var isLate = record.Exception?.Category == "Lateness";
                                var isEarlyDeparture = record.Exception?.Category == "Early Departure";
                                var isOnLeave = record.Exception?.Category == "Leave";
                                var hoursWorked = record.Duration.HasValue ? record.Duration.Value / 60.0 : 0;

                                string rowClass = "";
                                if (isOnLeave) rowClass = "table-info";
                                else if (isLate || isEarlyDeparture) rowClass = "table-warning";

                                <tr class="@rowClass">
                                    <td>
                                        <strong>@record.EntryTime?.ToString("MMM dd, yyyy")</strong>
                                        <br />
                                        <small class="text-muted">@record.EntryTime?.ToString("dddd")</small>
                                    </td>
                                    @if (isSystemAdmin || isHRAdmin || isLineManager)
                                    {
                                        <td>
                                            <i class="bi bi-person me-1"></i>
                                            @(record.Employee?.FullName ?? "Unknown")
                                            @if (record.EmployeeId == currentEmployeeId)
                                            {
                                                <span class="badge bg-info ms-1">You</span>
                                            }
                                        </td>
                                    }
                                    <td>
                                        @if (record.Shift != null)
                                        {
                                            <span class="badge bg-secondary">@record.Shift.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.EntryTime.HasValue)
                                        {
                                            <i class="bi bi-box-arrow-in-right text-success me-1"></i>
                                            @record.EntryTime.Value.ToString("hh:mm tt")
                                            <br />
                                            <small class="text-muted">@record.LoginMethod</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.ExitTime.HasValue)
                                        {
                                            <i class="bi bi-box-arrow-right text-danger me-1"></i>
                                            @record.ExitTime.Value.ToString("hh:mm tt")
                                            <br />
                                            <small class="text-muted">@record.LogoutMethod</small>
                                        }
                                        else if (record.EntryTime.HasValue)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-hourglass-split"></i> In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.Duration.HasValue && record.Duration > 0)
                                        {
                                            <span class="badge bg-primary fs-6">
                                                @hoursWorked.ToString("F1") hrs
                                            </span>
                                        }
                                        else if (record.EntryTime.HasValue && !record.ExitTime.HasValue)
                                        {
                                            var currentDuration = (DateTime.Now - record.EntryTime.Value).TotalHours;
                                            <span class="badge bg-info">
                                                @currentDuration.ToString("F1") hrs (ongoing)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isOnLeave)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-calendar-heart"></i> On Leave
                                            </span>
                                        }
                                        else if (isLate && isEarlyDeparture)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-triangle"></i> Late & Early
                                            </span>
                                        }
                                        else if (isLate)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock-history"></i> Late
                                            </span>
                                        }
                                        else if (isEarlyDeparture)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-box-arrow-left"></i> Early Departure
                                            </span>
                                        }
                                        else if (record.ExitTime.HasValue)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Complete
                                            </span>
                                        }
                                        else if (record.EntryTime.HasValue)
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-play-circle"></i> Working
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unknown</span>
                                        }

                                        @if (record.Exception != null && !isOnLeave)
                                        {
                                            <br />
                                            <small class="text-danger">@record.Exception.Name</small>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@record.AttendanceId" class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Offline attendance support
        const OFFLINE_STORAGE_KEY = 'offline_attendance';

        // Check if online
        function isOnline() {
            return navigator.onLine;
        }

        // Save attendance to localStorage when offline
        function saveOfflineAttendance(type) {
            const records = JSON.parse(localStorage.getItem(OFFLINE_STORAGE_KEY) || '[]');
            const today = new Date().toISOString().split('T')[0];

            let todayRecord = records.find(r => r.date === today);
            if (!todayRecord) {
                todayRecord = { date: today, clockIn: null, clockOut: null };
                records.push(todayRecord);
            }

            if (type === 'in') {
                todayRecord.clockIn = new Date().toISOString();
            } else if (type === 'out') {
                todayRecord.clockOut = new Date().toISOString();
            }

            localStorage.setItem(OFFLINE_STORAGE_KEY, JSON.stringify(records));
            console.log('Saved offline attendance:', todayRecord);
        }

        // Sync offline records when back online
        async function syncOfflineRecords() {
            const records = JSON.parse(localStorage.getItem(OFFLINE_STORAGE_KEY) || '[]');
            if (records.length === 0) return;

            try {
                const response = await fetch('/Attendance/SyncOffline', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(records)
                });

                const result = await response.json();
                if (result.success) {
                    localStorage.removeItem(OFFLINE_STORAGE_KEY);
                    console.log('Synced', result.syncedCount, 'offline records');
                    if (result.syncedCount > 0) {
                        location.reload();
                    }
                }
            } catch (error) {
                console.error('Failed to sync offline records:', error);
            }
        }

        // Listen for online/offline events
        window.addEventListener('online', () => {
            console.log('Back online - syncing...');
            syncOfflineRecords();
        });

        window.addEventListener('offline', () => {
            console.log('Gone offline');
        });

        // Sync on page load if online
        document.addEventListener('DOMContentLoaded', () => {
            if (isOnline()) {
                syncOfflineRecords();
            }
        });
    </script>
}
