@model List<WebApplication1.Controllers.TeamAttendanceSummary>
@{
    ViewData["Title"] = "Team Attendance Summary";
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
    DateTime startDate = ViewBag.StartDate ?? DateTime.Today.AddDays(-30);
    DateTime endDate = ViewBag.EndDate ?? DateTime.Today;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-people"></i> Team Attendance Summary</h2>
            <p class="text-muted mb-0">
                @if (isSystemAdmin || isHRAdmin)
                {
                    <text>Overview of all employees' attendance</text>
                }
                else
                {
                    <text>Overview of your team's attendance</text>
                }
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Attendance
            </a>
        </div>
    </div>

    <!-- Date Filter -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form method="get" asp-action="TeamSummary" class="row align-items-end">
                <div class="col-md-4 mb-2">
                    <label class="form-label"><i class="bi bi-calendar-event"></i> Start Date</label>
                    <input type="date" name="startDate" class="form-control" value="@startDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label"><i class="bi bi-calendar-check"></i> End Date</label>
                    <input type="date" name="endDate" class="form-control" value="@endDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 mb-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i> Generate Report
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Stats -->
    @if (Model != null && Model.Any())
    {
        var totalPresent = Model.Sum(m => m.PresentDays);
        var totalAbsent = Model.Sum(m => m.AbsentDays);
        var totalLate = Model.Sum(m => m.LateDays);
        var totalEarly = Model.Sum(m => m.EarlyDepartures);
        var totalLeave = Model.Sum(m => m.LeaveDays);
        var avgHours = Model.Average(m => m.AverageHoursPerDay);

        <div class="row mb-4">
            <div class="col-md-2 mb-3">
                <div class="card border-primary shadow h-100">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-people display-5 text-primary"></i>
                        <h3 class="mt-2 mb-0">@Model.Count</h3>
                        <small class="text-muted">Team Members</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card border-success shadow h-100">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-check-circle display-5 text-success"></i>
                        <h3 class="mt-2 mb-0">@totalPresent</h3>
                        <small class="text-muted">Present Days</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card border-danger shadow h-100">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-x-circle display-5 text-danger"></i>
                        <h3 class="mt-2 mb-0">@totalAbsent</h3>
                        <small class="text-muted">Absent Days</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card border-warning shadow h-100">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-clock-history display-5 text-warning"></i>
                        <h3 class="mt-2 mb-0">@totalLate</h3>
                        <small class="text-muted">Late Arrivals</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card border-info shadow h-100">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-calendar-heart display-5 text-info"></i>
                        <h3 class="mt-2 mb-0">@totalLeave</h3>
                        <small class="text-muted">Leave Days</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card border-secondary shadow h-100">
                    <div class="card-body text-center py-3">
                        <i class="bi bi-hourglass-split display-5 text-secondary"></i>
                        <h3 class="mt-2 mb-0">@avgHours.ToString("F1")</h3>
                        <small class="text-muted">Avg Hours/Day</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Report Period Info -->
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Report Period:</strong> @startDate.ToString("MMMM dd, yyyy") - @endDate.ToString("MMMM dd, yyyy")
        (@((endDate - startDate).Days + 1) days)
    </div>

    <!-- Team Summary Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-table"></i> Team Attendance Details</h5>
            <span class="badge bg-light text-dark fs-6">@Model.Count members</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Team Members Found</h5>
                    <p class="text-muted">There are no team members to display.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0" id="summaryTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee</th>
                                <th class="text-center">Working Days</th>
                                <th class="text-center">Present</th>
                                <th class="text-center">Absent</th>
                                <th class="text-center">Late</th>
                                <th class="text-center">Early Dep.</th>
                                <th class="text-center">Leave</th>
                                <th class="text-center">Total Hours</th>
                                <th class="text-center">Avg Hours/Day</th>
                                <th class="text-center">Attendance %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.OrderByDescending(m => m.PresentDays))
                            {
                                var attendanceRate = member.TotalDays > 0
                                ? ((double)(member.PresentDays + member.LeaveDays) / member.TotalDays * 100)
                                : 0;

                                string rateClass = attendanceRate >= 90 ? "bg-success" :
                                attendanceRate >= 75 ? "bg-warning text-dark" :
                                "bg-danger";

                                <tr>
                                    <td>
                                        <i class="bi bi-person me-1"></i>
                                        <strong>@member.EmployeeName</strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary fs-6">@member.TotalDays</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success fs-6">@member.PresentDays</span>
                                    </td>
                                    <td class="text-center">
                                        @if (member.AbsentDays > 0)
                                        {
                                            <span class="badge bg-danger fs-6">@member.AbsentDays</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark fs-6">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (member.LateDays > 0)
                                        {
                                            <span class="badge bg-warning text-dark fs-6">@member.LateDays</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark fs-6">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (member.EarlyDepartures > 0)
                                        {
                                            <span class="badge bg-warning text-dark fs-6">@member.EarlyDepartures</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark fs-6">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (member.LeaveDays > 0)
                                        {
                                            <span class="badge bg-info fs-6">@member.LeaveDays</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark fs-6">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <strong>@member.TotalHoursWorked.ToString("F1")</strong>
                                    </td>
                                    <td class="text-center">
                                        <strong>@member.AverageHoursPerDay.ToString("F1")</strong>
                                    </td>
                                    <td class="text-center">
                                        <div class="progress" style="height: 25px; min-width: 100px;">
                                            <div class="progress-bar @rateClass" role="progressbar"
                                                 style="width: @attendanceRate%;"
                                                 aria-valuenow="@attendanceRate" aria-valuemin="0" aria-valuemax="100">
                                                @attendanceRate.ToString("F0")%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Legend -->
    <div class="card shadow mt-4">
        <div class="card-header bg-secondary text-white">
            <h6 class="mb-0"><i class="bi bi-info-circle"></i> Legend & Metrics</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>Attendance Rate:</h6>
                    <ul class="list-unstyled">
                        <li>
                            <span class="badge bg-success me-2">≥ 90%</span> Excellent
                        </li>
                        <li>
                            <span class="badge bg-warning text-dark me-2">75% - 89%</span> Needs Improvement
                        </li>
                        <li>
                            <span class="badge bg-danger me-2">&lt; 75%</span> Critical
                        </li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6>Definitions:</h6>
                    <ul class="list-unstyled small text-muted">
                        <li><strong>Working Days:</strong> Total weekdays in the selected period</li>
                        <li><strong>Present:</strong> Days with recorded clock-in</li>
                        <li><strong>Late:</strong> Clock-in after grace period</li>
                        <li><strong>Early Dep.:</strong> Clock-out before shift end threshold</li>
                        <li><strong>Attendance %:</strong> (Present + Leave) / Working Days</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Options -->
    <div class="card shadow mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <strong><i class="bi bi-download me-2"></i>Export Report:</strong>
                </div>
                <div>
                    <button class="btn btn-outline-success me-2" onclick="printReport()">
                        <i class="bi bi-printer"></i> Print
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Attendance
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function printReport() {
            window.print();
        }

        // Sort table by clicking headers
        document.addEventListener('DOMContentLoaded', function() {
            const table = document.getElementById('summaryTable');
            if (table) {
                const headers = table.querySelectorAll('th');
                headers.forEach((header, index) => {
                    header.style.cursor = 'pointer';
                    header.addEventListener('click', () => sortTable(index));
                });
            }
        });

        let sortDirection = {};

        function sortTable(columnIndex) {
            const table = document.getElementById('summaryTable');
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            sortDirection[columnIndex] = !sortDirection[columnIndex];

            rows.sort((a, b) => {
                let aVal = a.cells[columnIndex].textContent.trim();
                let bVal = b.cells[columnIndex].textContent.trim();

                // Try to parse as number
                const aNum = parseFloat(aVal.replace(/[^0-9.-]/g, ''));
                const bNum = parseFloat(bVal.replace(/[^0-9.-]/g, ''));

                if (!isNaN(aNum) && !isNaN(bNum)) {
                    return sortDirection[columnIndex] ? aNum - bNum : bNum - aNum;
                }

                return sortDirection[columnIndex]
                    ? aVal.localeCompare(bVal)
                    : bVal.localeCompare(aVal);
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
}