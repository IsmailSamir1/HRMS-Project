@model WebApplication1.Models.Attendance
@{
    ViewData["Title"] = "Attendance Details";
    bool isLate = ViewBag.IsLate == true;
    bool isEarlyDeparture = ViewBag.IsEarlyDeparture == true;
    int gracePeriod = ViewBag.GracePeriod ?? 15;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-calendar-check"></i> Attendance Details</h2>
                    <p class="text-muted mb-0">View detailed attendance information</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Attendance
                    </a>
                </div>
            </div>

            <div class="row">
                <!-- Left Column - Main Info -->
                <div class="col-md-6 mb-4">
                    <!-- Employee Card -->
                    <div class="card shadow mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-person"></i> Employee Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(Model.Employee?.ProfileImage))
                                {
                                    <img src="@Model.Employee.ProfileImage" alt="@Model.Employee.FullName"
                                         class="rounded-circle me-3" style="width: 80px; height: 80px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center me-3"
                                         style="width: 80px; height: 80px;">
                                        <span class="text-white fs-3">
                                            @(Model.Employee?.FirstName?.Substring(0, 1).ToUpper())@(Model.Employee?.LastName?.Substring(0, 1).ToUpper())
                                        </span>
                                    </div>
                                }
                                <div>
                                    <h4 class="mb-1">@(Model.Employee?.FullName ?? "Unknown")</h4>
                                    <p class="mb-0 text-muted">@(Model.Employee?.Email ?? "N/A")</p>
                                    @if (Model.Employee?.Department != null)
                                    {
                                        <span class="badge bg-info">@Model.Employee.Department.DepartmentName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Date & Time Card -->
                    <div class="card shadow mb-4">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0"><i class="bi bi-calendar-date"></i> Date & Time</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-12 mb-4">
                                    <i class="bi bi-calendar-event display-4 text-primary"></i>
                                    <h3 class="mt-2 mb-0">@Model.EntryTime?.ToString("dddd")</h3>
                                    <p class="text-muted fs-5">@Model.EntryTime?.ToString("MMMM dd, yyyy")</p>
                                </div>
                            </div>
                            <hr />
                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="card border-success">
                                        <div class="card-body">
                                            <i class="bi bi-box-arrow-in-right display-5 text-success"></i>
                                            <h6 class="mt-2 text-muted">Clock In</h6>
                                            <h4 class="mb-0">
                                                @if (Model.EntryTime.HasValue)
                                                {
                                                    @Model.EntryTime.Value.ToString("hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </h4>
                                            <small class="text-muted">@Model.LoginMethod</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="card border-danger">
                                        <div class="card-body">
                                            <i class="bi bi-box-arrow-right display-5 text-danger"></i>
                                            <h6 class="mt-2 text-muted">Clock Out</h6>
                                            <h4 class="mb-0">
                                                @if (Model.ExitTime.HasValue)
                                                {
                                                    @Model.ExitTime.Value.ToString("hh:mm tt")
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">In Progress</span>
                                                }
                                            </h4>
                                            @if (Model.ExitTime.HasValue)
                                            {
                                                <small class="text-muted">@Model.LogoutMethod</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Status & Details -->
                <div class="col-md-6 mb-4">
                    <!-- Duration Card -->
                    <div class="card shadow mb-4 border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-hourglass-split"></i> Duration</h5>
                        </div>
                        <div class="card-body text-center">
                            @{
                                var hoursWorked = Model.Duration.HasValue ? Model.Duration.Value / 60.0 : 0;
                            }
                            <h1 class="display-3 text-primary mb-0">@hoursWorked.ToString("F1")</h1>
                            <p class="text-muted fs-5">Hours Worked</p>

                            @if (Model.Duration.HasValue)
                            {
                                var hours = Model.Duration.Value / 60;
                                var minutes = Model.Duration.Value % 60;
                                <p class="mb-0">
                                    <span class="badge bg-info fs-6">@hours hours @minutes minutes</span>
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Status Card -->
                    <div class="card shadow mb-4">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="bi bi-flag"></i> Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                @if (Model.Exception?.Category == "Leave")
                                {
                                    <div class="col-12 mb-3">
                                        <span class="badge bg-info fs-5 px-4 py-2">
                                            <i class="bi bi-calendar-heart me-1"></i> On Leave
                                        </span>
                                        <p class="mt-2 mb-0 text-muted">@Model.Exception.Name</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-6 mb-3">
                                        <div class="card @(isLate ? "border-warning bg-warning bg-opacity-10" : "border-success bg-success bg-opacity-10")">
                                            <div class="card-body py-3">
                                                @if (isLate)
                                                {
                                                    <i class="bi bi-clock-history display-6 text-warning"></i>
                                                    <p class="mb-0 mt-2"><strong class="text-warning">Late Arrival</strong></p>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle display-6 text-success"></i>
                                                    <p class="mb-0 mt-2"><strong class="text-success">On Time</strong></p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <div class="card @(isEarlyDeparture ? "border-warning bg-warning bg-opacity-10" : "border-success bg-success bg-opacity-10")">
                                            <div class="card-body py-3">
                                                @if (isEarlyDeparture)
                                                {
                                                    <i class="bi bi-box-arrow-left display-6 text-warning"></i>
                                                    <p class="mb-0 mt-2"><strong class="text-warning">Early Departure</strong></p>
                                                }
                                                else if (Model.ExitTime.HasValue)
                                                {
                                                    <i class="bi bi-check-circle display-6 text-success"></i>
                                                    <p class="mb-0 mt-2"><strong class="text-success">Full Shift</strong></p>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-hourglass-split display-6 text-primary"></i>
                                                    <p class="mb-0 mt-2"><strong class="text-primary">Still Working</strong></p>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (Model.Exception != null && Model.Exception.Category != "Leave")
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    <strong>Exception:</strong> @Model.Exception.Name
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Shift Info Card -->
                    @if (Model.Shift != null)
                    {
                        <div class="card shadow mb-4 border-info">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0"><i class="bi bi-clock"></i> Assigned Shift</h5>
                            </div>
                            <div class="card-body">
                                <h5 class="mb-3">@Model.Shift.Name</h5>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <p class="mb-0 text-muted">Start</p>
                                        <strong>@Model.Shift.StartTime?.ToString("hh:mm tt")</strong>
                                    </div>
                                    <div class="col-4">
                                        <p class="mb-0 text-muted">End</p>
                                        <strong>@Model.Shift.EndTime?.ToString("hh:mm tt")</strong>
                                    </div>
                                    <div class="col-4">
                                        <p class="mb-0 text-muted">Break</p>
                                        <strong>@(Model.Shift.BreakDuration ?? 0) min</strong>
                                    </div>
                                </div>
                                <hr />
                                <p class="mb-0 text-center">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Grace Period: @gracePeriod minutes
                                    </small>
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Attendance Logs -->
            @if (Model.AttendanceLogs != null && Model.AttendanceLogs.Any())
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-list-ul"></i> Activity Log</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Action</th>
                                        <th>Actor ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.AttendanceLogs.OrderByDescending(l => l.Timestamp))
                                    {
                                        <tr>
                                            <td>
                                                <i class="bi bi-clock me-1"></i>
                                                @log.Timestamp?.ToString("MMM dd, yyyy hh:mm tt")
                                            </td>
                                            <td>@log.Reason</td>
                                            <td>@log.Actor</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="card shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Attendance
                        </a>
                        <div>
                            <a asp-action="RequestCorrection" class="btn btn-warning">
                                <i class="bi bi-pencil-square"></i> Request Correction
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
