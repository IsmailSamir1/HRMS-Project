@{
    ViewData["Title"] = "Sync Leave with Attendance";
    var approvedLeaves = ViewBag.ApprovedLeaves as List<WebApplication1.Models.LeaveRequest>;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-arrow-repeat"></i> Sync Leave with Attendance</h2>
                    <p class="text-muted mb-0">System Admin - Synchronize approved leave records with attendance system</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Attendance
                    </a>
                </div>
            </div>

            <!-- Info Card -->
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <strong>What does this do?</strong>
                <p class="mb-0 mt-2">
                    This function creates attendance records for employees who have approved leave.
                    It ensures that leave days are properly reflected in the attendance system,
                    preventing them from being marked as absent.
                </p>
            </div>

            <!-- Sync Form -->
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-range"></i> Select Date Range to Sync</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="SyncLeave">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label class="form-label">
                                    <i class="bi bi-calendar-event"></i> Start Date <span class="text-danger">*</span>
                                </label>
                                <input type="date" name="StartDate" class="form-control" required
                                       value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")" />
                                <small class="text-muted">Sync leave records starting from this date</small>
                            </div>
                            <div class="col-md-5 mb-3">
                                <label class="form-label">
                                    <i class="bi bi-calendar-check"></i> End Date <span class="text-danger">*</span>
                                </label>
                                <input type="date" name="EndDate" class="form-control" required
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <small class="text-muted">Sync leave records up to this date</small>
                            </div>
                            <div class="col-md-2 mb-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="bi bi-arrow-repeat"></i> Sync Now
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Warning -->
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Important Notes:</strong>
                <ul class="mb-0 mt-2">
                    <li>Only <strong>approved</strong> leave requests will be synced</li>
                    <li>Existing attendance records will <strong>not</strong> be overwritten</li>
                    <li>Each leave day will create a separate attendance entry marked as "Leave"</li>
                    <li>This process may take a few moments depending on the number of records</li>
                </ul>
            </div>

            <!-- Approved Leaves Reference -->
            <div class="card shadow">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-calendar-heart"></i> Recent Approved Leave Requests</h5>
                    <span class="badge bg-light text-success fs-6">
                        @(approvedLeaves?.Count ?? 0) requests
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (approvedLeaves == null || approvedLeaves.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">No Approved Leave Requests</h5>
                            <p class="text-muted">There are no approved leave requests to sync.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Employee</th>
                                        <th>Leave Type</th>
                                        <th>Duration</th>
                                        <th>Approval Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var leave in approvedLeaves)
                                    {
                                        <tr>
                                            <td>
                                                <i class="bi bi-person me-1"></i>
                                                <strong>@(leave.Employee?.FullName ?? "Unknown")</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @(leave.Leave?.LeaveType ?? "Leave")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">
                                                    @leave.Duration day(s)
                                                </span>
                                            </td>
                                            <td>
                                                @if (leave.ApprovalTiming.HasValue)
                                                {
                                                    @leave.ApprovalTiming.Value.ToString("MMM dd, yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> Approved
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Process Explanation -->
            <div class="card shadow mt-4">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0"><i class="bi bi-question-circle"></i> How Sync Works</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center mb-3">
                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 60px; height: 60px;">
                                <span class="text-white fs-4">1</span>
                            </div>
                            <h6 class="mt-2">Find Leaves</h6>
                            <small class="text-muted">System finds all approved leave requests in date range</small>
                        </div>
                        <div class="col-md-3 text-center mb-3">
                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 60px; height: 60px;">
                                <span class="text-white fs-4">2</span>
                            </div>
                            <h6 class="mt-2">Check Records</h6>
                            <small class="text-muted">Checks if attendance already exists for each day</small>
                        </div>
                        <div class="col-md-3 text-center mb-3">
                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 60px; height: 60px;">
                                <span class="text-white fs-4">3</span>
                            </div>
                            <h6 class="mt-2">Create Exception</h6>
                            <small class="text-muted">Creates a "Leave" exception for each day</small>
                        </div>
                        <div class="col-md-3 text-center mb-3">
                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 60px; height: 60px;">
                                <span class="text-white fs-4">4</span>
                            </div>
                            <h6 class="mt-2">Create Attendance</h6>
                            <small class="text-muted">Creates attendance record marked as leave</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow mt-4">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4 mb-2">
                            <a asp-action="Index" class="btn btn-outline-primary w-100">
                                <i class="bi bi-calendar-check"></i> View Attendance
                            </a>
                        </div>
                        <div class="col-md-4 mb-2">
                            <a asp-action="TeamSummary" class="btn btn-outline-info w-100">
                                <i class="bi bi-people"></i> Team Summary
                            </a>
                        </div>
                        <div class="col-md-4 mb-2">
                            <a asp-action="CorrectionRequests" class="btn btn-outline-warning w-100">
                                <i class="bi bi-pencil-square"></i> Correction Requests
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
