@{
    ViewData["Title"] = "Clock Out";
    var attendance = ViewBag.Attendance as WebApplication1.Models.Attendance;
    var clockInTime = ViewBag.ClockInTime as DateTime?;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-box-arrow-right"></i> Clock Out
                    </h4>
                    <small>Record your departure time</small>
                </div>
                <div class="card-body">
                    <!-- Current Time Display -->
                    <div class="text-center mb-4">
                        <div class="display-1 text-danger" id="currentTime">
                            @DateTime.Now.ToString("hh:mm:ss tt")
                        </div>
                        <p class="text-muted fs-5">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
                    </div>

                    <!-- Today's Session Info -->
                    <div class="card mb-4 border-success">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0"><i class="bi bi-clock-history"></i> Today's Session</h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-4">
                                    <i class="bi bi-box-arrow-in-right display-6 text-success"></i>
                                    <p class="mb-0 mt-2"><strong>Clock In</strong></p>
                                    <p class="mb-0 fs-5">
                                        @if (clockInTime.HasValue)
                                        {
                                            @clockInTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </p>
                                </div>
                                <div class="col-4">
                                    <i class="bi bi-hourglass-split display-6 text-primary"></i>
                                    <p class="mb-0 mt-2"><strong>Duration</strong></p>
                                    <p class="mb-0 fs-5" id="currentDuration">
                                        @if (clockInTime.HasValue)
                                        {
                                            var duration = DateTime.Now - clockInTime.Value;
                                            @($"{(int)duration.TotalHours}h {duration.Minutes}m")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </p>
                                </div>
                                <div class="col-4">
                                    <i class="bi bi-clock display-6 text-info"></i>
                                    <p class="mb-0 mt-2"><strong>Shift</strong></p>
                                    <p class="mb-0">
                                        @if (attendance?.Shift != null)
                                        {
                                            @attendance.Shift.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            @if (attendance?.Shift?.EndTime.HasValue == true)
                            {
                                var shiftEnd = DateTime.Today.Add(attendance.Shift.EndTime.Value.ToTimeSpan());
                                var timeDiff = shiftEnd - DateTime.Now;

                                @if (timeDiff.TotalMinutes > 30)
                                {
                                    <div class="alert alert-warning mt-3 mb-0">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        <strong>Early Departure:</strong> Your shift ends at @attendance.Shift.EndTime.Value.ToString("hh:mm tt").
                                        Leaving now will be recorded as an early departure (@((int)timeDiff.TotalMinutes) minutes early).
                                    </div>
                                }
                                else if (timeDiff.TotalMinutes > 0)
                                {
                                    <div class="alert alert-info mt-3 mb-0">
                                        <i class="bi bi-info-circle"></i>
                                        Your shift ends in @((int)timeDiff.TotalMinutes) minutes.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success mt-3 mb-0">
                                        <i class="bi bi-check-circle"></i>
                                        Your shift has ended. Thank you for your work today!
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Login Method Info -->
                    @if (attendance != null)
                    {
                        <div class="alert alert-light mb-4">
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i>
                                Clocked in via: <strong>@attendance.LoginMethod</strong>
                            </small>
                        </div>
                    }

                    <form method="post" asp-action="ClockOut" id="clockOutForm">
                        @Html.AntiForgeryToken()

                        <!-- Logout Method -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-phone"></i> Logout Method
                            </label>
                            <select name="LogoutMethod" class="form-select" required>
                                <option value="Web">Web Browser</option>
                                <option value="Mobile">Mobile App</option>
                                <option value="Biometric">Biometric</option>
                                <option value="Card">ID Card</option>
                                <option value="Manual">Manual Entry</option>
                            </select>
                        </div>

                        <!-- Notes (Optional) -->
                        <div class="mb-4">
                            <label class="form-label">
                                <i class="bi bi-sticky"></i> Notes (Optional)
                            </label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="Any notes about your departure..."></textarea>
                        </div>

                        <!-- Work Summary -->
                        @if (clockInTime.HasValue)
                        {
                            var totalDuration = DateTime.Now - clockInTime.Value;
                            <div class="card mb-4 border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="bi bi-bar-chart"></i> Work Summary</h6>
                                </div>
                                <div class="card-body text-center">
                                    <h2 class="text-primary mb-0" id="totalHours">
                                        @totalDuration.TotalHours.ToString("F1")
                                    </h2>
                                    <p class="text-muted mb-0">Total Hours Worked Today</p>
                                </div>
                            </div>
                        }

                        <!-- Confirmation -->
                        <div class="alert alert-danger">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="confirmCheck" required>
                                <label class="form-check-label" for="confirmCheck">
                                    I confirm that I am clocking out at <strong id="confirmTime">@DateTime.Now.ToString("hh:mm tt")</strong>
                                </label>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-box-arrow-right"></i> Clock Out Now
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Offline Support Notice -->
            <div class="card mt-3 border-warning" id="offlineNotice" style="display: none;">
                <div class="card-body text-center">
                    <i class="bi bi-wifi-off text-warning display-4"></i>
                    <h5 class="mt-2">You're Offline</h5>
                    <p class="text-muted mb-0">Your clock-out will be saved locally and synced when you're back online.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Clock in time for duration calculation
        const clockInTime = new Date('@(clockInTime?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")');

        // Update current time and duration every second
        function updateTime() {
            const now = new Date();

            // Update current time
            const timeString = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: true
            });
            document.getElementById('currentTime').textContent = timeString;

            // Update confirm time
            const confirmTimeString = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            });
            document.getElementById('confirmTime').textContent = confirmTimeString;

            // Update duration
            if (clockInTime && !isNaN(clockInTime.getTime())) {
                const durationMs = now - clockInTime;
                const hours = Math.floor(durationMs / (1000 * 60 * 60));
                const minutes = Math.floor((durationMs % (1000 * 60 * 60)) / (1000 * 60));

                const durationElement = document.getElementById('currentDuration');
                if (durationElement) {
                    durationElement.textContent = `${hours}h ${minutes}m`;
                }

                const totalHoursElement = document.getElementById('totalHours');
                if (totalHoursElement) {
                    totalHoursElement.textContent = (durationMs / (1000 * 60 * 60)).toFixed(1);
                }
            }
        }

        setInterval(updateTime, 1000);

        // Check online status
        function checkOnlineStatus() {
            const offlineNotice = document.getElementById('offlineNotice');
            if (!navigator.onLine) {
                offlineNotice.style.display = 'block';
            } else {
                offlineNotice.style.display = 'none';
            }
        }

        window.addEventListener('online', checkOnlineStatus);
        window.addEventListener('offline', checkOnlineStatus);
        checkOnlineStatus();

        // Handle offline clock-out
        document.getElementById('clockOutForm').addEventListener('submit', function(e) {
            if (!navigator.onLine) {
                e.preventDefault();

                // Save to localStorage
                const records = JSON.parse(localStorage.getItem('offline_attendance') || '[]');
                const today = new Date().toISOString().split('T')[0];

                let todayRecord = records.find(r => r.date === today);
                if (!todayRecord) {
                    todayRecord = { date: today, clockIn: null, clockOut: null };
                    records.push(todayRecord);
                }

                todayRecord.clockOut = new Date().toISOString();
                localStorage.setItem('offline_attendance', JSON.stringify(records));

                alert('You are offline. Your clock-out has been saved locally and will sync when you reconnect.');
                window.location.href = '/Attendance';
            }
        });
    </script>
}
