@{
    ViewData["Title"] = "Clock In";
    var currentShift = ViewBag.CurrentShift as WebApplication1.Models.ShiftSchedule;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-box-arrow-in-right"></i> Clock In
                    </h4>
                    <small>Record your arrival time</small>
                </div>
                <div class="card-body">
                    <!-- Current Time Display -->
                    <div class="text-center mb-4">
                        <div class="display-1 text-success" id="currentTime">
                            @DateTime.Now.ToString("hh:mm:ss tt")
                        </div>
                        <p class="text-muted fs-5">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
                    </div>

                    <!-- Shift Info -->
                    @if (currentShift != null)
                    {
                        <div class="card mb-4 border-info">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-clock"></i> Your Scheduled Shift</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4">
                                        <i class="bi bi-tag display-6 text-primary"></i>
                                        <p class="mb-0 mt-2"><strong>Shift</strong></p>
                                        <p class="mb-0">@currentShift.Name</p>
                                    </div>
                                    <div class="col-4">
                                        <i class="bi bi-sunrise display-6 text-success"></i>
                                        <p class="mb-0 mt-2"><strong>Start</strong></p>
                                        <p class="mb-0">
                                            @if (currentShift.StartTime.HasValue)
                                            {
                                                @currentShift.StartTime.Value.ToString("hh:mm tt")
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="col-4">
                                        <i class="bi bi-sunset display-6 text-danger"></i>
                                        <p class="mb-0 mt-2"><strong>End</strong></p>
                                        <p class="mb-0">
                                            @if (currentShift.EndTime.HasValue)
                                            {
                                                @currentShift.EndTime.Value.ToString("hh:mm tt")
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </p>
                                    </div>
                                </div>

                                @if (currentShift.StartTime.HasValue)
                                {
                                    var shiftStart = DateTime.Today.Add(currentShift.StartTime.Value.ToTimeSpan());
                                    var timeDiff = DateTime.Now - shiftStart;

                                    @if (timeDiff.TotalMinutes > 15)
                                    {
                                        <div class="alert alert-warning mt-3 mb-0">
                                            <i class="bi bi-exclamation-triangle"></i>
                                            <strong>Late Arrival:</strong> You are @((int)timeDiff.TotalMinutes) minutes late.
                                            This will be recorded as a late arrival.
                                        </div>
                                    }
                                    else if (timeDiff.TotalMinutes > 0)
                                    {
                                        <div class="alert alert-info mt-3 mb-0">
                                            <i class="bi bi-info-circle"></i>
                                            You are within the grace period (@((int)timeDiff.TotalMinutes) minutes after shift start).
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-success mt-3 mb-0">
                                            <i class="bi bi-check-circle"></i>
                                            You are on time! Shift starts in @((int)Math.Abs(timeDiff.TotalMinutes)) minutes.
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle"></i>
                            No shift currently assigned. Your attendance will still be recorded.
                        </div>
                    }

                    <form method="post" asp-action="ClockIn" id="clockInForm">
                        @Html.AntiForgeryToken()

                        <!-- Login Method -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-phone"></i> Login Method
                            </label>
                            <select name="LoginMethod" class="form-select" required>
                                <option value="Web">Web Browser</option>
                                <option value="Mobile">Mobile App</option>
                                <option value="Biometric">Biometric</option>
                                <option value="Card">ID Card</option>
                                <option value="Manual">Manual Entry</option>
                            </select>
                        </div>

                        <!-- Notes (Optional) -->
                        <div class="mb-4">
                            <label class="form-label">
                                <i class="bi bi-sticky"></i> Notes (Optional)
                            </label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="Any notes about your arrival..."></textarea>
                        </div>

                        <!-- Confirmation -->
                        <div class="alert alert-success">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="confirmCheck" required>
                                <label class="form-check-label" for="confirmCheck">
                                    I confirm that I am clocking in at <strong id="confirmTime">@DateTime.Now.ToString("hh:mm tt")</strong>
                                </label>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i> Clock In Now
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Offline Support Notice -->
            <div class="card mt-3 border-warning" id="offlineNotice" style="display: none;">
                <div class="card-body text-center">
                    <i class="bi bi-wifi-off text-warning display-4"></i>
                    <h5 class="mt-2">You're Offline</h5>
                    <p class="text-muted mb-0">Your clock-in will be saved locally and synced when you're back online.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update current time every second
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: true
            });
            document.getElementById('currentTime').textContent = timeString;

            const confirmTimeString = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            });
            document.getElementById('confirmTime').textContent = confirmTimeString;
        }

        setInterval(updateTime, 1000);

        // Check online status
        function checkOnlineStatus() {
            const offlineNotice = document.getElementById('offlineNotice');
            if (!navigator.onLine) {
                offlineNotice.style.display = 'block';
            } else {
                offlineNotice.style.display = 'none';
            }
        }

        window.addEventListener('online', checkOnlineStatus);
        window.addEventListener('offline', checkOnlineStatus);
        checkOnlineStatus();

        // Handle offline clock-in
        document.getElementById('clockInForm').addEventListener('submit', function(e) {
            if (!navigator.onLine) {
                e.preventDefault();

                // Save to localStorage
                const records = JSON.parse(localStorage.getItem('offline_attendance') || '[]');
                const today = new Date().toISOString().split('T')[0];

                let todayRecord = records.find(r => r.date === today);
                if (!todayRecord) {
                    todayRecord = { date: today, clockIn: null, clockOut: null };
                    records.push(todayRecord);
                }

                todayRecord.clockIn = new Date().toISOString();
                localStorage.setItem('offline_attendance', JSON.stringify(records));

                alert('You are offline. Your clock-in has been saved locally and will sync when you reconnect.');
                window.location.href = '/Attendance';
            }
        });
    </script>
}