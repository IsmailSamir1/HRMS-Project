@model List<WebApplication1.Models.ShiftSchedule>
@{
    ViewData["Title"] = "Configure Split Shifts";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-arrows-expand"></i> Configure Split Shifts</h2>
            <p class="text-muted mb-0">HR Admin - Manage split shift schedules</p>
        </div>
        <div>
            <a asp-action="CreateSplit" class="btn btn-success me-2">
                <i class="bi bi-plus-circle"></i> Create Split Shift
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Shifts
            </a>
        </div>
    </div>

    <!-- Info Card -->
    <div class="card shadow mb-4 border-info">
        <div class="card-header bg-info text-white">
            <h6 class="mb-0"><i class="bi bi-info-circle"></i> What are Split Shifts?</h6>
        </div>
        <div class="card-body">
            <p class="mb-0">
                <strong>Split shifts</strong> divide the workday into two or more separate periods with a significant break in between.
                For example, an employee might work from <strong>8:00 AM - 12:00 PM</strong>, take a long break, then return to work from <strong>4:00 PM - 8:00 PM</strong>.
                This is common in hospitality, healthcare, and retail industries.
            </p>
        </div>
    </div>

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card border-info shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-arrows-expand display-4 text-info"></i>
                    <h2 class="mt-2 mb-0">@Model.Count</h2>
                    <p class="text-muted mb-0">Total Split Shifts</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-success shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-4 text-success"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(s => s.Status == "Active")</h2>
                    <p class="text-muted mb-0">Active</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-secondary shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle display-4 text-secondary"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(s => s.Status != "Active")</h2>
                    <p class="text-muted mb-0">Inactive</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Split Shifts Table -->
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul"></i> Split Shifts</h5>
            <span class="badge bg-light text-info fs-6">@Model.Count shifts</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-arrows-expand display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Split Shifts Found</h5>
                    <p class="text-muted">Click "Create Split Shift" to add the first split shift.</p>
                    <a asp-action="CreateSplit" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Create Split Shift
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Break Duration</th>
                                <th>Status</th>
                                <th>Assigned</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shift in Model)
                            {
                                <tr>
                                    <td>@shift.ShiftId</td>
                                    <td>
                                        <i class="bi bi-arrows-expand text-info me-1"></i>
                                        <strong>@shift.Name</strong>
                                    </td>
                                    <td>
                                        @if (shift.StartTime.HasValue)
                                        {
                                            <i class="bi bi-sunrise text-success me-1"></i>
                                            @shift.StartTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (shift.EndTime.HasValue)
                                        {
                                            <i class="bi bi-sunset text-danger me-1"></i>
                                            @shift.EndTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (shift.BreakDuration.HasValue && shift.BreakDuration > 0)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-cup-hot me-1"></i>@shift.BreakDuration min
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (shift.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@shift.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">
                                            @shift.ShiftAssignments.Count employees
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@shift.ShiftId" class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@shift.ShiftId" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Assign" class="btn btn-sm btn-success" title="Assign">
                                            <i class="bi bi-person-plus"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Quick Links -->
    <div class="card shadow mt-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3">
                    <a asp-action="Index" class="btn btn-outline-primary w-100">
                        <i class="bi bi-clock"></i> All Shifts
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-action="ConfigureRotational" class="btn btn-outline-warning w-100">
                        <i class="bi bi-arrow-repeat"></i> Rotational Shifts
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-action="Assignments" class="btn btn-outline-success w-100">
                        <i class="bi bi-person-check"></i> Assignments
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-action="CreateSplit" class="btn btn-outline-info w-100">
                        <i class="bi bi-plus-circle"></i> New Split Shift
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>