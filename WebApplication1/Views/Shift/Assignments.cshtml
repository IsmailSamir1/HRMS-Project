@model List<WebApplication1.Models.ShiftAssignment>
@{
    ViewData["Title"] = "Shift Assignments";
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
    int currentEmployeeId = ViewBag.CurrentEmployeeId ?? 0;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-person-check"></i> Shift Assignments</h2>
            <p class="text-muted mb-0">View and manage employee shift assignments</p>
        </div>
        <div>
            @if (isSystemAdmin || isLineManager)
            {
                <a asp-action="Assign" class="btn btn-success me-2">
                    <i class="bi bi-person-plus"></i> Assign to Employee
                </a>
                <a asp-action="AssignDepartment" class="btn btn-primary me-2">
                    <i class="bi bi-building"></i> Assign to Department
                </a>
            }
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Shifts
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-primary shadow">
                <div class="card-body text-center">
                    <i class="bi bi-people display-4 text-primary"></i>
                    <h2 class="mt-2 mb-0">@Model.Count</h2>
                    <p class="text-muted mb-0">Total Assignments</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-success shadow">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-4 text-success"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(a => a.Status == "Active")</h2>
                    <p class="text-muted mb-0">Active</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-warning shadow">
                <div class="card-body text-center">
                    <i class="bi bi-hourglass-split display-4 text-warning"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(a => a.EndDate.HasValue && a.EndDate.Value < DateOnly.FromDateTime(DateTime.Now))</h2>
                    <p class="text-muted mb-0">Expired</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-info shadow">
                <div class="card-body text-center">
                    <i class="bi bi-infinity display-4 text-info"></i>
                    <h2 class="mt-2 mb-0">@Model.Count(a => !a.EndDate.HasValue)</h2>
                    <p class="text-muted mb-0">Ongoing</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter by Status -->
    <div class="card shadow mb-4">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <strong><i class="bi bi-funnel"></i> Quick Filters:</strong>
                    <div class="btn-group ms-2" role="group">
                        <button type="button" class="btn btn-sm btn-outline-primary filter-btn active" data-filter="all">All</button>
                        <button type="button" class="btn btn-sm btn-outline-success filter-btn" data-filter="Active">Active</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary filter-btn" data-filter="Inactive">Inactive</button>
                        <button type="button" class="btn btn-sm btn-outline-info filter-btn" data-filter="ongoing">Ongoing</button>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <input type="text" id="searchInput" class="form-control form-control-sm d-inline-block" style="width: 250px;" placeholder="Search by employee or shift name..." />
                </div>
            </div>
        </div>
    </div>

    <!-- Assignments Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul"></i> All Assignments</h5>
            <span class="badge bg-light text-dark fs-6">@Model.Count assignments</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Shift Assignments Found</h5>
                    <p class="text-muted">
                        @if (isSystemAdmin || isLineManager)
                        {
                            <text>Click "Assign to Employee" or "Assign to Department" to create the first assignment.</text>
                        }
                        else
                        {
                            <text>You have no shift assignments.</text>
                        }
                    </p>
                    @if (isSystemAdmin || isLineManager)
                    {
                        <a asp-action="Assign" class="btn btn-success">
                            <i class="bi bi-person-plus"></i> Assign Shift
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0" id="assignmentsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Employee</th>
                                <th>Shift</th>
                                <th>Type</th>
                                <th>Time</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model)
                            {
                                bool isExpired = assignment.EndDate.HasValue && assignment.EndDate.Value < DateOnly.FromDateTime(DateTime.Now);
                                bool isOngoing = !assignment.EndDate.HasValue;
                                string rowClass = isExpired ? "table-warning" : "";

                                <tr class="assignment-row @rowClass"
                                    data-status="@assignment.Status"
                                    data-ongoing="@(isOngoing ? "ongoing" : "")">
                                    <td>@assignment.AssignmentId</td>
                                    <td>
                                        <i class="bi bi-person me-1"></i>
                                        <strong>@(assignment.Employee?.FullName ?? "Unknown")</strong>
                                        @if (assignment.EmployeeId == currentEmployeeId)
                                        {
                                            <span class="badge bg-info ms-1">You</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-clock me-1"></i>
                                        @(assignment.Shift?.Name ?? "Unknown")
                                    </td>
                                    <td>
                                        @if (assignment.Shift?.Type == "Normal")
                                        {
                                            <span class="badge bg-primary">Normal</span>
                                        }
                                        else if (assignment.Shift?.Type == "Split")
                                        {
                                            <span class="badge bg-info">Split</span>
                                        }
                                        else if (assignment.Shift?.Type == "Rotational")
                                        {
                                            <span class="badge bg-warning text-dark">Rotational</span>
                                        }
                                        else if (assignment.Shift?.Type == "Custom")
                                        {
                                            <span class="badge bg-secondary">Custom</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@(assignment.Shift?.Type ?? "-")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment.Shift?.StartTime.HasValue == true && assignment.Shift?.EndTime.HasValue == true)
                                        {
                                            <small>
                                                <i class="bi bi-sunrise text-success"></i>
                                                @assignment.Shift.StartTime.Value.ToString("hh:mm tt")
                                                <i class="bi bi-arrow-right mx-1"></i>
                                                <i class="bi bi-sunset text-danger"></i>
                                                @assignment.Shift.EndTime.Value.ToString("hh:mm tt")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment.StartDate.HasValue)
                                        {
                                            @assignment.StartDate.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment.EndDate.HasValue)
                                        {
                                            <span class="@(isExpired ? "text-danger fw-bold" : "")">
                                                @assignment.EndDate.Value.ToString("MMM dd, yyyy")
                                                @if (isExpired)
                                                {
                                                    <i class="bi bi-exclamation-circle text-danger ms-1" title="Expired"></i>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-infinity"></i> Ongoing
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (assignment.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Active
                                            </span>
                                        }
                                        else if (assignment.Status == "Inactive")
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-x-circle"></i> Inactive
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@assignment.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isSystemAdmin)
                                        {
                                            <a asp-action="EditAssignment" asp-route-id="@assignment.AssignmentId" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                        @if (isSystemAdmin || isLineManager)
                                        {
                                            <a asp-action="DeleteAssignment" asp-route-id="@assignment.AssignmentId" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Quick Links -->
    <div class="card shadow mt-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3">
                    <a asp-action="Index" class="btn btn-outline-primary w-100">
                        <i class="bi bi-clock"></i> View All Shifts
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-action="MyShifts" class="btn btn-outline-info w-100">
                        <i class="bi bi-calendar-check"></i> My Shifts
                    </a>
                </div>
                @if (isSystemAdmin || isLineManager)
                {
                    <div class="col-md-3">
                        <a asp-action="Assign" class="btn btn-outline-success w-100">
                            <i class="bi bi-person-plus"></i> Assign to Employee
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="AssignDepartment" class="btn btn-outline-warning w-100">
                            <i class="bi bi-building"></i> Assign to Department
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-md-6">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-house"></i> Back to Dashboard
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Filter buttons
            const filterBtns = document.querySelectorAll('.filter-btn');
            const rows = document.querySelectorAll('.assignment-row');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    // Update active button
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const filter = this.getAttribute('data-filter');

                    rows.forEach(row => {
                        const status = row.getAttribute('data-status');
                        const ongoing = row.getAttribute('data-ongoing');

                        if (filter === 'all') {
                            row.style.display = '';
                        } else if (filter === 'ongoing') {
                            row.style.display = ongoing === 'ongoing' ? '' : 'none';
                        } else {
                            row.style.display = status === filter ? '' : 'none';
                        }
                    });
                });
            });

            // Search functionality
            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('keyup', function() {
                const searchTerm = this.value.toLowerCase();

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchTerm) ? '' : 'none';
                });

                // Reset filter buttons
                filterBtns.forEach(b => b.classList.remove('active'));
                document.querySelector('[data-filter="all"]').classList.add('active');
            });
        });
    </script>
}
