@model WebApplication1.Models.ShiftAssignment
@{
    ViewData["Title"] = "Delete Shift Assignment";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-trash"></i> Delete Shift Assignment
                    </h4>
                    <small>Permanently remove this shift assignment</small>
                </div>
                <div class="card-body">
                    <!-- Warning Message -->
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Warning!</strong> You are about to permanently delete this shift assignment. This action cannot be undone.
                    </div>

                    <!-- Employee Info -->
                    <div class="card mb-4 border-primary">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0"><i class="bi bi-person"></i> Employee Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-2 text-center">
                                    @if (!string.IsNullOrEmpty(Model.Employee?.ProfileImage))
                                    {
                                        <img src="@Model.Employee.ProfileImage" alt="@Model.Employee.FullName"
                                             class="rounded-circle" style="width: 70px; height: 70px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center mx-auto"
                                             style="width: 70px; height: 70px;">
                                            <span class="text-white fs-3">
                                                @(Model.Employee?.FirstName?.Substring(0, 1).ToUpper())@(Model.Employee?.LastName?.Substring(0, 1).ToUpper())
                                            </span>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-10">
                                    <h4 class="mb-1">@(Model.Employee?.FullName ?? "Unknown Employee")</h4>
                                    <p class="mb-0 text-muted">
                                        <i class="bi bi-envelope me-1"></i> @(Model.Employee?.Email ?? "N/A")
                                        @if (!string.IsNullOrEmpty(Model.Employee?.Phone))
                                        {
                                            <span class="ms-3"><i class="bi bi-telephone me-1"></i> @Model.Employee.Phone</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Shift Info -->
                    <div class="card mb-4 border-info">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0"><i class="bi bi-clock"></i> Shift Information</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-muted small">Shift Name</label>
                                    <p class="fw-bold mb-0 fs-5">@(Model.Shift?.Name ?? "Unknown")</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-muted small">Shift Type</label>
                                    <p class="mb-0">
                                        @if (Model.Shift?.Type == "Normal")
                                        {
                                            <span class="badge bg-primary fs-6">
                                                <i class="bi bi-clock"></i> Normal
                                            </span>
                                        }
                                        else if (Model.Shift?.Type == "Split")
                                        {
                                            <span class="badge bg-info fs-6">
                                                <i class="bi bi-arrows-expand"></i> Split
                                            </span>
                                        }
                                        else if (Model.Shift?.Type == "Rotational")
                                        {
                                            <span class="badge bg-warning text-dark fs-6">
                                                <i class="bi bi-arrow-repeat"></i> Rotational
                                            </span>
                                        }
                                        else if (Model.Shift?.Type == "Custom")
                                        {
                                            <span class="badge bg-secondary fs-6">
                                                <i class="bi bi-gear"></i> Custom
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">@(Model.Shift?.Type ?? "-")</span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="row text-center mt-3">
                                <div class="col-md-4">
                                    <i class="bi bi-sunrise display-6 text-success"></i>
                                    <p class="mb-0 mt-2 text-muted">Start Time</p>
                                    <h5 class="mb-0">
                                        @if (Model.Shift?.StartTime.HasValue == true)
                                        {
                                            @Model.Shift.StartTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </h5>
                                </div>
                                <div class="col-md-4">
                                    <i class="bi bi-sunset display-6 text-danger"></i>
                                    <p class="mb-0 mt-2 text-muted">End Time</p>
                                    <h5 class="mb-0">
                                        @if (Model.Shift?.EndTime.HasValue == true)
                                        {
                                            @Model.Shift.EndTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </h5>
                                </div>
                                <div class="col-md-4">
                                    <i class="bi bi-cup-hot display-6 text-warning"></i>
                                    <p class="mb-0 mt-2 text-muted">Break</p>
                                    <h5 class="mb-0">
                                        @if (Model.Shift?.BreakDuration.HasValue == true && Model.Shift.BreakDuration > 0)
                                        {
                                            @($"{Model.Shift.BreakDuration} min")
                                        }
                                        else
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Assignment Details -->
                    <div class="card mb-4 border-secondary">
                        <div class="card-header bg-secondary text-white">
                            <h6 class="mb-0"><i class="bi bi-calendar-range"></i> Assignment Details</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-muted small">Assignment ID</label>
                                    <p class="fw-bold mb-0">#@Model.AssignmentId</p>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-muted small">Start Date</label>
                                    <p class="fw-bold mb-0">
                                        @if (Model.StartDate.HasValue)
                                        {
                                            @Model.StartDate.Value.ToString("MMMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </p>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label text-muted small">End Date</label>
                                    <p class="fw-bold mb-0">
                                        @if (Model.EndDate.HasValue)
                                        {
                                            @Model.EndDate.Value.ToString("MMMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-infinity"></i> Ongoing
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Status</label>
                                    <p class="mb-0">
                                        @if (Model.Status == "Active")
                                        {
                                            <span class="badge bg-success fs-6">
                                                <i class="bi bi-check-circle"></i> Active
                                            </span>
                                        }
                                        else if (Model.Status == "Inactive")
                                        {
                                            <span class="badge bg-secondary fs-6">
                                                <i class="bi bi-x-circle"></i> Inactive
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">@Model.Status</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Confirmation Message -->
                    <div class="alert alert-warning">
                        <i class="bi bi-question-circle"></i>
                        <strong>Are you sure you want to delete this assignment?</strong>
                        <p class="mb-0 mt-2">
                            This will remove the shift assignment for <strong>@(Model.Employee?.FullName ?? "Unknown")</strong>
                            from the <strong>@(Model.Shift?.Name ?? "Unknown")</strong> shift.
                            The employee will be notified about this change.
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Assignments" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <div>
                            <a asp-action="EditAssignment" asp-route-id="@Model.AssignmentId" class="btn btn-warning me-2">
                                <i class="bi bi-pencil"></i> Edit Instead
                            </a>
                            <form method="post" asp-action="DeleteAssignmentConfirm" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="AssignmentId" value="@Model.AssignmentId" />
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <i class="bi bi-trash"></i> Delete Assignment
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>