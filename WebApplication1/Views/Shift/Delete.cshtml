@model WebApplication1.Models.ShiftSchedule
@{
    ViewData["Title"] = "Delete Shift";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-trash"></i> Delete Shift
                    </h4>
                    <small>System Admin - Permanently delete this shift</small>
                </div>
                <div class="card-body">
                    <!-- Warning Message -->
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Warning!</strong> You are about to permanently delete this shift. This action cannot be undone.
                    </div>

                    <!-- Shift Details Card -->
                    <div class="card mb-4 border-secondary">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="bi bi-clock"></i> Shift Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-muted small">Shift ID</label>
                                    <p class="fw-bold mb-0 fs-5">#@Model.ShiftId</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-muted small">Shift Name</label>
                                    <p class="fw-bold mb-0 fs-5">@Model.Name</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-muted small">Type</label>
                                    <p class="mb-0">
                                        @if (Model.Type == "Normal")
                                        {
                                            <span class="badge bg-primary fs-6">
                                                <i class="bi bi-clock"></i> Normal
                                            </span>
                                        }
                                        else if (Model.Type == "Split")
                                        {
                                            <span class="badge bg-info fs-6">
                                                <i class="bi bi-arrows-expand"></i> Split
                                            </span>
                                        }
                                        else if (Model.Type == "Rotational")
                                        {
                                            <span class="badge bg-warning text-dark fs-6">
                                                <i class="bi bi-arrow-repeat"></i> Rotational
                                            </span>
                                        }
                                        else if (Model.Type == "Custom")
                                        {
                                            <span class="badge bg-secondary fs-6">
                                                <i class="bi bi-gear"></i> Custom
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">@Model.Type</span>
                                        }
                                    </p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label text-muted small">Status</label>
                                    <p class="mb-0">
                                        @if (Model.Status == "Active")
                                        {
                                            <span class="badge bg-success fs-6">
                                                <i class="bi bi-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">@Model.Status</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Time Information -->
                    <div class="card mb-4 border-info">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Time Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-4 mb-3">
                                    <i class="bi bi-sunrise display-4 text-success"></i>
                                    <h6 class="mt-2 text-muted">Start Time</h6>
                                    <h5 class="mb-0">
                                        @if (Model.StartTime.HasValue)
                                        {
                                            @Model.StartTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </h5>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <i class="bi bi-sunset display-4 text-danger"></i>
                                    <h6 class="mt-2 text-muted">End Time</h6>
                                    <h5 class="mb-0">
                                        @if (Model.EndTime.HasValue)
                                        {
                                            @Model.EndTime.Value.ToString("hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </h5>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <i class="bi bi-cup-hot display-4 text-warning"></i>
                                    <h6 class="mt-2 text-muted">Break Duration</h6>
                                    <h5 class="mb-0">
                                        @if (Model.BreakDuration.HasValue && Model.BreakDuration > 0)
                                        {
                                            @($"{Model.BreakDuration} minutes")
                                        }
                                        else
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Assignments Warning -->
                    @if (Model.ShiftAssignments != null && Model.ShiftAssignments.Any())
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-octagon"></i>
                            <strong>Cannot Delete!</strong>
                            <p class="mb-0 mt-2">
                                This shift has <strong>@Model.ShiftAssignments.Count active assignment(s)</strong>.
                                You must remove all assignments before deleting this shift.
                            </p>
                            <hr />
                            <a asp-action="Assignments" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-people"></i> View Assignments
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- Confirmation Message -->
                        <div class="alert alert-warning">
                            <i class="bi bi-question-circle"></i>
                            <strong>Are you sure you want to delete this shift?</strong>
                            <p class="mb-0 mt-2">
                                This will permanently remove the shift <strong>"@Model.Name"</strong> from the system.
                            </p>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.ShiftId" class="btn btn-warning me-2">
                                <i class="bi bi-pencil"></i> Edit Instead
                            </a>

                            @if (Model.ShiftAssignments == null || !Model.ShiftAssignments.Any())
                            {
                                <form method="post" asp-action="DeleteConfirm" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ShiftId" value="@Model.ShiftId" />
                                    <button type="submit" class="btn btn-danger btn-lg">
                                        <i class="bi bi-trash"></i> Delete Shift
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-danger btn-lg" disabled title="Remove assignments first">
                                    <i class="bi bi-trash"></i> Delete Shift
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
```

