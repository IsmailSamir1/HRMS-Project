@model WebApplication1.Models.LeaveRequest
@{
    ViewData["Title"] = "Leave Request Details";
    bool canApprove = ViewBag.CanApprove == true;

    string statusBadge = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };

    string statusIcon = Model.Status switch
    {
        "Pending" => "bi-hourglass-split",
        "Approved" => "bi-check-circle-fill",
        "Rejected" => "bi-x-circle-fill",
        "Cancelled" => "bi-slash-circle",
        _ => "bi-question-circle"
    };

    string cardBorder = Model.Status switch
    {
        "Pending" => "border-warning",
        "Approved" => "border-success",
        "Rejected" => "border-danger",
        "Cancelled" => "border-secondary",
        _ => ""
    };
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-file-earmark-text"></i> Leave Request #@Model.RequestId</h2>
                    <p class="text-muted mb-0">View leave request details</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>

            <!-- Status Banner -->
            <div class="alert @(Model.Status == "Pending" ? "alert-warning" : Model.Status == "Approved" ? "alert-success" : Model.Status == "Rejected" ? "alert-danger" : "alert-secondary") mb-4">
                <div class="d-flex align-items-center">
                    <i class="bi @statusIcon fs-1 me-3"></i>
                    <div>
                        <h4 class="mb-0">@Model.Status</h4>
                        <small>
                            @if (Model.Status == "Pending")
                            {
                                <span>This request is awaiting approval</span>
                            }
                            else if (Model.ApprovalTiming.HasValue)
                            {
                                <span>Processed on @Model.ApprovalTiming.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
                            }
                        </small>
                    </div>
                </div>
            </div>

            <!-- Main Details Card -->
            <div class="card shadow @cardBorder mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Request Details</h5>
                </div>
                <div class="card-body">
                    <!-- Employee Info -->
                    <div class="row mb-4 pb-3 border-bottom">
                        <div class="col-md-6">
                            <label class="text-muted small">EMPLOYEE</label>
                            <div class="d-flex align-items-center mt-1">
                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill text-white"></i>
                                </div>
                                <div>
                                    <strong>@(Model.Employee?.FullName ?? "Unknown")</strong>
                                    @if (Model.Employee?.Department != null)
                                    {
                                        <br />
                                        <small class="text-muted">@Model.Employee.Department.DepartmentName</small>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">REQUEST ID</label>
                            <div class="mt-1">
                                <span class="badge bg-dark fs-6">#@Model.RequestId</span>
                            </div>
                        </div>
                    </div>

                    <!-- Leave Details -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">LEAVE TYPE</label>
                            <div class="mt-1">
                                <span class="badge bg-info fs-6">
                                    <i class="bi bi-tag me-1"></i>
                                    @(Model.Leave?.LeaveType ?? "Unknown")
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">DURATION</label>
                            <div class="mt-1">
                                <span class="fs-4 fw-bold text-primary">@Model.Duration</span>
                                <span class="text-muted">working day(s)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">STATUS</label>
                            <div class="mt-1">
                                <span class="badge @statusBadge fs-6">
                                    <i class="bi @statusIcon me-1"></i>
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">DECISION DATE</label>
                            <div class="mt-1">
                                @if (Model.ApprovalTiming.HasValue)
                                {
                                    <i class="bi bi-calendar-check me-1 text-success"></i>
                                    <span>@Model.ApprovalTiming.Value.ToString("MMM dd, yyyy hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Pending decision</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Justification -->
                    @if (!string.IsNullOrEmpty(Model.Justification))
                    {
                        <div class="mb-4">
                            <label class="text-muted small">JUSTIFICATION / REASON</label>
                            <div class="bg-light p-3 rounded mt-1">
                                <i class="bi bi-chat-quote me-2 text-primary"></i>
                                @Model.Justification
                            </div>
                        </div>
                    }

                    <!-- Attachments -->
                    @if (Model.LeaveDocuments != null && Model.LeaveDocuments.Any())
                    {
                        <div class="mb-3">
                            <label class="text-muted small">ATTACHMENTS</label>
                            <div class="mt-1">
                                @foreach (var doc in Model.LeaveDocuments)
                                {
                                    <div class="d-flex align-items-center bg-light p-2 rounded mb-2">
                                        <i class="bi bi-paperclip fs-5 text-primary me-2"></i>
                                        <div class="flex-grow-1">
                                            <a href="@doc.FilePath" target="_blank" class="text-decoration-none">
                                                View Attachment
                                            </a>
                                            @if (doc.UploadedAt.HasValue)
                                            {
                                                <br />
                                                <small class="text-muted">
                                                    Uploaded: @doc.UploadedAt.Value.ToString("MMM dd, yyyy")
                                                </small>
                                            }
                                        </div>
                                        <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-download"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                @if (canApprove || Model.Status == "Pending")
                {
                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between">
                            @if (canApprove)
                            {
                                <div>
                                    <form method="post" asp-action="Approve" asp-route-id="@Model.RequestId" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-lg me-2"
                                                onclick="return confirm('Approve this leave request?');">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-danger btn-lg"
                                            data-bs-toggle="modal" data-bs-target="#rejectModal">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>
                            }
                            else if (Model.Status == "Pending" && Model.EmployeeId == Context.Session.GetInt32("EmployeeId"))
                            {
                                <form method="post" asp-action="Cancel" asp-route-id="@Model.RequestId">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-secondary"
                                            onclick="return confirm('Cancel this leave request?');">
                                        <i class="bi bi-x-circle"></i> Cancel Request
                                    </button>
                                </form>
                            }
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Timeline -->
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-clock-history"></i> Request Timeline</h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <!-- Submitted -->
                        <div class="d-flex mb-3">
                            <div class="me-3">
                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                    <i class="bi bi-send text-white small"></i>
                                </div>
                            </div>
                            <div>
                                <strong>Request Submitted</strong>
                                <p class="text-muted mb-0 small">
                                    By @(Model.Employee?.FullName ?? "Unknown")
                                </p>
                            </div>
                        </div>

                        <!-- Status Update -->
                        @if (Model.Status != "Pending")
                        {
                            <div class="d-flex">
                                <div class="me-3">
                                    @if (Model.Status == "Approved")
                                    {
                                        <div class="bg-success rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                            <i class="bi bi-check text-white small"></i>
                                        </div>
                                    }
                                    else if (Model.Status == "Rejected")
                                    {
                                        <div class="bg-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                            <i class="bi bi-x text-white small"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                            <i class="bi bi-slash text-white small"></i>
                                        </div>
                                    }
                                </div>
                                <div>
                                    <strong>Request @Model.Status</strong>
                                    @if (Model.ApprovalTiming.HasValue)
                                    {
                                        <p class="text-muted mb-0 small">
                                            @Model.ApprovalTiming.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                        </p>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex">
                                <div class="me-3">
                                    <div class="bg-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                        <i class="bi bi-hourglass-split text-dark small"></i>
                                    </div>
                                </div>
                                <div>
                                    <strong>Awaiting Approval</strong>
                                    <p class="text-muted mb-0 small">Pending manager review</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
@if (canApprove)
{
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-x-circle"></i> Reject Leave Request
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="Reject" asp-route-id="@Model.RequestId">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p>
                            <strong>Employee:</strong> @(Model.Employee?.FullName ?? "Unknown")<br />
                            <strong>Leave Type:</strong> @(Model.Leave?.LeaveType ?? "Unknown")<br />
                            <strong>Duration:</strong> @Model.Duration day(s)
                        </p>
                        <div class="mb-3">
                            <label class="form-label">Rejection Reason (Optional)</label>
                            <textarea name="RejectionReason" class="form-control" rows="3"
                                  placeholder="Provide a reason for rejecting this request..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle"></i> Reject Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
