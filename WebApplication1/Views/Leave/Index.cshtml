@model List<WebApplication1.Models.LeaveRequest>
@{
    ViewData["Title"] = "Leave Management";
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
    bool isHRAdmin = ViewBag.IsHRAdmin == true;
    bool isLineManager = ViewBag.IsLineManager == true;
    int currentEmployeeId = ViewBag.CurrentEmployeeId ?? 0;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-calendar-heart"></i> Leave Management</h2>
            <p class="text-muted mb-0">Manage leave requests and balances</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success me-2">
                <i class="bi bi-plus-circle"></i> Request Leave
            </a>
            <a asp-action="MyBalance" class="btn btn-info me-2">
                <i class="bi bi-pie-chart"></i> My Balance
            </a>
            @if (isLineManager || isSystemAdmin || isHRAdmin)
            {
                <a asp-action="TeamCalendar" class="btn btn-warning me-2">
                    <i class="bi bi-calendar3"></i> Team Calendar
                </a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-primary shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-files display-4 text-primary"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.TotalRequests</h2>
                    <p class="text-muted mb-0">Total Requests</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-warning shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-hourglass-split display-4 text-warning"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.PendingRequests</h2>
                    <p class="text-muted mb-0">Pending</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-success shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-4 text-success"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.ApprovedRequests</h2>
                    <p class="text-muted mb-0">Approved</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-danger shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle display-4 text-danger"></i>
                    <h2 class="mt-2 mb-0">@ViewBag.RejectedRequests</h2>
                    <p class="text-muted mb-0">Rejected</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Alert for Managers -->
    @if ((isLineManager || isSystemAdmin || isHRAdmin) && ViewBag.PendingRequests > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Action Required:</strong> You have <strong>@ViewBag.PendingRequests</strong> pending leave request(s) awaiting your review.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Buttons -->
    <div class="card shadow mb-4">
        <div class="card-body py-2">
            <div class="d-flex align-items-center">
                <strong class="me-3"><i class="bi bi-funnel"></i> Filter:</strong>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-primary filter-btn active" data-filter="all">
                        All (@Model.Count)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning filter-btn" data-filter="Pending">
                        Pending (@Model.Count(l => l.Status == "Pending"))
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success filter-btn" data-filter="Approved">
                        Approved (@Model.Count(l => l.Status == "Approved"))
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger filter-btn" data-filter="Rejected">
                        Rejected (@Model.Count(l => l.Status == "Rejected"))
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Requests Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-table"></i> Leave Requests</h5>
            <span class="badge bg-light text-dark fs-6">@Model.Count requests</span>
        </div>
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Leave Requests</h5>
                    <p class="text-muted">No leave requests found.</p>
                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Submit New Request
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0" id="leaveTable">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                @if (isSystemAdmin || isHRAdmin || isLineManager)
                                {
                                    <th>Employee</th>
                                }
                                <th>Leave Type</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Decision Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                string rowClass = request.Status switch
                                {
                                    "Pending" => "table-warning",
                                    "Approved" => "table-success",
                                    "Rejected" => "table-danger",
                                    "Cancelled" => "table-secondary",
                                    _ => ""
                                };

                                <tr class="leave-row @rowClass" data-status="@request.Status">
                                    <td><strong>#@request.RequestId</strong></td>
                                    @if (isSystemAdmin || isHRAdmin || isLineManager)
                                    {
                                        <td>
                                            <i class="bi bi-person me-1"></i>
                                            @(request.Employee?.FullName ?? "Unknown")
                                            @if (request.EmployeeId == currentEmployeeId)
                                            {
                                                <span class="badge bg-info ms-1">You</span>
                                            }
                                        </td>
                                    }
                                    <td>
                                        <span class="badge bg-info">
                                            @(request.Leave?.LeaveType ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>
                                        <strong>@request.Duration</strong> day(s)
                                    </td>
                                    <td>
                                        @if (request.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark fs-6">
                                                <i class="bi bi-hourglass-split"></i> Pending
                                            </span>
                                        }
                                        else if (request.Status == "Approved")
                                        {
                                            <span class="badge bg-success fs-6">
                                                <i class="bi bi-check-circle"></i> Approved
                                            </span>
                                        }
                                        else if (request.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger fs-6">
                                                <i class="bi bi-x-circle"></i> Rejected
                                            </span>
                                        }
                                        else if (request.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary fs-6">
                                                <i class="bi bi-slash-circle"></i> Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">@request.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (request.ApprovalTiming.HasValue)
                                        {
                                            <i class="bi bi-calendar-check me-1"></i>
                                            @request.ApprovalTiming.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@request.RequestId" class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (request.Status == "Pending")
                                        {
                                            @if ((isSystemAdmin || isHRAdmin || isLineManager) && request.EmployeeId != currentEmployeeId)
                                            {
                                                <form method="post" asp-action="Approve" asp-route-id="@request.RequestId" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="Approve"
                                                            onclick="return confirm('Approve this leave request?');">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>

                                                <button type="button" class="btn btn-sm btn-danger" title="Reject"
                                                        data-bs-toggle="modal" data-bs-target="#rejectModal_@request.RequestId">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>

                                                <!-- Reject Modal -->
                                                <div class="modal fade" id="rejectModal_@request.RequestId" tabindex="-1">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header bg-danger text-white">
                                                                <h5 class="modal-title">
                                                                    <i class="bi bi-x-circle"></i> Reject Leave Request
                                                                </h5>
                                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <form method="post" asp-action="Reject" asp-route-id="@request.RequestId">
                                                                @Html.AntiForgeryToken()
                                                                <div class="modal-body">
                                                                    <p>
                                                                        <strong>Employee:</strong> @(request.Employee?.FullName ?? "Unknown")
                                                                        <br />
                                                                        <strong>Leave Type:</strong> @(request.Leave?.LeaveType ?? "Unknown")
                                                                        <br />
                                                                        <strong>Duration:</strong> @request.Duration day(s)
                                                                    </p>
                                                                    <div class="mb-3">
                                                                        <label class="form-label">Rejection Reason (Optional)</label>
                                                                        <textarea name="RejectionReason" class="form-control" rows="3" placeholder="Provide a reason..."></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-danger">
                                                                        <i class="bi bi-x-circle"></i> Reject Request
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            @if (request.EmployeeId == currentEmployeeId)
                                            {
                                                <form method="post" asp-action="Cancel" asp-route-id="@request.RequestId" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-secondary" title="Cancel"
                                                            onclick="return confirm('Cancel this leave request?');">
                                                        <i class="bi bi-slash-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterBtns = document.querySelectorAll('.filter-btn');
            const rows = document.querySelectorAll('.leave-row');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const filter = this.getAttribute('data-filter');

                    rows.forEach(row => {
                        const status = row.getAttribute('data-status');
                        if (filter === 'all' || status === filter) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>
}