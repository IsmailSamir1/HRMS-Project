@model List<WebApplication1.Models.Employee>
@{
    ViewData["Title"] = "Manage Leave Entitlements";
    var leaveTypes = ViewBag.LeaveTypes as List<WebApplication1.Models.Leave>;
    var entitlements = ViewBag.Entitlements as Dictionary<int, List<WebApplication1.Models.LeaveEntitlement>>;
    var departments = ViewBag.Departments as List<WebApplication1.Models.Department>;
    var search = ViewBag.Search as string;
    var departmentId = ViewBag.DepartmentId as int?;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-sliders text-primary"></i> Manage Leave Entitlements</h2>
            <p class="text-muted mb-0">Assign or adjust leave entitlements for employees</p>
        </div>
        <div>
            <a asp-action="LeaveTypes" class="btn btn-info me-2">
                <i class="bi bi-gear"></i> Leave Types
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Bulk Update Card -->
    <div class="card shadow mb-4">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-lightning"></i> Bulk Update Entitlements</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="BulkUpdateEntitlements">
                @Html.AntiForgeryToken()
                <div class="row align-items-end">
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Leave Type</label>
                        <select name="leaveTypeId" class="form-select" required>
                            <option value="">-- Select Leave Type --</option>
                            @if (leaveTypes != null)
                            {
                                @foreach (var lt in leaveTypes)
                                {
                                    <option value="@lt.LeaveId">@lt.LeaveType</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label">Entitlement (Days)</label>
                        <input type="number" name="entitlementDays" class="form-control" min="0" max="365" required />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Department</label>
                        <select name="departmentId" class="form-select" id="bulkDepartment">
                            <option value="">-- All Departments --</option>
                            @if (departments != null)
                            {
                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="allEmployees" value="true" id="allEmployees">
                            <label class="form-check-label" for="allEmployees">All Employees</label>
                        </div>
                    </div>
                    <div class="col-md-2 mb-2">
                        <button type="submit" class="btn btn-warning w-100" onclick="return confirm('This will update entitlements for multiple employees. Continue?');">
                            <i class="bi bi-arrow-repeat"></i> Apply
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="card shadow mb-4">
        <div class="card-body py-2">
            <form method="get" asp-action="ManageEntitlements">
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" name="search" class="form-control" placeholder="Search by name or email..." value="@search" />
                        </div>
                    </div>
                    <div class="col-md-3 mb-2">
                        <select name="departmentId" class="form-select">
                            <option value="">All Departments</option>
                            @if (departments != null)
                            {
                                @foreach (var dept in departments)
                                {
                                    if (departmentId.HasValue && departmentId.Value == dept.DepartmentId)
                                    {
                                        <option value="@dept.DepartmentId" selected>@dept.DepartmentName</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel"></i> Filter
                        </button>
                    </div>
                    <div class="col-md-3 mb-2 text-end">
                        <span class="badge bg-info fs-6">@(Model?.Count ?? 0) employees</span>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Employees Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-people"></i> Employee Entitlements</h5>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Employees Found</h5>
                    <p class="text-muted">Try adjusting your search criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee</th>
                                <th>Department</th>
                                @if (leaveTypes != null)
                                {
                                    @foreach (var lt in leaveTypes)
                                    {
                                        <th class="text-center" style="min-width: 80px;">
                                            <small>@lt.LeaveType</small>
                                        </th>
                                    }
                                }
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model)
                            {
                                var empEntitlements = entitlements != null && entitlements.ContainsKey(emp.EmployeeId)
                                ? entitlements[emp.EmployeeId]
                                : new List<WebApplication1.Models.LeaveEntitlement>();

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px;">
                                                @{
                                                    var initial = emp.FirstName != null && emp.FirstName.Length > 0
                                                    ? emp.FirstName.Substring(0, 1) : "?";
                                                }
                                                <span class="text-white small fw-bold">@initial</span>
                                            </div>
                                            <div>
                                                <strong>@emp.FullName</strong>
                                                <br />
                                                <small class="text-muted">@emp.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <small>@(emp.Department?.DepartmentName ?? "N/A")</small>
                                    </td>
                                    @if (leaveTypes != null)
                                    {
                                        @foreach (var lt in leaveTypes)
                                        {
                                            var ent = empEntitlements.FirstOrDefault(e => e.LeaveTypeId == lt.LeaveId);
                                            var days = ent?.Entitlement ?? 0;
                                            var badgeClass = days > 0 ? "bg-success" : "bg-secondary";

                                            <td class="text-center">
                                                <span class="badge @badgeClass">@days</span>
                                            </td>
                                        }
                                    }
                                    <td>
                                        <a asp-action="EmployeeEntitlements" asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>