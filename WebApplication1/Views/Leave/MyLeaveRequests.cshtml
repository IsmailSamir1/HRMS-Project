@model List<WebApplication1.Models.LeaveRequest>
@{
    ViewData["Title"] = "My Leave Requests";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-calendar-range"></i> My Leave Requests</h2>
            <p class="text-muted mb-0">View your leave request history</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success me-2">
                <i class="bi bi-plus-circle"></i> New Request
            </a>
            <a asp-action="MyBalance" class="btn btn-info me-2">
                <i class="bi bi-pie-chart"></i> My Balance
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-primary shadow h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-files fs-1 text-primary"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.TotalRequests</h3>
                    <small class="text-muted">Total Requests</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-warning shadow h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-hourglass-split fs-1 text-warning"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.PendingRequests</h3>
                    <small class="text-muted">Pending</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-success shadow h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-check-circle fs-1 text-success"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.ApprovedRequests</h3>
                    <small class="text-muted">Approved</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-danger shadow h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-x-circle fs-1 text-danger"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.RejectedRequests</h3>
                    <small class="text-muted">Rejected</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Leave Requests List -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-list-ul"></i> My Leave History</h5>
        </div>
        <div class="card-body p-0">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Leave Requests Yet</h5>
                    <p class="text-muted">You haven't submitted any leave requests.</p>
                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Submit Your First Request
                    </a>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var request in Model)
                    {
                        string borderClass = request.Status switch
                        {
                            "Pending" => "border-start border-warning border-4",
                            "Approved" => "border-start border-success border-4",
                            "Rejected" => "border-start border-danger border-4",
                            "Cancelled" => "border-start border-secondary border-4",
                            _ => ""
                        };

                        string statusBadge = request.Status switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Approved" => "bg-success",
                            "Rejected" => "bg-danger",
                            "Cancelled" => "bg-secondary",
                            _ => "bg-secondary"
                        };

                        string statusIcon = request.Status switch
                        {
                            "Pending" => "bi-hourglass-split",
                            "Approved" => "bi-check-circle",
                            "Rejected" => "bi-x-circle",
                            "Cancelled" => "bi-slash-circle",
                            _ => "bi-question-circle"
                        };

                        <div class="list-group-item @borderClass">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-info me-2">@(request.Leave?.LeaveType ?? "Unknown")</span>
                                        <span class="badge @statusBadge">
                                            <i class="bi @statusIcon me-1"></i>@request.Status
                                        </span>
                                        <small class="text-muted ms-2">#@request.RequestId</small>
                                    </div>
                                    <p class="mb-1">
                                        <strong><i class="bi bi-clock me-1"></i> Duration:</strong> @request.Duration day(s)
                                    </p>
                                    @if (!string.IsNullOrEmpty(request.Justification))
                                    {
                                        <p class="mb-1 text-muted small">
                                            <i class="bi bi-chat-text me-1"></i> @request.Justification
                                        </p>
                                    }
                                    @if (request.LeaveDocuments != null && request.LeaveDocuments.Any())
                                    {
                                        <p class="mb-0">
                                            <i class="bi bi-paperclip me-1 text-primary"></i>
                                            <small>@request.LeaveDocuments.Count attachment(s)</small>
                                        </p>
                                    }
                                </div>
                                <div class="text-end">
                                    @if (request.ApprovalTiming.HasValue)
                                    {
                                        <small class="text-muted d-block">
                                            @(request.Status == "Pending" ? "Submitted" : "Processed"):
                                            @request.ApprovalTiming.Value.ToString("MMM dd, yyyy")
                                        </small>
                                    }
                                    <div class="mt-2">
                                        <a asp-action="Details" asp-route-id="@request.RequestId" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        @if (request.Status == "Pending")
                                        {
                                            <form method="post" asp-action="Cancel" asp-route-id="@request.RequestId" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Cancel this leave request?');">
                                                    <i class="bi bi-x-circle"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
