@model WebApplication1.Models.LeaveRequest
@{
    ViewData["Title"] = "Override Leave Decision";

    var statusBadge = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-shield-exclamation text-danger"></i> Override Leave Decision</h2>
                    <p class="text-muted mb-0">HR Admin override for leave request #@Model.RequestId</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Requests
                    </a>
                </div>
            </div>

            <!-- Warning Alert -->
            <div class="alert alert-warning">
                <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> HR Admin Override</h5>
                <p class="mb-0">You are about to override a leave decision. This action will be logged and the employee will be notified of the change.</p>
            </div>

            <!-- Request Details Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-text"></i> Request Details</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">EMPLOYEE</label>
                            <div class="d-flex align-items-center mt-1">
                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                    @{
                                        var initial = Model.Employee?.FirstName != null && Model.Employee.FirstName.Length > 0
                                        ? Model.Employee.FirstName.Substring(0, 1) : "?";
                                    }
                                    <span class="text-white fw-bold">@initial</span>
                                </div>
                                <div>
                                    <strong>@(Model.Employee?.FullName ?? "Unknown")</strong>
                                    <br />
                                    <small class="text-muted">@(Model.Employee?.Department?.DepartmentName ?? "N/A")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">CURRENT STATUS</label>
                            <div class="mt-1">
                                <span class="badge @statusBadge fs-5">@Model.Status</span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="text-muted small">LEAVE TYPE</label>
                            <div class="mt-1">
                                <span class="badge bg-info fs-6">@(Model.Leave?.LeaveType ?? "Unknown")</span>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="text-muted small">DURATION</label>
                            <div class="mt-1">
                                <strong class="fs-5">@Model.Duration day(s)</strong>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="text-muted small">DECISION DATE</label>
                            <div class="mt-1">
                                @if (Model.ApprovalTiming.HasValue)
                                {
                                    @Model.ApprovalTiming.Value.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Not processed</span>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Justification))
                    {
                        <div class="mb-3">
                            <label class="text-muted small">JUSTIFICATION / NOTES</label>
                            <div class="bg-light p-3 rounded mt-1">
                                @Model.Justification
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Override Form -->
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Override Decision</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="OverrideDecision" asp-route-id="@Model.RequestId">
                        @Html.AntiForgeryToken()

                        <!-- New Status -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-arrow-right-circle"></i> New Status <span class="text-danger">*</span>
                            </label>
                            <select name="NewStatus" class="form-select form-select-lg" required>
                                <option value="">-- Select New Status --</option>
                                <option value="Approved" class="text-success">✓ Approved</option>
                                <option value="Rejected" class="text-danger">✗ Rejected</option>
                                <option value="Pending" class="text-warning">⏳ Pending (Re-open)</option>
                                <option value="Cancelled" class="text-secondary">⊘ Cancelled</option>
                            </select>
                        </div>

                        <!-- Override Reason -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-chat-text"></i> Override Reason <span class="text-danger">*</span>
                            </label>
                            <textarea name="OverrideReason" class="form-control" rows="4"
                                      placeholder="Provide a reason for this override (required for audit purposes)..." required></textarea>
                            <div class="form-text">This reason will be recorded in the system and may be visible to the employee.</div>
                        </div>

                        <!-- Sync with Attendance -->
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="SyncAttendance" value="true" id="syncAttendance" checked>
                                <label class="form-check-label fw-bold" for="syncAttendance">
                                    Sync with Attendance Records
                                </label>
                            </div>
                            <div class="form-text">
                                If checked and status is changed to "Approved", attendance records will be updated to reflect the leave.
                            </div>
                        </div>

                        <!-- Warning -->
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Note:</strong> The employee will receive a notification about this override.
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.RequestId" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg" onclick="return confirm('Are you sure you want to override this decision?');">
                                <i class="bi bi-shield-exclamation"></i> Override Decision
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>