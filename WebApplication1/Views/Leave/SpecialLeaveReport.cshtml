@{
    ViewData["Title"] = "Special Leave Report";
    var specialLeaves = ViewBag.SpecialLeaves as List<WebApplication1.Models.LeaveRequest>;
    var longLeaves = ViewBag.LongLeaves as List<WebApplication1.Models.LeaveRequest>;
    int totalSpecial = ViewBag.TotalSpecial ?? 0;
    int pendingSpecial = ViewBag.PendingSpecial ?? 0;
    int approvedSpecial = ViewBag.ApprovedSpecial ?? 0;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-star text-warning"></i> Special Leave Report</h2>
            <p class="text-muted mb-0">Manage maternity, paternity, bereavement, and other special leave types</p>
        </div>
        <div>
            <a asp-action="LeaveTypes" class="btn btn-info me-2">
                <i class="bi bi-gear"></i> Leave Types
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card border-primary shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-star-fill display-4 text-primary"></i>
                    <h2 class="mt-2 mb-0">@totalSpecial</h2>
                    <p class="text-muted mb-0">Total Special Leaves</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-warning shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-hourglass-split display-4 text-warning"></i>
                    <h2 class="mt-2 mb-0">@pendingSpecial</h2>
                    <p class="text-muted mb-0">Pending Approval</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-success shadow h-100">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle display-4 text-success"></i>
                    <h2 class="mt-2 mb-0">@approvedSpecial</h2>
                    <p class="text-muted mb-0">Approved</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Special Leave Requests -->
    <div class="card shadow mb-4">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-star"></i> Special Leave Requests</h5>
            <span class="badge bg-dark">@(specialLeaves?.Count ?? 0) requests</span>
        </div>
        <div class="card-body p-0">
            @if (specialLeaves == null || !specialLeaves.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Special Leave Requests</h5>
                    <p class="text-muted">No maternity, paternity, bereavement, or other special leave requests found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Employee</th>
                                <th>Department</th>
                                <th>Leave Type</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in specialLeaves)
                            {
                                var statusBadge = leave.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Approved" => "bg-success",
                                    "Rejected" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td><strong>#@leave.RequestId</strong></td>
                                    <td>@(leave.Employee?.FullName ?? "Unknown")</td>
                                    <td><small class="text-muted">@(leave.Employee?.Department?.DepartmentName ?? "N/A")</small></td>
                                    <td><span class="badge bg-info">@(leave.Leave?.LeaveType ?? "Unknown")</span></td>
                                    <td><strong>@leave.Duration</strong> days</td>
                                    <td><span class="badge @statusBadge">@leave.Status</span></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@leave.RequestId" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (leave.Status != "Pending")
                                        {
                                            <a asp-action="OverrideDecision" asp-route-id="@leave.RequestId" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-shield"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Long Duration Leaves -->
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-calendar-range"></i> Long Duration Leaves (5+ Days)</h5>
            <span class="badge bg-light text-dark">@(longLeaves?.Count ?? 0) requests</span>
        </div>
        <div class="card-body p-0">
            @if (longLeaves == null || !longLeaves.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Long Duration Leaves</h5>
                    <p class="text-muted">No leave requests of 5 or more days found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Employee</th>
                                <th>Department</th>
                                <th>Leave Type</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in longLeaves)
                            {
                                var statusBadge = leave.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Approved" => "bg-success",
                                    "Rejected" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td><strong>#@leave.RequestId</strong></td>
                                    <td>@(leave.Employee?.FullName ?? "Unknown")</td>
                                    <td><small class="text-muted">@(leave.Employee?.Department?.DepartmentName ?? "N/A")</small></td>
                                    <td><span class="badge bg-primary">@(leave.Leave?.LeaveType ?? "Unknown")</span></td>
                                    <td><strong class="text-danger">@leave.Duration</strong> days</td>
                                    <td><span class="badge @statusBadge">@leave.Status</span></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@leave.RequestId" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>