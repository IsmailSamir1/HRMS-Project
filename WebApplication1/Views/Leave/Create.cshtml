@{
    ViewData["Title"] = "Request Leave";
    var leaveTypes = ViewBag.LeaveTypes as List<WebApplication1.Models.Leave>;
    var leaveBalances = ViewBag.LeaveBalances as Dictionary<int, WebApplication1.Controllers.LeaveBalanceInfo>;
    var employee = ViewBag.Employee as WebApplication1.Models.Employee;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-calendar-plus"></i> Request Leave</h2>
                    <p class="text-muted mb-0">Submit a new leave request</p>
                </div>
                <div>
                    <a asp-action="MyBalance" class="btn btn-info me-2">
                        <i class="bi bi-pie-chart"></i> My Balance
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            <!-- Employee Info Card -->
            @if (employee != null)
            {
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                <i class="bi bi-person-fill text-white fs-4"></i>
                            </div>
                            <div>
                                <h5 class="mb-0">@employee.FullName</h5>
                                <small class="text-muted">
                                    @(employee.Department?.DepartmentName ?? "No Department")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Leave Balance Summary -->
            @if (leaveBalances != null && leaveBalances.Count > 0)
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Your Leave Balance</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var balance in leaveBalances)
                            {
                                var percentage = balance.Value.TotalAllowed > 0
                                ? (int)((double)balance.Value.RemainingDays / balance.Value.TotalAllowed * 100)
                                : 0;
                                var progressColor = percentage > 50 ? "bg-success" : (percentage > 25 ? "bg-warning" : "bg-danger");

                                <div class="col-md-4 mb-3">
                                    <div class="border rounded p-3 h-100">
                                        <h6 class="text-primary mb-2">@balance.Value.LeaveType</h6>
                                        <div class="progress mb-2" style="height: 8px;">
                                            <div class="progress-bar @progressColor" style="width: @percentage%"></div>
                                        </div>
                                        <div class="d-flex justify-content-between small">
                                            <span>Remaining: <strong>@balance.Value.RemainingDays</strong></span>
                                            <span class="text-muted">/ @balance.Value.TotalAllowed days</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Leave Request Form -->
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Leave Request Form</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Create" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- Leave Type -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-tag"></i> Leave Type <span class="text-danger">*</span>
                            </label>
                            <select name="LeaveId" id="leaveTypeSelect" class="form-select form-select-lg" required>
                                <option value="">-- Select Leave Type --</option>
                                @if (leaveTypes != null)
                                {
                                    @foreach (var leave in leaveTypes)
                                    {
                                        var balance = leaveBalances?.ContainsKey(leave.LeaveId) == true
                                        ? leaveBalances[leave.LeaveId]
                                        : null;
                                        var remainingText = balance != null
                                        ? $" ({balance.RemainingDays} days remaining)"
                                        : "";

                                        <option value="@leave.LeaveId">
                                            @leave.LeaveType @remainingText
                                        </option>
                                    }
                                }
                            </select>
                            <div class="form-text">Select the type of leave you want to request.</div>
                        </div>

                        <!-- Date Range -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-event"></i> Start Date <span class="text-danger">*</span>
                                </label>
                                <input type="date" name="StartDate" id="startDate" class="form-control form-control-lg"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    <i class="bi bi-calendar-event"></i> End Date <span class="text-danger">*</span>
                                </label>
                                <input type="date" name="EndDate" id="endDate" class="form-control form-control-lg"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>

                        <!-- Duration Preview -->
                        <div class="alert alert-info mb-4" id="durationPreview" style="display: none;">
                            <i class="bi bi-info-circle me-2"></i>
                            <span id="durationText">Duration will be calculated...</span>
                        </div>

                        <!-- Justification -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-chat-text"></i> Justification / Reason
                            </label>
                            <textarea name="Justification" class="form-control" rows="4"
                                      placeholder="Please provide a reason for your leave request (optional but recommended)..."></textarea>
                            <div class="form-text">Providing a reason may help speed up the approval process.</div>
                        </div>

                        <!-- Attachment -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-paperclip"></i> Attachment (Optional)
                            </label>
                            <input type="file" name="Attachment" class="form-control"
                                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                            <div class="form-text">
                                Upload supporting documents (e.g., medical certificate).
                                Accepted formats: PDF, DOC, DOCX, JPG, PNG (Max 5MB)
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-send"></i> Submit Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card border-info mt-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-lightbulb text-info"></i> Tips for Leave Requests</h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0 small">
                        <li>Submit requests at least <strong>3 working days</strong> in advance when possible</li>
                        <li>For sick leave, a medical certificate may be required for absences over 2 days</li>
                        <li>Weekends are automatically excluded from the duration calculation</li>
                        <li>Check your leave balance before submitting to ensure sufficient days available</li>
                        <li>Your manager will be notified automatically once you submit</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const startDate = document.getElementById('startDate');
            const endDate = document.getElementById('endDate');
            const durationPreview = document.getElementById('durationPreview');
            const durationText = document.getElementById('durationText');

            function calculateDuration() {
                if (startDate.value && endDate.value) {
                    const start = new Date(startDate.value);
                    const end = new Date(endDate.value);

                    if (end >= start) {
                        let workingDays = 0;
                        let current = new Date(start);

                        while (current <= end) {
                            const day = current.getDay();
                            if (day !== 0 && day !== 6) {
                                workingDays++;
                            }
                            current.setDate(current.getDate() + 1);
                        }

                        durationPreview.style.display = 'block';
                        durationText.innerHTML = '<strong>' + workingDays + ' working day(s)</strong> (excluding weekends)';

                        if (workingDays === 0) {
                            durationPreview.className = 'alert alert-warning mb-4';
                            durationText.innerHTML = '<strong>0 working days</strong> - Selected dates fall on weekends only';
                        } else {
                            durationPreview.className = 'alert alert-info mb-4';
                        }
                    } else {
                        durationPreview.style.display = 'block';
                        durationPreview.className = 'alert alert-danger mb-4';
                        durationText.innerHTML = '<strong>Invalid date range</strong> - End date must be after start date';
                    }
                } else {
                    durationPreview.style.display = 'none';
                }
            }

            startDate.addEventListener('change', function() {
                if (this.value) {
                    endDate.min = this.value;
                    if (endDate.value && endDate.value < this.value) {
                        endDate.value = this.value;
                    }
                }
                calculateDuration();
            });

            endDate.addEventListener('change', calculateDuration);
        });
    </script>
}