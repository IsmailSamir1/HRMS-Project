@{
    ViewData["Title"] = "Employee Leave Details";
    var employee = ViewBag.Employee as WebApplication1.Models.Employee;
    var leaveRequests = ViewBag.LeaveRequests as List<WebApplication1.Models.LeaveRequest>;
    var pattern = ViewBag.Pattern as WebApplication1.Controllers.EmployeeLeavePattern;
    var balances = ViewBag.Balances as List<WebApplication1.Controllers.LeaveBalanceViewModel>;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-person-lines-fill"></i> Employee Leave Details</h2>
            <p class="text-muted mb-0">Detailed leave analysis for @(employee?.FullName ?? "Unknown")</p>
        </div>
        <div>
            <a asp-action="LeavePatterns" class="btn btn-warning me-2">
                <i class="bi bi-arrow-left"></i> Back to Patterns
            </a>
            <a asp-action="TeamPendingRequests" class="btn btn-primary me-2">
                <i class="bi bi-hourglass-split"></i> Pending Requests
            </a>
        </div>
    </div>

    <!-- Employee Info Card -->
    @if (employee != null)
    {
        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 70px; height: 70px;">
                                @{
                                    var initial = employee.FirstName != null && employee.FirstName.Length > 0
                                    ? employee.FirstName.Substring(0, 1)
                                    : "?";
                                }
                                <span class="text-white fw-bold fs-3">@initial</span>
                            </div>
                            <div>
                                <h4 class="mb-0">@employee.FullName</h4>
                                <p class="text-muted mb-0">
                                    <i class="bi bi-building me-1"></i> @(employee.Department?.DepartmentName ?? "No Department")
                                </p>
                                <p class="text-muted mb-0">
                                    <i class="bi bi-envelope me-1"></i> @(employee.Email ?? "No Email")
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        @if (pattern != null && pattern.IsFlagged)
                        {
                            <span class="badge bg-danger fs-5 mb-2">
                                <i class="bi bi-flag-fill"></i> Flagged - @pattern.PatternFlags.Count Issue(s)
                            </span>
                            <br />
                            <span class="badge bg-warning text-dark">Risk Level: @pattern.RiskLevel%</span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-5">
                                <i class="bi bi-check-circle"></i> Normal Pattern
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Left Column: Pattern Analysis -->
        <div class="col-lg-6 mb-4">
            <!-- Pattern Analysis Card -->
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Pattern Analysis (@DateTime.Now.Year)</h5>
                </div>
                <div class="card-body">
                    @if (pattern != null)
                    {
                        <!-- Stats Grid -->
                        <div class="row text-center mb-4">
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h3 class="text-primary mb-0">@pattern.TotalLeaveDays</h3>
                                    <small class="text-muted">Total Days</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h3 class="@(pattern.MondayLeaves >= 3 ? "text-danger" : "text-success") mb-0">@pattern.MondayLeaves</h3>
                                    <small class="text-muted">Mondays</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h3 class="@(pattern.FridayLeaves >= 3 ? "text-danger" : "text-success") mb-0">@pattern.FridayLeaves</h3>
                                    <small class="text-muted">Fridays</small>
                                </div>
                            </div>
                        </div>

                        <div class="row text-center mb-4">
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h3 class="@(pattern.ConsecutiveShortLeaves >= 5 ? "text-warning" : "text-success") mb-0">@pattern.ConsecutiveShortLeaves</h3>
                                    <small class="text-muted">Short Leaves</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h3 class="@(pattern.SickLeavesThisYear >= 5 ? "text-danger" : "text-success") mb-0">@pattern.SickLeavesThisYear</h3>
                                    <small class="text-muted">Sick Leaves</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    @{
                                        var riskColor = pattern.RiskLevel >= 60 ? "text-danger" :
                                        pattern.RiskLevel >= 30 ? "text-warning" : "text-success";
                                    }
                                    <h3 class="@riskColor mb-0">@pattern.RiskLevel%</h3>
                                    <small class="text-muted">Risk Score</small>
                                </div>
                            </div>
                        </div>

                        <!-- Pattern Flags -->
                        @if (pattern.PatternFlags.Any())
                        {
                            <div class="alert alert-danger">
                                <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Pattern Alerts</h6>
                                <ul class="mb-0">
                                    @foreach (var flag in pattern.PatternFlags)
                                    {
                                        <li>@flag</li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle"></i> No irregular patterns detected.
                            </div>
                        }

                        <!-- Flag to HR Button -->
                        <div class="border-top pt-3 mt-3">
                            <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#flagModal">
                                <i class="bi bi-flag"></i> Flag & Notify HR
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No pattern data available.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Leave Balance -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Leave Balance (@DateTime.Now.Year)</h5>
                </div>
                <div class="card-body">
                    @if (balances != null && balances.Any())
                    {
                        @foreach (var balance in balances)
                        {
                            var percentage = balance.TotalAllowed > 0
                            ? (int)((double)balance.RemainingDays / balance.TotalAllowed * 100)
                            : 0;
                            var progressColor = percentage > 50 ? "bg-success" : (percentage > 25 ? "bg-warning" : "bg-danger");

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold">@balance.LeaveType</span>
                                    <span>@balance.RemainingDays / @balance.TotalAllowed days</span>
                                </div>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar @progressColor" style="width: @(100 - percentage)%">
                                        @balance.UsedDays used
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center">No leave entitlements found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Leave History -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Leave History</h5>
            <span class="badge bg-light text-dark">@(leaveRequests?.Count ?? 0) requests</span>
        </div>
        <div class="card-body p-0">
            @if (leaveRequests == null || !leaveRequests.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No Leave History</h5>
                    <p class="text-muted">This employee has no leave requests on record.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Leave Type</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in leaveRequests)
                            {
                                var statusBadge = request.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Approved" => "bg-success",
                                    "Rejected" => "bg-danger",
                                    "Cancelled" => "bg-secondary",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td><strong>#@request.RequestId</strong></td>
                                    <td>
                                        <span class="badge bg-info">@(request.Leave?.LeaveType ?? "Unknown")</span>
                                    </td>
                                    <td>@request.Duration day(s)</td>
                                    <td>
                                        <span class="badge @statusBadge">@request.Status</span>
                                    </td>
                                    <td>
                                        @if (request.ApprovalTiming.HasValue)
                                        {
                                            @request.ApprovalTiming.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@request.RequestId" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Flag Modal -->
@if (employee != null)
{
    <div class="modal fade" id="flagModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-flag"></i> Flag Employee & Notify HR
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="FlagEmployee">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="employeeId" value="@employee.EmployeeId" />
                    <div class="modal-body">
                        <div class="alert alert-info">
                            <strong>Employee:</strong> @employee.FullName<br />
                            <strong>Department:</strong> @(employee.Department?.DepartmentName ?? "N/A")
                        </div>

                        @if (pattern != null && pattern.PatternFlags.Any())
                        {
                            <div class="alert alert-warning">
                                <strong>Detected Issues:</strong>
                                <ul class="mb-0 mt-1">
                                    @foreach (var flag in pattern.PatternFlags)
                                    {
                                        <li>@flag</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Reason for Flagging <span class="text-danger">*</span></label>
                            <textarea name="FlagReason" class="form-control" rows="3"
                                  placeholder="Describe the concern or reason for flagging this employee..." required></textarea>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SendToHR" value="true" id="sendToHR" checked>
                            <label class="form-check-label" for="sendToHR">
                                <strong>Send notification to HR Administrators</strong>
                            </label>
                            <div class="form-text">HR will receive a notification about this flag.</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-flag"></i> Submit Flag
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}