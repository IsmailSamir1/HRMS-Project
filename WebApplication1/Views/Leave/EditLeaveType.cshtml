@model WebApplication1.Models.Leave
@{
    ViewData["Title"] = "Edit Leave Type";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="bi bi-pencil text-primary"></i> Edit Leave Type</h2>
                    <p class="text-muted mb-0">Update leave type configuration</p>
                </div>
                <div>
                    <a asp-action="LeaveTypes" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Leave Types
                    </a>
                </div>
            </div>

            <!-- Form Card -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-tag"></i> Edit: @Model.LeaveType</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="EditLeaveType" asp-route-id="@Model.LeaveId">
                        @Html.AntiForgeryToken()

                        <!-- Leave Type ID (Read Only) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-hash"></i> Leave Type ID
                            </label>
                            <input type="text" class="form-control" value="#@Model.LeaveId" readonly disabled />
                        </div>

                        <!-- Leave Type Name -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-type"></i> Leave Type Name <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="LeaveTypeName" class="form-control form-control-lg"
                                   value="@Model.LeaveType" required />
                            <div class="form-text">Enter a unique name for this leave type.</div>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-text-paragraph"></i> Description
                            </label>
                            <textarea name="LeaveDescription" class="form-control" rows="3">@Model.LeaveDescription</textarea>
                            <div class="form-text">Optional description to help employees understand this leave type.</div>
                        </div>

                        <!-- Statistics -->
                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h6 class="card-title"><i class="bi bi-bar-chart"></i> Usage Statistics</h6>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <h4 class="text-primary mb-0">@(Model.LeaveEntitlements?.Count ?? 0)</h4>
                                        <small class="text-muted">Entitlements</small>
                                    </div>
                                    <div class="col-4">
                                        <h4 class="text-info mb-0">@(Model.LeaveRequests?.Count ?? 0)</h4>
                                        <small class="text-muted">Total Requests</small>
                                    </div>
                                    <div class="col-4">
                                        <h4 class="text-success mb-0">@(Model.LeaveRequests?.Count(r => r.Status == "Approved") ?? 0)</h4>
                                        <small class="text-muted">Approved</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="LeaveTypes" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Update Leave Type
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>