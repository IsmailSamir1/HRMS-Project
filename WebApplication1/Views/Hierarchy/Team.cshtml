@model List<WebApplication1.Models.Employee>
@{
    ViewData["Title"] = "Manager's Team";
    var manager = ViewBag.Manager as WebApplication1.Models.Employee;
    int teamSize = ViewBag.TeamSize ?? 0;
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="bi bi-people-fill"></i>
                @if (manager != null)
                {
                    @manager.FullName
                }
                's Team
            </h2>
            <p class="text-muted mb-0">View all team members reporting to this manager</p>
        </div>
        <div>
            <a asp-action="Managers" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Managers
            </a>
        </div>
    </div>

    <!-- Manager Info Card -->
    @if (manager != null)
    {
        <div class="card shadow mb-4 border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-person-badge"></i> Manager Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <p class="mb-2">
                            <strong>Name:</strong><br />
                            <span class="badge bg-success fs-6">@manager.FullName</span>
                        </p>
                    </div>
                    <div class="col-md-3">
                        <p class="mb-2">
                            <strong>Position:</strong><br />
                            @if (manager.Position != null)
                            {
                                <span class="badge bg-info">@manager.Position.PositionTitle</span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-3">
                        <p class="mb-2">
                            <strong>Department:</strong><br />
                            @if (manager.Department != null)
                            {
                                <span class="badge bg-primary">@manager.Department.DepartmentName</span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-3">
                        <p class="mb-2">
                            <strong>Team Size:</strong><br />
                            <span class="badge bg-warning text-dark fs-6">@teamSize members</span>
                        </p>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-6">
                        <p class="mb-0">
                            <strong>Email:</strong>
                            <a href="mailto:@manager.Email">
                                <i class="bi bi-envelope me-1"></i>@manager.Email
                            </a>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-0">
                            <strong>Phone:</strong>
                            <i class="bi bi-telephone me-1"></i>@manager.Phone
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Team Members -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-people"></i> Team Members</h5>
            <span class="badge bg-light text-dark fs-6">@teamSize members</span>
        </div>
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No team members found</h5>
                    <p class="text-muted">This manager currently has no employees reporting to them.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Employee Name</th>
                                <th>Position</th>
                                <th>Department</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                @if (isSystemAdmin)
                                {
                                    <th>Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model)
                            {
                                <tr>
                                    <td>@emp.EmployeeId</td>
                                    <td>
                                        <i class="bi bi-person me-1"></i>
                                        @emp.FullName
                                    </td>
                                    <td>
                                        @if (emp.Position != null)
                                        {
                                            <span class="badge bg-info">@emp.Position.PositionTitle</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (emp.Department != null)
                                        {
                                            <i class="bi bi-building me-1"></i>
                                            @emp.Department.DepartmentName
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="mailto:@emp.Email">
                                            <i class="bi bi-envelope me-1"></i>@emp.Email
                                        </a>
                                    </td>
                                    <td>
                                        <i class="bi bi-telephone me-1"></i>@emp.Phone
                                    </td>
                                    <td>
                                        @if (emp.IsActive == true)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    @if (isSystemAdmin)
                                    {
                                        <td>
                                            <a asp-action="Reassign" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-warning" title="Reassign to Another Manager">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Team Statistics -->
    @if (Model != null && Model.Count > 0)
    {
        var activeMembersCount = Model.Count(e => e.IsActive == true);
        var inactiveMembersCount = Model.Count(e => e.IsActive == false);
        var departmentsCount = Model.Where(e => e.DepartmentId != null).Select(e => e.DepartmentId).Distinct().Count();

        <div class="row mt-4">
            <div class="col-md-3 mb-3">
                <div class="card bg-primary text-white shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-people display-4"></i>
                        <h2 class="mt-2 mb-0">@Model.Count</h2>
                        <p class="mb-0">Total Members</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card bg-success text-white shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-check-circle display-4"></i>
                        <h2 class="mt-2 mb-0">@activeMembersCount</h2>
                        <p class="mb-0">Active</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card bg-secondary text-white shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-x-circle display-4"></i>
                        <h2 class="mt-2 mb-0">@inactiveMembersCount</h2>
                        <p class="mb-0">Inactive</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card bg-info text-white shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-building display-4"></i>
                        <h2 class="mt-2 mb-0">@departmentsCount</h2>
                        <p class="mb-0">Departments</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Composition by Position -->
        <div class="card shadow mt-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Team Composition by Position</h5>
            </div>
            <div class="card-body">
                @{
                    var positionGroups = Model
                    .Where(e => e.Position != null)
                    .GroupBy(e => e.Position.PositionTitle)
                    .Select(g => new { Position = g.Key, Count = g.Count() })
                    .OrderByDescending(g => g.Count);
                }

                @if (positionGroups.Any())
                {
                    <div class="row">
                        @foreach (var group in positionGroups)
                        {
                            double percentage = Model.Count > 0
                            ? Math.Round((double)group.Count / Model.Count * 100, 1)
                            : 0;

                            <div class="col-md-6 mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span><i class="bi bi-briefcase me-1"></i>@group.Position</span>
                                    <span class="badge bg-info">@group.Count member(s)</span>
                                </div>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar bg-info" role="progressbar" style="width: @percentage%">
                                        @percentage%
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No position data available for team members.</p>
                }
            </div>
        </div>
    }

    <!-- Back Button -->
    <div class="mt-3">
        <a asp-action="Managers" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to All Managers
        </a>
    </div>
</div>