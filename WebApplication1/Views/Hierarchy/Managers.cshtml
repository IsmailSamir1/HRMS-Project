@model List<WebApplication1.Models.Employee>
@{
    ViewData["Title"] = "Managers";
    var managerTeamSizes = ViewBag.ManagerTeamSizes as IEnumerable<dynamic>;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-people-fill"></i> All Managers</h2>
            <p class="text-muted mb-0">Browse managers and their teams</p>
        </div>
        <div>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-person-badge display-4"></i>
                    <h2 class="mt-2 mb-0">@Model.Count</h2>
                    <p class="mb-0">Total Managers</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-people display-4"></i>
                    <h2 class="mt-2 mb-0">
                        @if (managerTeamSizes != null)
                        {
                            @managerTeamSizes.Sum(m => (int)m.TeamSize)
                        }
                        else
                        {
                            @:0
                        }
                    </h2>
                    <p class="mb-0">Total Team Members</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-calculator display-4"></i>
                    <h2 class="mt-2 mb-0">
                        @if (Model.Count > 0 && managerTeamSizes != null)
                        {
                            @Math.Round((double)managerTeamSizes.Sum(m => (int)m.TeamSize) / Model.Count, 1)
                        }
                        else
                        {
                            @:0
                        }
                    </h2>
                    <p class="mb-0">Avg Team Size</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Managers Grid -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="card shadow">
            <div class="card-body text-center py-5">
                <i class="bi bi-person-x display-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No Managers Found</h5>
                <p class="text-muted">No employees currently have team members reporting to them.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var managerData in managerTeamSizes)
            {
                var manager = managerData.Manager as WebApplication1.Models.Employee;
                int teamSize = (int)managerData.TeamSize;

                string borderColor = teamSize >= 5 ? "border-success" :
                teamSize >= 3 ? "border-info" : "border-secondary";

                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm @borderColor">
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <i class="bi bi-person-badge display-3 text-success"></i>
                            </div>
                            <h5 class="card-title text-center">@manager.FullName</h5>

                            <div class="text-center mb-2">
                                @if (manager.Position != null)
                                {
                                    <span class="badge bg-info">@manager.Position.PositionTitle</span>
                                }
                            </div>

                            <div class="text-center mb-2">
                                @if (manager.Department != null)
                                {
                                    <span class="badge bg-primary">@manager.Department.DepartmentName</span>
                                }
                            </div>

                            <div class="text-center">
                                <span class="badge bg-success fs-5">@teamSize</span>
                                <span class="text-muted">team members</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-center pb-3">
                            <a asp-action="Team" asp-route-managerId="@manager.EmployeeId" class="btn btn-success">
                                <i class="bi bi-people"></i> View Team
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>