@model List<WebApplication1.Models.Department>
@{
    ViewData["Title"] = "Departments";
    var employeesByDepartment = ViewBag.EmployeesByDepartment as IEnumerable<dynamic>;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-building"></i> All Departments</h2>
            <p class="text-muted mb-0">Browse departments and their employees</p>
        </div>
        <div>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-building display-4"></i>
                    <h2 class="mt-2 mb-0">@Model.Count</h2>
                    <p class="mb-0">Total Departments</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-people display-4"></i>
                    <h2 class="mt-2 mb-0">
                        @if (employeesByDepartment != null)
                        {
                            @employeesByDepartment.Sum(d => (int)d.Count)
                        }
                        else
                        {
                            @:0
                        }
                    </h2>
                    <p class="mb-0">Total Employees</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-calculator display-4"></i>
                    <h2 class="mt-2 mb-0">
                        @if (Model.Count > 0 && employeesByDepartment != null)
                        {
                            @Math.Round((double)employeesByDepartment.Sum(d => (int)d.Count) / Model.Count, 1)
                        }
                        else
                        {
                            @:0
                        }
                    </h2>
                    <p class="mb-0">Avg per Department</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Departments Grid -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="card shadow">
            <div class="card-body text-center py-5">
                <i class="bi bi-building display-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No Departments Found</h5>
                <p class="text-muted">No departments are currently configured in the system.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var dept in Model)
            {
                int employeeCount = 0;
                if (employeesByDepartment != null)
                {
                    var deptData = employeesByDepartment.FirstOrDefault(d => (int)d.DepartmentId == dept.DepartmentId);
                    if (deptData != null)
                    {
                        employeeCount = (int)deptData.Count;
                    }
                }

                string borderColor = employeeCount >= 3 ? "border-success" :
                employeeCount >= 1 ? "border-info" : "border-secondary";

                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm @borderColor">
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <i class="bi bi-building display-3 text-primary"></i>
                            </div>
                            <h5 class="card-title text-center">@dept.DepartmentName</h5>
                            <p class="card-text text-muted text-center">@dept.Purpose</p>
                            <div class="text-center">
                                <span class="badge bg-primary fs-5">@employeeCount</span>
                                <span class="text-muted">employees</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-center pb-3">
                            <a asp-action="Department" asp-route-id="@dept.DepartmentId" class="btn btn-primary">
                                <i class="bi bi-eye"></i> View Department
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>