@model List<WebApplication1.Models.Employee>
@{
    ViewData["Title"] = "Department Details";
    var department = ViewBag.Department as WebApplication1.Models.Department;
    int employeeCount = ViewBag.EmployeeCount ?? 0;
    bool isSystemAdmin = ViewBag.IsSystemAdmin == true;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="bi bi-building"></i>
                @if (department != null)
                {
                    @department.DepartmentName
                }
                else
                {
                    @:Department Details
                }
            </h2>
            <p class="text-muted mb-0">View all employees in this department</p>
        </div>
        <div>
            <a asp-action="Departments" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Departments
            </a>
        </div>
    </div>

    <!-- Department Info Card -->
    @if (department != null)
    {
        <div class="card shadow mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Department Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <p class="mb-2">
                            <strong>Department Name:</strong><br />
                            <span class="badge bg-primary fs-6">@department.DepartmentName</span>
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-2">
                            <strong>Purpose:</strong><br />
                            <span class="text-muted">@department.Purpose</span>
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-2">
                            <strong>Total Employees:</strong><br />
                            <span class="badge bg-success fs-6">@employeeCount</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Employees in Department -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-people"></i> Department Employees</h5>
            <span class="badge bg-light text-dark fs-6">@employeeCount employees</span>
        </div>
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No employees in this department</h5>
                    <p class="text-muted">This department currently has no assigned employees.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Employee Name</th>
                                <th>Position</th>
                                <th>Manager</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                @if (isSystemAdmin)
                                {
                                    <th>Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model)
                            {
                                <tr>
                                    <td>@emp.EmployeeId</td>
                                    <td>
                                        <i class="bi bi-person me-1"></i>
                                        @emp.FullName
                                    </td>
                                    <td>
                                        @if (emp.Position != null)
                                        {
                                            <span class="badge bg-info">@emp.Position.PositionTitle</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (emp.Manager != null)
                                        {
                                            <i class="bi bi-person-badge me-1"></i>
                                            @emp.Manager.FullName
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Manager</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="mailto:@emp.Email">
                                            <i class="bi bi-envelope me-1"></i>@emp.Email
                                        </a>
                                    </td>
                                    <td>
                                        <i class="bi bi-telephone me-1"></i>@emp.Phone
                                    </td>
                                    <td>
                                        @if (emp.IsActive == true)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    @if (isSystemAdmin)
                                    {
                                        <td>
                                            <a asp-action="Reassign" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-warning" title="Reassign">
                                                <i class="bi bi-arrow-left-right"></i>
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Quick Stats -->
    @if (Model != null && Model.Count > 0)
    {
        var managersInDept = Model.Count(e => Model.Any(emp => emp.ManagerId == e.EmployeeId));
        var withoutManager = Model.Count(e => e.ManagerId == null);

        <div class="row mt-4">
            <div class="col-md-4 mb-3">
                <div class="card bg-primary text-white shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-people display-4"></i>
                        <h2 class="mt-2 mb-0">@Model.Count</h2>
                        <p class="mb-0">Total Employees</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card bg-success text-white shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-person-badge display-4"></i>
                        <h2 class="mt-2 mb-0">@managersInDept</h2>
                        <p class="mb-0">Managers</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card bg-warning text-dark shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-person-x display-4"></i>
                        <h2 class="mt-2 mb-0">@withoutManager</h2>
                        <p class="mb-0">Without Manager</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Back Button -->
    <div class="mt-3">
        <a asp-action="Departments" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to All Departments
        </a>
    </div>
</div>