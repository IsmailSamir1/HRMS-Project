@model List<WebApplication1.Models.EmployeeNotification>
@{
    ViewData["Title"] = "My Notifications";
    bool isLineManager = Context.Session.GetString("IsLineManager") == "True";
    bool isSystemAdmin = Context.Session.GetString("IsSystemAdmin") == "True";
    bool isHRAdmin = Context.Session.GetString("IsHRAdmin") == "True";
    bool canSendNotifications = isLineManager || isSystemAdmin || isHRAdmin;

    // Get real-time notifications from ViewBag
    var realTimeNotifications = ViewBag.RealTimeNotifications as List<WebApplication1.Controllers.RealTimeNotification>;
    int realTimeCount = realTimeNotifications?.Count ?? 0;

    int dbUnreadCount = Model.Count(n => n.Notification != null && n.Notification.ReadStatus == false);
    int dbTotalCount = Model.Count;
    int totalCount = dbTotalCount + realTimeCount;
    int unreadCount = dbUnreadCount + realTimeCount;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-bell"></i> My Notifications</h2>
            <p class="text-muted mb-0">
                <span class="badge bg-primary">@totalCount Total</span>
                @if (unreadCount > 0)
                {
                    <span class="badge bg-danger">@unreadCount Unread</span>
                }
                @if (realTimeCount > 0)
                {
                    <span class="badge bg-info">@realTimeCount System Alerts</span>
                }
            </p>
        </div>
        <div>
            @if (canSendNotifications)
            {
                <a asp-action="Send" class="btn btn-success me-2">
                    <i class="bi bi-send"></i> Send to Team
                </a>
            }
            @if (dbUnreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-check-all"></i> Mark All as Read
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Real-Time System Notifications (Requirement a) -->
    @if (realTimeNotifications != null && realTimeNotifications.Count > 0)
    {
        <div class="card shadow mb-4 border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">
                    <i class="bi bi-broadcast"></i> System Alerts
                    <span class="badge bg-light text-dark ms-2">@realTimeCount</span>
                </h5>
                <small>Contract expirations, leave updates, shift assignments, and mission updates</small>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var notification in realTimeNotifications)
                    {
                        string urgencyBadge = "bg-info";
                        string borderClass = "";

                        if (notification.Urgency == "High")
                        {
                            urgencyBadge = "bg-danger";
                            borderClass = "border-start border-danger border-4";
                        }
                        else if (notification.Urgency == "Normal")
                        {
                            urgencyBadge = "bg-info";
                        }
                        else
                        {
                            urgencyBadge = "bg-secondary";
                        }

                        string typeBadge = "bg-secondary";
                        string typeIcon = "bi-bell";

                        if (notification.NotificationType == "Contract")
                        {
                            typeBadge = "bg-warning text-dark";
                            typeIcon = "bi-file-earmark-text";
                        }
                        else if (notification.NotificationType == "Leave")
                        {
                            typeBadge = "bg-success";
                            typeIcon = "bi-calendar-check";
                        }
                        else if (notification.NotificationType == "Shift")
                        {
                            typeBadge = "bg-primary";
                            typeIcon = "bi-clock";
                        }
                        else if (notification.NotificationType == "Mission")
                        {
                            typeBadge = "bg-purple";
                            typeIcon = "bi-briefcase";
                        }

                        <div class="list-group-item bg-light @borderClass">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="d-flex align-items-start">
                                    <div class="me-3">
                                        <i class="bi @typeIcon fs-4 text-primary"></i>
                                    </div>
                                    <div>
                                        <div class="mb-1">
                                            <span class="badge @typeBadge me-1">@notification.NotificationType</span>
                                            <span class="badge @urgencyBadge">@notification.Urgency</span>
                                            <span class="badge bg-info ms-1">LIVE</span>
                                        </div>
                                        <p class="mb-1 fw-normal">@notification.MessageContent</p>
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            @if (notification.Timestamp.HasValue)
                                            {
                                                @notification.Timestamp.Value.ToString("MMM dd, yyyy hh:mm tt")
                                            }
                                            else
                                            {
                                                @DateTime.Now.ToString("MMM dd, yyyy hh:mm tt")
                                            }
                                        </small>
                                    </div>
                                </div>
                                <div>
                                    <i class="bi bi-broadcast text-info" title="Real-time notification"></i>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Stored Notifications from Database -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                <i class="bi bi-inbox"></i> Messages
                <span class="badge bg-light text-dark ms-2">@dbTotalCount</span>
            </h5>
            <small>Team messages and other notifications</small>
        </div>
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No messages yet</h5>
                    <p class="text-muted">You'll see team messages and other notifications here.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model)
                    {
                        if (item.Notification != null)
                        {
                            bool isUnread = item.Notification.ReadStatus == false;
                            string bgClass = isUnread ? "bg-light border-start border-primary border-4" : "";
                            string urgencyBadge = "";

                            if (item.Notification.Urgency == "High")
                            {
                                urgencyBadge = "bg-danger";
                            }
                            else if (item.Notification.Urgency == "Normal")
                            {
                                urgencyBadge = "bg-info";
                            }
                            else
                            {
                                urgencyBadge = "bg-secondary";
                            }

                            string typeBadge = "";
                            string typeIcon = "bi-bell";

                            if (item.Notification.NotificationType == "Leave")
                            {
                                typeBadge = "bg-success";
                                typeIcon = "bi-calendar-check";
                            }
                            else if (item.Notification.NotificationType == "Contract")
                            {
                                typeBadge = "bg-warning text-dark";
                                typeIcon = "bi-file-earmark-text";
                            }
                            else if (item.Notification.NotificationType == "Shift")
                            {
                                typeBadge = "bg-primary";
                                typeIcon = "bi-clock";
                            }
                            else if (item.Notification.NotificationType == "Mission")
                            {
                                typeBadge = "bg-purple";
                                typeIcon = "bi-briefcase";
                            }
                            else if (item.Notification.NotificationType == "TeamMessage")
                            {
                                typeBadge = "bg-info";
                                typeIcon = "bi-chat-dots";
                            }
                            else if (item.Notification.NotificationType == "AccountCreation")
                            {
                                typeBadge = "bg-success";
                                typeIcon = "bi-person-plus";
                            }
                            else if (item.Notification.NotificationType == "Policy")
                            {
                                typeBadge = "bg-secondary";
                                typeIcon = "bi-file-text";
                            }
                            else if (item.Notification.NotificationType == "Reminder")
                            {
                                typeBadge = "bg-warning text-dark";
                                typeIcon = "bi-alarm";
                            }
                            else
                            {
                                typeBadge = "bg-secondary";
                                typeIcon = "bi-bell";
                            }

                            <div class="list-group-item @bgClass">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="d-flex align-items-start">
                                        <div class="me-3">
                                            <i class="bi @typeIcon fs-4 text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="mb-1">
                                                <span class="badge @typeBadge me-1">@item.Notification.NotificationType</span>
                                                <span class="badge @urgencyBadge">@item.Notification.Urgency</span>
                                                @if (isUnread)
                                                {
                                                    <span class="badge bg-danger ms-1">NEW</span>
                                                }
                                            </div>
                                            <p class="mb-1 fw-normal">@item.Notification.MessageContent</p>
                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i>
                                                @if (item.Notification.Timestamp.HasValue)
                                                {
                                                    @item.Notification.Timestamp.Value.ToString("MMM dd, yyyy hh:mm tt")
                                                }
                                            </small>
                                        </div>
                                    </div>
                                    <div>
                                        @if (isUnread)
                                        {
                                            <form asp-action="MarkAsRead" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="notificationId" value="@item.Notification.NotificationId" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Mark as Read">
                                                    <i class="bi bi-check"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-circle text-success" title="Read"></i>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<style>
    .bg-purple {
        background-color: #6f42c1 !important;
        color: white;
    }

    .list-group-item:hover {
        background-color: #f8f9fa;
    }
</style>