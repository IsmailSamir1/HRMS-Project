@model List<WebApplication1.Models.Notification>
@{
    ViewData["Title"] = "Login Activity";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Login Activity</h2>
            <p class="text-muted mb-0">Monitor login attempts and security events</p>
        </div>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        @{
            var successCount = Model?.Count(n => n.MessageContent.Contains("Success")) ?? 0;
            var failedCount = Model?.Count(n => n.MessageContent.Contains("Failed")) ?? 0;
            var lockedCount = Model?.Count(n => n.MessageContent.Contains("Locked")) ?? 0;
        }
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 bg-success bg-opacity-10">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle text-success fs-1"></i>
                    <h3 class="mb-0 mt-2">@successCount</h3>
                    <small class="text-muted">Successful Logins</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 bg-warning bg-opacity-10">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
                    <h3 class="mb-0 mt-2">@failedCount</h3>
                    <small class="text-muted">Failed Attempts</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 bg-danger bg-opacity-10">
                <div class="card-body text-center">
                    <i class="bi bi-shield-x text-danger fs-1"></i>
                    <h3 class="mb-0 mt-2">@lockedCount</h3>
                    <small class="text-muted">Account Lockouts</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Activity Log -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Recent Activity (Last 100)</h5>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in Model)
                            {
                                var isSuccess = activity.MessageContent.Contains("Success");
                                var isFailed = activity.MessageContent.Contains("Failed");
                                var isLocked = activity.MessageContent.Contains("Locked");

                                <tr>
                                    <td>
                                        <small>
                                            <i class="bi bi-clock text-muted me-1"></i>
                                            @activity.Timestamp?.ToString("MMM dd, yyyy HH:mm:ss")
                                        </small>
                                    </td>
                                    <td>
                                        @if (isSuccess)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>Success
                                            </span>
                                        }
                                        else if (isLocked)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-lock me-1"></i>Locked
                                            </span>
                                        }
                                        else if (isFailed)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-x-circle me-1"></i>Failed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unknown</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@activity.MessageContent</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-clock-history text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No Activity Found</h5>
                    <p class="text-muted">Login activity will appear here.</p>
                </div>
            }
        </div>
    </div>
</div>