@{
    ViewData["Title"] = "Create Account";
    bool isSystemAdmin = Context.Session.GetString("IsSystemAdmin") == "True";
    bool isLoggedIn = Context.Session.GetInt32("EmployeeId") != null;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus"></i>
                        @if (isSystemAdmin)
                        {
                            <span>Create Employee Account</span>
                        }
                        else
                        {
                            <span>Register Admin Account</span>
                        }
                    </h4>
                    <small>
                        @if (isSystemAdmin)
                        {
                            <span>System Admin - Create any employee</span>
                        }
                        else
                        {
                            <span>For System Admins, HR Admins, and Line Managers</span>
                        }
                    </small>
                </div>
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" asp-action="@(isSystemAdmin ? "CreateEmployee" : "RegisterAdmin")">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">First Name <span class="text-danger">*</span></label>
                                <input type="text" name="FirstName" class="form-control" placeholder="Enter first name" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input type="text" name="LastName" class="form-control" placeholder="Enter last name" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control" placeholder="Enter email address" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password (National ID) <span class="text-danger">*</span></label>
                            <input type="text" name="Password" class="form-control" placeholder="Enter National ID as password" required />
                            <small class="text-muted">This National ID will be used as the login password</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" name="Phone" class="form-control" placeholder="Enter phone number" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <input type="text" name="Address" class="form-control" placeholder="Enter address" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Role <span class="text-danger">*</span></label>
                            <select name="Role" class="form-select" required>
                                <option value="">-- Select Role --</option>
                                @if (isSystemAdmin)
                                {
                                    <!-- System Admin can create any role -->
                                    <option value="System Administrator">System Administrator</option>
                                    <option value="HR Administrator">HR Administrator</option>
                                    <option value="Line Manager">Line Manager</option>
                                    <option value="Employee">Employee</option>
                                }
                                else
                                {
                                    <!-- Self-registration only for admin roles -->
                                    <option value="System Administrator">System Administrator</option>
                                    <option value="HR Administrator">HR Administrator</option>
                                    <option value="Line Manager">Line Manager</option>
                                }
                            </select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-person-plus"></i> Create Account
                            </button>
                        </div>
                    </form>

                    @if (!isLoggedIn)
                    {
                        <hr />
                        <div class="text-center">
                            <p class="mb-0">Already have an account?</p>
                            <a asp-action="Login" class="btn btn-outline-primary mt-2">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>