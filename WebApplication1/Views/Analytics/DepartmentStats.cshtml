@model List<WebApplication1.Controllers.DepartmentStatistic>
@{
    ViewData["Title"] = "Department Statistics";
    int totalEmployees = ViewBag.TotalEmployees ?? 0;
    int totalDepartments = ViewBag.TotalDepartments ?? 0;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-pie-chart"></i> Department Statistics</h2>
            <p class="text-muted mb-0">Employee distribution across departments</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Analytics
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-people display-4"></i>
                    <h2 class="mt-2 mb-0">@totalEmployees</h2>
                    <p class="mb-0">Total Employees</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-building display-4"></i>
                    <h2 class="mt-2 mb-0">@totalDepartments</h2>
                    <p class="mb-0">Total Departments</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <i class="bi bi-calculator display-4"></i>
                    <h2 class="mt-2 mb-0">
                        @if (totalDepartments > 0)
                        {
                            @(Math.Round((double)totalEmployees / totalDepartments, 1))
                        }
                        else
                        {
                            @:0
                        }
                    </h2>
                    <p class="mb-0">Avg. per Department</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Box -->
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle"></i>
        <strong>Stored Procedure Used:</strong> <code>GetDepartmentEmployeeStats</code> -
        Returns department names with their employee counts.
    </div>

    <div class="row">
        <!-- Table View -->
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-table"></i> Department Breakdown</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model == null || Model.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">No department data found</h5>
                        </div>
                    }
                    else
                    {
                        <table class="table table-striped table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Department</th>
                                    <th>Employees</th>
                                    <th>Percentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rank = 1;
                                }
                                @foreach (var dept in Model.OrderByDescending(d => d.NumberOfEmployees))
                                {
                                    double percentage = totalEmployees > 0
                                    ? Math.Round((double)dept.NumberOfEmployees / totalEmployees * 100, 1)
                                    : 0;

                                    <tr>
                                        <td><span class="badge bg-secondary">@rank</span></td>
                                        <td>
                                            <i class="bi bi-building me-1"></i>
                                            @dept.DepartmentName
                                        </td>
                                        <td>
                                            <span class="badge bg-primary fs-6">@dept.NumberOfEmployees</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress flex-grow-1 me-2" style="height: 20px;">
                                                    <div class="progress-bar bg-success" role="progressbar"
                                                         style="width: @percentage%">
                                                        @percentage%
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                            <tfoot class="table-dark">
                                <tr>
                                    <td colspan="2"><strong>Total</strong></td>
                                    <td><strong>@totalEmployees</strong></td>
                                    <td><strong>100%</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- Visual Chart -->
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Visual Distribution</h5>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var dept in Model.OrderByDescending(d => d.NumberOfEmployees))
                        {
                            double percentage = totalEmployees > 0
                            ? Math.Round((double)dept.NumberOfEmployees / totalEmployees * 100, 1)
                            : 0;

                            string barColor = percentage >= 40 ? "bg-success" :
                            percentage >= 20 ? "bg-info" :
                            percentage >= 10 ? "bg-warning" : "bg-secondary";

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span><i class="bi bi-building me-1"></i> @dept.DepartmentName</span>
                                    <span class="badge bg-primary">@dept.NumberOfEmployees employees</span>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar @barColor" role="progressbar"
                                         style="width: @percentage%"
                                         aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                        @percentage%
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-bar-chart display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">No data to display</h5>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Department Cards -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row mt-2">
            <div class="col-12">
                <h5 class="mb-3"><i class="bi bi-grid"></i> Department Cards</h5>
            </div>
            @foreach (var dept in Model.OrderByDescending(d => d.NumberOfEmployees))
            {
                double percentage = totalEmployees > 0
                ? Math.Round((double)dept.NumberOfEmployees / totalEmployees * 100, 1)
                : 0;

                string cardBorder = percentage >= 30 ? "border-success" :
                percentage >= 15 ? "border-info" : "border-secondary";
                string badgeColor = percentage >= 30 ? "bg-success" :
                percentage >= 15 ? "bg-info" : "bg-secondary";

                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm @cardBorder">
                        <div class="card-body text-center">
                            <i class="bi bi-building display-4 text-primary"></i>
                            <h5 class="card-title mt-2">@dept.DepartmentName</h5>
                            <p class="card-text">
                                <span class="badge @badgeColor fs-5">@dept.NumberOfEmployees</span>
                                <span class="text-muted">employees</span>
                            </p>
                            <p class="text-muted small mb-0">@percentage% of workforce</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Back Button -->
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Analytics Dashboard
        </a>
        <a asp-action="ComplianceReport" class="btn btn-success">
            <i class="bi bi-search"></i> Generate Compliance Report
        </a>
    </div>
</div>

