@model List<WebApplication1.Controllers.ComplianceReportResult>
@{
    ViewData["Title"] = "Compliance Report";
    var departments = ViewBag.Departments as List<WebApplication1.Models.Department>;
    var positions = ViewBag.Positions as List<WebApplication1.Models.Position>;
    var countries = ViewBag.Countries as List<string>;
    string selectedFilter = ViewBag.FilterField ?? "";
    string selectedValue = ViewBag.FilterValue ?? "";
    string reportType = ViewBag.ReportType ?? "";
    int resultCount = ViewBag.ResultCount ?? 0;
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-clipboard-check"></i> Compliance & Diversity Report</h2>
            <p class="text-muted mb-0">Search and generate employee reports by various filters</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Analytics
            </a>
        </div>
    </div>

    <!-- Info Box -->
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle"></i>
        <strong>Stored Procedure Used:</strong> <code>GenerateProfileReport</code> -
        Filters employees by department_id, position_id, country_of_birth, employment_status, or account_status.
    </div>

    <!-- Search Form -->
    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-search"></i> Generate Report</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" asp-action="ComplianceReport">
                <div class="row">
                    <!-- Report Type -->
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Report Type</label>
                        <select name="ReportType" id="reportType" class="form-select" onchange="updateFilters()">
                            <option value="Compliance" selected>Compliance Report</option>
                            <option value="Diversity">Diversity Report</option>
                        </select>
                    </div>

                    <!-- Filter Field -->
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Filter By <span class="text-danger">*</span></label>
                        <select name="FilterField" id="filterField" class="form-select" onchange="updateFilterValues()" required>
                            <option value="">-- Select Filter --</option>
                            <option value="department_id">Department</option>
                            <option value="position_id">Position</option>
                            <option value="country_of_birth">Country of Birth (Diversity)</option>
                            <option value="employment_status">Employment Status</option>
                            <option value="account_status">Account Status</option>
                        </select>
                    </div>

                    <!-- Filter Value -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Filter Value <span class="text-danger">*</span></label>
                        <select name="FilterValue" id="filterValue" class="form-select" required>
                            <option value="">-- Select Filter First --</option>
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <div class="col-md-2 mb-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-file-earmark-text"></i> Generate
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Section -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="card shadow">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-table"></i> Report Results
                </h5>
                <div>
                    <span class="badge bg-success fs-6">@resultCount employees found</span>
                    <span class="badge bg-info fs-6 ms-2">Filter: @selectedFilter = @selectedValue</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Position</th>
                                <th>Country</th>
                                <th>Employment Status</th>
                                <th>Account Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model)
                            {
                                <tr>
                                    <td>@emp.EmployeeId</td>
                                    <td>
                                        <i class="bi bi-person me-1"></i>
                                        @emp.FullName
                                    </td>
                                    <td>
                                        <a href="mailto:@emp.Email">@emp.Email</a>
                                    </td>
                                    <td>@emp.Phone</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(emp.DepartmentName))
                                        {
                                            <span class="badge bg-primary">@emp.DepartmentName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(emp.PositionTitle))
                                        {
                                            <span class="badge bg-info">@emp.PositionTitle</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(emp.CountryOfBirth))
                                        {
                                            <i class="bi bi-globe me-1"></i>
                                            @emp.CountryOfBirth
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (emp.EmploymentStatus == "Active")
                                        {
                                            <span class="badge bg-success">@emp.EmploymentStatus</span>
                                        }
                                        else if (emp.EmploymentStatus == "Inactive")
                                        {
                                            <span class="badge bg-secondary">@emp.EmploymentStatus</span>
                                        }
                                        else if (emp.EmploymentStatus == "On Leave")
                                        {
                                            <span class="badge bg-warning text-dark">@emp.EmploymentStatus</span>
                                        }
                                        else if (emp.EmploymentStatus == "Terminated")
                                        {
                                            <span class="badge bg-danger">@emp.EmploymentStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@emp.EmploymentStatus</span>
                                        }
                                    </td>
                                    <td>
                                        @if (emp.AccountStatus == "Active")
                                        {
                                            <span class="badge bg-success">@emp.AccountStatus</span>
                                        }
                                        else if (emp.AccountStatus == "Suspended")
                                        {
                                            <span class="badge bg-warning text-dark">@emp.AccountStatus</span>
                                        }
                                        else if (emp.AccountStatus == "Locked")
                                        {
                                            <span class="badge bg-danger">@emp.AccountStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@emp.AccountStatus</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-0 text-muted">
                            <i class="bi bi-info-circle"></i>
                            Showing @resultCount employee(s) matching filter:
                            <strong>@selectedFilter</strong> = <strong>@selectedValue</strong>
                        </p>
                    </div>
                    <div class="col-md-6 text-end">
                        <button onclick="window.print()" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-printer"></i> Print Report
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(selectedFilter))
    {
        <div class="card shadow">
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No Results Found</h5>
                <p class="text-muted">No employees match the selected filter criteria.</p>
            </div>
        </div>
    }

    <!-- Quick Filter Buttons -->
    <div class="card shadow mt-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Filters</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h6>By Employment Status</h6>
                    <form method="post" asp-action="ComplianceReport" class="d-inline">
                        <input type="hidden" name="FilterField" value="employment_status" />
                        <input type="hidden" name="FilterValue" value="Active" />
                        <input type="hidden" name="ReportType" value="Compliance" />
                        <button type="submit" class="btn btn-outline-success btn-sm me-1 mb-1">
                            <i class="bi bi-check-circle"></i> Active Employees
                        </button>
                    </form>
                    <form method="post" asp-action="ComplianceReport" class="d-inline">
                        <input type="hidden" name="FilterField" value="employment_status" />
                        <input type="hidden" name="FilterValue" value="Inactive" />
                        <input type="hidden" name="ReportType" value="Compliance" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm me-1 mb-1">
                            <i class="bi bi-x-circle"></i> Inactive Employees
                        </button>
                    </form>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>By Account Status</h6>
                    <form method="post" asp-action="ComplianceReport" class="d-inline">
                        <input type="hidden" name="FilterField" value="account_status" />
                        <input type="hidden" name="FilterValue" value="Active" />
                        <input type="hidden" name="ReportType" value="Compliance" />
                        <button type="submit" class="btn btn-outline-success btn-sm me-1 mb-1">
                            <i class="bi bi-person-check"></i> Active Accounts
                        </button>
                    </form>
                    <form method="post" asp-action="ComplianceReport" class="d-inline">
                        <input type="hidden" name="FilterField" value="account_status" />
                        <input type="hidden" name="FilterValue" value="Suspended" />
                        <input type="hidden" name="ReportType" value="Compliance" />
                        <button type="submit" class="btn btn-outline-warning btn-sm me-1 mb-1">
                            <i class="bi bi-pause-circle"></i> Suspended Accounts
                        </button>
                    </form>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>By Country (Diversity)</h6>
                    @if (countries != null)
                    {
                        @foreach (var country in countries.Take(5))
                        {
                            <form method="post" asp-action="ComplianceReport" class="d-inline">
                                <input type="hidden" name="FilterField" value="country_of_birth" />
                                <input type="hidden" name="FilterValue" value="@country" />
                                <input type="hidden" name="ReportType" value="Diversity" />
                                <button type="submit" class="btn btn-outline-info btn-sm me-1 mb-1">
                                    <i class="bi bi-globe"></i> @country
                                </button>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Analytics Dashboard
        </a>
        <a asp-action="DepartmentStats" class="btn btn-primary">
            <i class="bi bi-bar-chart"></i> View Department Stats
        </a>
        <a asp-action="DiversityReport" class="btn btn-info">
            <i class="bi bi-globe"></i> View Diversity Report
        </a>
    </div>
</div>

<!-- JavaScript for Dynamic Filter Values -->
<script>
    // Department data from server
    var departments = [
        @if (departments != null)
        {
                @foreach (var dept in departments)
                {
                        @:{ id: '@dept.DepartmentId', name: '@dept.DepartmentName' },
                }
        }
    ];

    // Position data from server
    var positions = [
        @if (positions != null)
        {
                @foreach (var pos in positions)
                {
                        @:{ id: '@pos.PositionId', name: '@pos.PositionTitle' },
                }
        }
    ];

    // Country data from server
    var countries = [
        @if (countries != null)
        {
                @foreach (var country in countries)
                {
                        @:'@country',
                }
        }
    ];

    function updateFilterValues() {
        var filterField = document.getElementById('filterField').value;
        var filterValue = document.getElementById('filterValue');

        // Clear existing options
        filterValue.innerHTML = '<option value="">-- Select Value --</option>';

        if (filterField === 'department_id') {
            departments.forEach(function(dept) {
                var option = document.createElement('option');
                option.value = dept.id;
                option.textContent = dept.name;
                filterValue.appendChild(option);
            });
        }
        else if (filterField === 'position_id') {
            positions.forEach(function(pos) {
                var option = document.createElement('option');
                option.value = pos.id;
                option.textContent = pos.name;
                filterValue.appendChild(option);
            });
        }
        else if (filterField === 'country_of_birth') {
            countries.forEach(function(country) {
                var option = document.createElement('option');
                option.value = country;
                option.textContent = country;
                filterValue.appendChild(option);
            });
        }
        else if (filterField === 'employment_status') {
            var statuses = ['Active', 'Inactive', 'On Leave', 'Terminated'];
            statuses.forEach(function(status) {
                var option = document.createElement('option');
                option.value = status;
                option.textContent = status;
                filterValue.appendChild(option);
            });
        }
        else if (filterField === 'account_status') {
            var statuses = ['Active', 'Suspended', 'Locked'];
            statuses.forEach(function(status) {
                var option = document.createElement('option');
                option.value = status;
                option.textContent = status;
                filterValue.appendChild(option);
            });
        }
    }

    function updateFilters() {
        var reportType = document.getElementById('reportType').value;
        var filterField = document.getElementById('filterField');

        if (reportType === 'Diversity') {
            filterField.value = 'country_of_birth';
            updateFilterValues();
        }
    }
</script>
```
